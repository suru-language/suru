routine main() -> Unit
    value sum: Whole = 0
    each index from 0 until 4
        set sum to sum + index
    end each
    show(sum)
    each j from 1 through 3
        show(j)
    end each
    each edge from 9223372036854775807 through 9223372036854775807
        show(edge)
    end each
end routine

routine is_digit(ch: Text) -> Bool
    give str_contains("0123456789", ch)
end routine

routine tokenize(src: Text) -> [Text]
    value src_len: Whole = str_len(src)
    change pos: Whole = 0
    change out: [Text] = ["s"]
    set out to slice(out, 0, 0)
    repeat while pos < src_len
        change cur: Text = substr(src, pos, 1)
        when cur == " "
            set pos to pos + 1
        otherwise
            when is_digit(cur)
                change end_pos: Whole = pos
                repeat while end_pos < src_len and is_digit(substr(src, end_pos, 1))
                    set end_pos to end_pos + 1
                end repeat
                set out to array_concat(out, [substr(src, pos, end_pos - pos)])
                set pos to end_pos
            otherwise
                set out to array_concat(out, [cur])
                set pos to pos + 1
            end when
        end when
    end repeat
    give out
end routine

routine eval_postfix(toks: [Text]) -> Whole
    value n: Whole = array_len(toks)
    change stack: [Whole] = [0]
    set stack to slice(stack, 0, 0)
    change i: Whole = 0
    repeat while i < n
        change t: Text = toks[i]
        when is_digit(substr(t, 0, 1))
            set stack to array_concat(stack, [int_from_str(t)])
        otherwise
            value b: Whole = stack[array_len(stack) - 1]
            set stack to slice(stack, 0, array_len(stack) - 1)
            value a: Whole = stack[array_len(stack) - 1]
            set stack to slice(stack, 0, array_len(stack) - 1)
            when t == "+"
                set stack to array_concat(stack, [a + b])
            otherwise
                when t == "-"
                    set stack to array_concat(stack, [a - b])
                otherwise
                    when t == "*"
                        set stack to array_concat(stack, [a * b])
                    otherwise
                        set stack to array_concat(stack, [a / b])
                    end when
                end when
            end when
        end when
        set i to i + 1
    end repeat
    give stack[0]
end routine

routine main() -> Unit
    value toks: [Text] = tokenize("3 4 + 2 *")
    show(to_str(eval_postfix(toks)))
end routine

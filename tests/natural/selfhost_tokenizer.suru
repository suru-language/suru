routine is_letter(ch: Text) -> Bool
    give str_contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", ch)
end routine

routine is_digit(ch: Text) -> Bool
    give str_contains("0123456789", ch)
end routine

routine tokenize(src: Text) -> Text
    value src_len: Whole = str_len(src)
    change pos: Whole = 0
    change out: Text = ""
    repeat while pos < src_len
        change cur: Text = substr(src, pos, 1)
        when cur == " " or cur == "\n"
            set pos to pos + 1
        otherwise
            when is_letter(cur)
                change end_pos: Whole = pos
                repeat while end_pos < src_len and is_letter(substr(src, end_pos, 1))
                    set end_pos to end_pos + 1
                end repeat
                set out to out + substr(src, pos, end_pos - pos) + ","
                set pos to end_pos
            otherwise
                when is_digit(cur)
                    change digit_end: Whole = pos
                    repeat while digit_end < src_len and is_digit(substr(src, digit_end, 1))
                        set digit_end to digit_end + 1
                    end repeat
                    set out to out + substr(src, pos, digit_end - pos) + ","
                    set pos to digit_end
                otherwise
                    set out to out + cur + ","
                    set pos to pos + 1
                end when
            end when
        end when
    end repeat
    give out
end routine

routine main() -> Unit
    show(tokenize("show(value + 2)"))
end routine

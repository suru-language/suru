routine is_letter(c: Text) -> Bool
    give str_contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)
end routine

routine is_digit(c: Text) -> Bool
    give str_contains("0123456789", c)
end routine

routine tokenize(src: Text) -> Text
    value n: Whole = str_len(src)
    change i: Whole = 0
    change out: Text = ""
    repeat while i < n
        change c: Text = substr(src, i, 1)
        when c == " " or c == "\n"
            set i to i + 1
        otherwise
            when is_letter(c)
                change j: Whole = i
                repeat while j < n and is_letter(substr(src, j, 1))
                    set j to j + 1
                end repeat
                set out to out + substr(src, i, j - i) + "\n"
                set i to j
            otherwise
                when is_digit(c)
                    change k: Whole = i
                    repeat while k < n and is_digit(substr(src, k, 1))
                        set k to k + 1
                    end repeat
                    set out to out + substr(src, i, k - i) + "\n"
                    set i to k
                otherwise
                    set out to out + c + "\n"
                    set i to i + 1
                end when
            end when
        end when
    end repeat
    give out
end routine

routine main() -> Unit
    show(tokenize("show(value + 2)"))
end routine

record Point
    change x: Whole
end record

routine main() -> Unit
    value arithmetic: Whole = 2 + 3 * 4
    show(arithmetic)
    value flag: Bool = true
    value chosen: Whole = flag ? 10 : 20
    show(chosen)
    change xs: [Whole] = [4, 5, 6]
    set xs[1] to 8
    show(xs[1])
    value p: Point = none
    set p.x to 7
    show(p.x)
    change total: Whole = 0
    set total to total + 2
    show(total)
    value text: Text = "a" + "bc"
    show(str_len(text))
    show(add(4, 5))
end routine

routine add(a: Whole, b: Whole) -> Whole
    give a + b
end routine

routine main() -> Unit
    value result: Whole = 0
    when true
        set result to 3
        when false
            set result to 99
        otherwise
            set result to result + 1
        end when
    otherwise when false
        set result to 98
    otherwise
        set result to 97
    end when
    repeat while result < 5
        set result to result + 1
    end repeat
    show(result)
    show(add(2, 3))
end routine
routine add(a: Whole, b: Whole) -> Whole
    value total: Whole = a + b
    give total
end routine

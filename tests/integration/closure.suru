func apply(f: fn(int) -> int, x: int) -> int { return f(x); }
func make_adder(n: int) -> fn(int) -> int {
    return fn(x: int) -> int { return x + n; };
}
func counter() -> fn() -> int {
    mut c = 0;
    return fn() -> int { c = c + 1; return c; };
}
func main() {
    println(to_str(apply(fn(v: int) -> int { return v * 2; }, 21)));
    let f = make_adder(10);
    println(to_str(f(5)));
    let g = counter();
    println(to_str(g()));
    println(to_str(g()));
    let fns = [fn(x: int) -> int { return x + 1; },
               fn(y: int) -> int { return y * 2; }];
    println(to_str(fns[0](5)));
    println(to_str(fns[1](5)));
}

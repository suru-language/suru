func main() {
    let a = [0, 1, 2, 3, 4];
    let b = slice(a, 1, 3);
    println(to_str(array_len(b)));
    println(to_str(b[0]));
    println(to_str(b[2]));
    let c = slice(a, 3, 100);
    println(to_str(array_len(c)));
    println(to_str(c[0]));
    let s = ["x", "y", "z"];
    let t = slice(s, 1, 1);
    println(t[0]);
}

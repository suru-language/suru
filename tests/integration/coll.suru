func main() -> int {
    let a = range(1, 6);
    println(array_contains(a, 3));
    println(array_contains(a, 9));
    println(array_index_of(a, 4));
    println(array_index_of(a, 9));
    let s = array_sort([5, 1, 4, 1, 3]);
    println(array_index_of(s, 1));
    println(s[0] + s[1] + s[2] + s[3] + s[4]);
    let c = array_concat(a, s);
    println(len(c));
    println(c[5]);
    return 0;
}

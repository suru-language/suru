func sum_deep(c: [[[int]]]) -> int {
    return c[0][1][2] + c[1][0][1];
}
func main() -> int {
    let leaf = [1, 2, 3];
    let a = [leaf, leaf];
    let b = [leaf, leaf];
    let c = [a, b];
    mut total = 0;
    mut i = 0;
    while i < 500 {
        let junk = range(0, 80);
        let s = "pad" * 30;
        total = total + array_len(junk) + str_len(s);
        if i % 25 == 0 {
            total = total + sum_deep(c);
            let f = fn(x: int) -> int { return x + i; };
            total = total + f(1);
        }
        i = i + 1;
    }
    println(total);
    return 0;
}

func bump(arr: [int]) -> bool {
    arr[0] = arr[0] + 1;
    return true;
}
func main() -> int {
    println(true or false);
    println(false or true);
    println(false or false);
    println(true and true);
    println(true and false);
    println((true or false) ? 7 : 3);
    println((false and true) ? 7 : 3);
    mut counts = [0];
    let a = true or bump(counts);
    let b = false and bump(counts);
    println(a);
    println(b);
    println(counts[0]);
    return 0;
}

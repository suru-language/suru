func main() -> int {
    println(int_to_str_base(255, 16));
    println(int_to_str_base(255, 2));
    println(int_to_str_base(-255, 10));
    println(int_to_str_base(3735928559, 16));
    println("[" + str_pad("hi", 6, ".") + "]");
    println("[" + str_pad("hi", 6, " ") + "]");
    println("[" + str_pad("toolong", 3, ".") + "]");
    println("[" + str_pad("", 4, "0") + "]");
    return 0;
}

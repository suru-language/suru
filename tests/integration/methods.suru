type Point { let x: int; let y: int; }
func norm(p: Point) -> int {
    return p.x + p.y;
}
func scale(p: Point, k: int) -> Point {
    return Point(p.x * k, p.y * k);
}
func add(p: Point, q: Point) -> Point {
    return Point(p.x + q.x, p.y + q.y);
}
func main() -> int {
    let p = Point(3, 4);
    println(p.norm());
    let q = p.scale(2);
    println(q.x);
    println(q.y);
    println(p.x);
    println(p.scale(2).norm());
    println(p.add(Point(1, 1)).norm());
    let arr = [Point(1, 2), Point(10, 20)];
    println(arr[1].norm());
    println(arr[0].scale(3).norm());
    return 0;
}

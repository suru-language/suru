choice NetworkState
    Connected(address: Text)
    Disconnected(reason: Text)
end choice

routine main() -> Unit
    value current: NetworkState = Connected("node")
    choose current
        case Connected(address)
            show(address)
        case Disconnected(reason)
            show("wrong")
    end choose

    value other: NetworkState = Disconnected("offline")
    choose other
        case Connected(name)
            show("wrong")
        case Disconnected(reason)
            show(reason)
    end choose
end routine

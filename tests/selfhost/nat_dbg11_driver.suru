use "../../selfhost/compiler/natural_bytecode.suru";
use "../../selfhost/compiler/source.suru";
func main() {
    let src: str = source_load(args(0));
    let lines: [str] = str_split(src, "\n");
    mut empty: [str] = [];
    mut instructions: [str] = nbc_collect_functions(empty, lines);
    instructions = nbc_collect_records(instructions, lines);
    instructions = nbc_collect_choices(instructions, lines);
    println("collected=" + to_str(array_len(instructions)));
    mut i: int = 0;
    while i < array_len(instructions) {
        println("  " + to_str(i) + " " + instructions[i]);
        i += 1;
    }
}

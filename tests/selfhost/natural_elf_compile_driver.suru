use "../../selfhost/compiler/source.suru";
use "../../selfhost/compiler/natural_bytecode.suru";
use "../../selfhost/compiler/natural_module_writer.suru";
use "../../selfhost/compiler/natural_elf_writer.suru";

// Minimal native backend path: compiles a trivial Natural program whose body is
// `show(x)` (string literal, integer constant, or integer expression over
// const/neg/add/sub/mul/div) into a standalone x86-64 ELF64 executable.
func main() {
    let source: str = source_load(args(0));
    let instructions: [str] = nbc_collect(source);
    if array_len(instructions) == 1 and instructions[0] == "#emit-failed" {
        exit(1);
    }
    let fns: [[str]] = nw_collect_functions(instructions);
    if array_len(fns) != 1 { exit(2); }
    let ins: [str] = nw_emit_ins(fns[0]);
    let n: int = array_len(ins);
    if n < 4 { exit(3); }

    let tail: [str] = str_split(ins[n - 3], "|");
    if nw_norm(tail[0]) != "builtin" or tail[1] != "1" { exit(5); }

    let first: [str] = str_split(ins[0], "|");
    if nw_norm(first[0]) == "const_str" {
        if n != 4 { exit(4); }
        let sidx: int = int_from_str(first[1]);
        mut found: int = -1;
        mut val: str = "";
        mut i: int = 0;
        while i < array_len(instructions) {
            if nbc_has_prefix(instructions[i], "#str|") {
                found += 1;
                if found == sidx {
                    let raw: str = substr(instructions[i], 5, str_len(instructions[i]));
                    if str_len(raw) >= 2 and raw[0] == "\"" and
                       raw[str_len(raw) - 1] == "\"" {
                        val = substr(raw, 1, str_len(raw) - 2);
                    } else {
                        val = raw;
                    }
                }
            }
            i += 1;
        }
        if val == "" { exit(6); }
        write_file(args(1), nw_emit_elf_message(val + "\n"));
        exit(0);
    }

    // Integer expression: prefix (const/arith/neg) + println + pop + ret_unit.
    mut ops: [int] = [];
    mut avs: [int] = [];
    mut idx: int = 0;
    while idx < n - 3 {
        let f: [str] = str_split(ins[idx], "|");
        let opname: str = nw_norm(f[0]);
        mut id: int = 0;
        if opname == "const_int" { id = 1; }
        else if opname == "ld_local" { id = 5; }
        else if opname == "st_local" { id = 6; }
        else if opname == "neg_i" { id = 11; }
        else if opname == "add_i" { id = 14; }
        else if opname == "sub_i" { id = 15; }
        else if opname == "mul_i" { id = 16; }
        else if opname == "div_i" { id = 17; }
        else { exit(4); }
        ops = array_concat(ops, [id]);
        if id == 1 {
            let sidx: int = int_from_str(f[1]);
            mut found: int = -1;
            mut ival: int = 0;
            mut pi: int = 0;
            while pi < array_len(instructions) {
                if nbc_has_prefix(instructions[pi], "#int|") {
                    found += 1;
                    if found == sidx {
                        ival = nw_int_toll(substr(instructions[pi], 5, str_len(instructions[pi])));
                    }
                }
                pi += 1;
            }
            avs = array_concat(avs, [ival]);
        } else if id == 5 or id == 6 {
            avs = array_concat(avs, [int_from_str(f[1])]);
        } else {
            avs = array_concat(avs, [0]);
        }
        idx += 1;
    }
    let elf: str = nw_emit_elf_int_expr(ops, avs);
    if elf == "" { exit(7); }
    write_file(args(1), elf);
    exit(0);
}

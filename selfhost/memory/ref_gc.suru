// SURU GC Reference Model (Phase 3C).
//
// A tri-color mark-and-sweep collector over a *modeled* object graph, written
// entirely in SURU using only supported facilities (arrays of ints, nested
// arrays, slice, array_concat). This is deliberately a reference model — it
// runs on the C17 bootstrap's values, not on a production heap. It validates
// the collector's graph-traversal and reachability rules and serves as a spec
// oracle for the future SURU-owned runtime memory manager.
//
// Objects are small integers. The "heap" is a set of parallel arrays:
//   kinds[i]  object kind
//   refs[i]   array of child object indices (graph edges)
//   n         number of objects
// Colours (white/grey/black) are maintained per mark. Marking is
// non-recursive and uses a bounded worklist; if the worklist exceeds its cap,
// simulate() reports an overflow instead of silently abandoning marking.

const WHITE = 0;
const GREY = 1;
const BLACK = 2;

func all_white(n: int) -> [int] {
    mut c: [int] = empty_ints();
    mut i: int = 0;
    while i < n { c = array_concat(c, [WHITE]); i += 1; }
    return c;
}

// Is the graph of `n` objects (kinds/refs) with the given roots fully marked
// within workcap grey-slot budget? Returns [overflow, survivors].
func empty_ints() -> [int] {
    return slice([0], 0, 0);
}

func empty_intss() -> [[int]] {
    return slice([empty_ints()], 0, 0);
}

func simulate(roots: [int], kinds: [int], refs: [[int]], n: int, workcap: int) -> [int] {
    mut cols: [int] = all_white(n);
    mut wl: [int] = empty_ints();
    mut ri: int = 0;
    while ri < array_len(roots) {
        let r: int = roots[ri];
        if r >= 0 and r < n and cols[r] == WHITE {
            cols[r] = GREY;
            wl = array_concat(wl, [r]);
            if array_len(wl) > workcap { return [1, 0]; }
        }
        ri += 1;
    }
    while array_len(wl) > 0 {
        let last: int = array_len(wl) - 1;
        let u: int = wl[last];
        wl = slice(wl, 0, last);
        let ch: [int] = refs[u];
        mut k: int = 0;
        while k < array_len(ch) {
            let c: int = ch[k];
            if c >= 0 and c < n and cols[c] == WHITE {
                cols[c] = GREY;
                wl = array_concat(wl, [c]);
                if array_len(wl) > workcap { return [1, 0]; }
            }
            k += 1;
        }
        cols[u] = BLACK;
    }
    mut survivors: int = 0;
    mut i: int = 0;
    while i < n {
        if cols[i] != WHITE { survivors += 1; }
        i += 1;
    }
    return [0, survivors];
}

// Append an object with the given child edges. Returns [ok, new_n, id].
func add_obj(kinds: [int], refs: [[int]], n: int, cap: int, kind: int, ch: [int]) -> [int] {
    if n >= cap { return [0, n, -1]; }
    let k2: [int] = array_concat(kinds, [kind]);
    let r2: [[int]] = array_concat(refs, [ch]);
    return [1, n + 1, n];
}

func expect(name: str, got: int, want: int) -> int {
    if got == want {
        println("ok: " + name);
        return 0;
    }
    println("FAIL: " + name + " got=" + to_str(got) + " want=" + to_str(want));
    return 1;
}

// Generation-aware identity model (Phase 3F.1). A handle encodes a
// (slot, generation) pair as h = slot + gen*100000. Object identity is a
// lifetime, not merely a storage location. This models handle validity and
// slot reuse; it does not claim full equivalence with the C collector (which
// additionally enforces a stop-the-world lifecycle and a collection lock).
func handle(slot: int, gen: int) -> int {
    return slot + gen * 100000;
}

func h_slot(h: int) -> int {
    return h % 100000;
}

func h_gen(h: int) -> int {
    return h / 100000;
}

func valid_handle(gens: [int], n: int, h: int) -> int {
    if h <= 0 { return 0; }
    let s: int = h_slot(h);
    if s < 0 { return 0; }
    if s >= n { return 0; }
    if gens[s] == h_gen(h) { return 1; }
    return 0;
}

func main() {
    mut fails: int = 0;
    let N: int = 32; // heap capacity for model

    // ---- 1. Single reachable chain: root -> A -> B ----
    {
        let kinds: [int] = [1, 1, 1];
        let refs: [[int]] = [[1], [2], empty_ints()];
        let r: [int] = simulate([0], kinds, refs, 3, 8);
        fails += expect("chain-reachable", r[1], 3);
    }

    // ---- 2. Unreachable garbage: B is orphaned ----
    {
        let kinds: [int] = [1, 1, 1];
        let refs: [[int]] = [[1], empty_ints(), empty_ints()];
        let r: [int] = simulate([0], kinds, refs, 3, 8);
        fails += expect("unreachable-reclaimed", r[1], 2);
    }

    // ---- 3. Cycle with no roots -> both reclaimed ----
    {
        let kinds: [int] = [1, 1];
        let refs: [[int]] = [[1], [0]];
        let r: [int] = simulate(empty_ints(), kinds, refs, 2, 8);
        fails += expect("cycle-no-root-reclaimed", r[1], 0);
    }

    // ---- 4. Cycle reachable from a root -> survives ----
    {
        let kinds: [int] = [1, 1, 1];
        let refs: [[int]] = [[1], [2], [1]];
        let r: [int] = simulate([0], kinds, refs, 3, 8);
        fails += expect("cycle-root-survives", r[1], 3);
    }

    // ---- 5. Multiple roots ----
    {
        let kinds: [int] = [1, 1, 1, 1];
        let refs: [[int]] = [[1], empty_ints(), [3], empty_ints()];
        let r: [int] = simulate([0, 2], kinds, refs, 4, 8);
        fails += expect("multiple-roots", r[1], 4);
    }

    // ---- 6. Root removal -> orphan becomes unreachable ----
    {
        let kinds: [int] = [1, 1];
        let refs: [[int]] = [[1], empty_ints()];
        let r: [int] = simulate(empty_ints(), kinds, refs, 2, 8);
        fails += expect("root-removal-reclaims", r[1], 0);
    }

    // ---- 7. Nested graph: root -> array -> object ----
    {
        let kinds: [int] = [1, 2, 1];
        let refs: [[int]] = [[1], [2], empty_ints()];
        let r: [int] = simulate([0], kinds, refs, 3, 8);
        fails += expect("nested-graph", r[1], 3);
    }

    // ---- 8. Bounded worklist overflow is detected, not silently abandoned ----
    // A wide node (0 -> 1,2,3) with a worklist cap of 2 forces the worklist
    // to exceed capacity, which must be reported, never silently abandoned.
    {
        let kinds: [int] = [1, 1, 1, 1];
        let refs: [[int]] = [[1, 2, 3], empty_ints(), empty_ints(), empty_ints()];
        let r: [int] = simulate([0], kinds, refs, 4, 2);
        fails += expect("worklist-overflow-detected", r[0], 1);
    }

    // ---- 9. Allocation limit: refusing beyond cap returns failure sentinel ----
    {
        mut kinds: [int] = empty_ints();
        mut refs: [[int]] = empty_intss();
        mut n: int = 0;
        let cap: int = 3;
        mut i: int = 0;
        while i < cap {
            let r: [int] = add_obj(kinds, refs, n, cap, 1, empty_ints());
            kinds = array_concat(kinds, [1]);
            refs = array_concat(refs, [empty_ints()]);
            n = n + 1;
            i += 1;
        }
        let over: [int] = add_obj(kinds, refs, n, cap, 1, empty_ints());
        fails += expect("alloc-cap-refuses", over[0], 0);
        fails += expect("alloc-cap-returns-minus1", over[2], -1);
    }

    // ---- 11. Unrooted temporary array is reclaimed (models the str_split
    // defect: a result array not yet rooted is collected during nested
    // allocation). ----
    {
        let kinds: [int] = [1, 1];
        let refs: [[int]] = [[1], empty_ints()];
        let r: [int] = simulate(empty_ints(), kinds, refs, 2, 8);
        fails += expect("unrooted-temp-reclaimed", r[1], 0);
    }

    // ---- 12. The same array survives when rooted before the second
    // allocation (models the fix: root the result across element allocs). ----
    {
        let kinds: [int] = [1, 1];
        let refs: [[int]] = [[1], empty_ints()];
        let r: [int] = simulate([0], kinds, refs, 2, 8);
        fails += expect("rooted-temp-survives", r[1], 2);
    }

    // ---- 13. Deep graph: an 8-object chain rooted at the head survives. ----
    {
        let kinds: [int] = [1, 1, 1, 1, 1, 1, 1, 1];
        let refs: [[int]] = [[1], [2], [3], [4], [5], [6], [7], empty_ints()];
        let r: [int] = simulate([0], kinds, refs, 8, 16);
        fails += expect("deep-chain-survives", r[1], 8);
    }

    // ---- 14. Wide graph: root fans out to six leaves; all survive. ----
    {
        let kinds: [int] = [1, 1, 1, 1, 1, 1, 1];
        let refs: [[int]] = [[1, 2, 3, 4, 5, 6], empty_ints(), empty_ints(),
                             empty_ints(), empty_ints(), empty_ints(), empty_ints()];
        let r: [int] = simulate([0], kinds, refs, 7, 16);
        fails += expect("wide-graph-survives", r[1], 7);
    }

    // ---- 15. Alias multiplicity: one object referenced several times is
    // preserved and counted once; all reachable objects survive. ----
    {
        let kinds: [int] = [1, 1, 1];
        let refs: [[int]] = [[1, 1, 2], empty_ints(), empty_ints()];
        let r: [int] = simulate([0], kinds, refs, 3, 8);
        fails += expect("alias-multiplicity", r[1], 3);
    }

    // ---- 16. Stale/out-of-range child references are safely ignored; the
    // reachable objects still survive. ----
    {
        let kinds: [int] = [1, 1, 1];
        let refs: [[int]] = [[1, 99, -1], empty_ints(), empty_ints()];
        let r: [int] = simulate([0], kinds, refs, 3, 8);
        fails += expect("stale-edge-ignored", r[1], 2);
    }

    // ---- 17+. Generation-aware identity (Phase 3F.1) ----
    // Slot index is the storage location; generation is the lifetime. A valid
    // handle must match both.
    {
        let n: int = 2;
        let gens: [int] = [1, 1];
        fails += expect("gen-initial-valid", valid_handle(gens, n, handle(0, 1)), 1);
        fails += expect("gen-wrong-gen-rejected", valid_handle(gens, n, handle(0, 2)), 0);
        fails += expect("gen-zero-rejected", valid_handle(gens, n, 0), 0);
        fails += expect("gen-oob-slot-rejected", valid_handle(gens, n, handle(9, 1)), 0);
    }

    // Release then reuse a slot: the generation advances; the old handle is
    // rejected and the replacement object's identity is preserved.
    {
        let n: int = 1;
        mut gens: [int] = [1];
        let old: int = handle(0, 1);
        fails += expect("gen-old-valid-before", valid_handle(gens, n, old), 1);
        gens = [2]; // slot 0 reused, advanced to generation 2
        fails += expect("gen-stale-rejected-after-reuse", valid_handle(gens, n, old), 0);
        let newh: int = handle(0, 2);
        fails += expect("gen-replacement-valid", valid_handle(gens, n, newh), 1);
        fails += expect("gen-replacement-distinct-id", (newh != old ? 1 : 0), 1);
    }

    // Repeated reuse: generations strictly increase; all earlier handles become
    // invalid while the current one stays valid.
    {
        let n: int = 1;
        mut gens: [int] = [1];
        let first: int = handle(0, 1);
        mut k: int = 1;
        while k < 5 {
            k += 1;
            gens = [k];
            fails += expect("gen-repeat-stale-invalid", valid_handle(gens, n, first), 0);
            fails += expect("gen-repeat-current-valid", valid_handle(gens, n, handle(0, k)), 1);
        }
    }

    // Stale child references are rejected; current-generation child references
    // are accepted.
    {
        let n: int = 3;
        let gens: [int] = [1, 2, 1]; // slot 1 is currently generation 2
        fails += expect("gen-stale-child-rejected", valid_handle(gens, n, handle(1, 1)), 0);
        fails += expect("gen-current-child-accepted", valid_handle(gens, n, handle(1, 2)), 1);
    }

    if fails == 0 { println("REF-GC: all tests passed"); }
    exit(fails > 0 ? 1 : 0);
}

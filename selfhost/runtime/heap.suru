// Stage 2 managed heap seed, implemented entirely in SURU.
//
// Objects use stable integer handles. Each object occupies five strings in the
// flat table: kind, colour, reserved capacity, payload, and child IDs.
// An empty kind is a reclaimed slot. Strings, arrays, records, closures, and
// exceptions all participate in the same object graph.
//
// The heap exposes both a full mark/sweep helper and bounded incremental
// marking. Mutators provide live object handles as roots; each mark slice
// reseeds roots, scans a bounded grey worklist, and uses a tri-colour write
// barrier when a black object gains a white child. Object traversal is
// iterative, so cycles are safe and host-language recursion is not required.

func sh_join_ids(ids: [int]) -> str {
    mut out: str = "";
    mut i: int = 0;
    while i < array_len(ids) {
        if i > 0 { out = out + ","; }
        out = out + to_str(ids[i]);
        i += 1;
    }
    return out;
}

func sh_parse_ids(encoded: str) -> [int] {
    mut out: [int] = [];
    if encoded == "" { return out; }
    let parts: [str] = str_split(encoded, ",");
    mut i: int = 0;
    while i < array_len(parts) {
        out = array_concat(out, [int_from_str(parts[i])]);
        i += 1;
    }
    return out;
}

func sh_object_count(heap: [str]) -> int {
    return array_len(heap) / 5;
}

// Logical reservation size: a 32-byte header plus the encoded payload
// and eight bytes per managed child handle, rounded up to a 16-byte class.
// This tracks the SURU table representation; it is not a host malloc size.
func sh_round_up_16(bytes: int) -> int {
    return ((bytes + 15) / 16) * 16;
}

func sh_allocation_size(payload: str, children: [int]) -> int {
    return sh_round_up_16(32 + str_len(payload) + array_len(children) * 8);
}

func sh_capacity(heap: [str], id: int) -> int {
    if id < 0 or id >= sh_object_count(heap) { return 0; }
    return int_from_str(heap[id * 5 + 2]);
}

// Small objects use ascending 16-byte size classes through 4096 bytes.
// Large objects use first-fit reuse among free large slots.
func sh_find_free(heap: [str], required: int) -> int {
    let count: int = sh_object_count(heap);
    if required <= 4096 {
        mut size_class: int = required;
        while size_class <= 4096 {
            mut id: int = 0;
            while id < count {
                if heap[id * 5] == "" and sh_capacity(heap, id) == size_class {
                    return id;
                }
                id += 1;
            }
            size_class += 16;
        }
    } else {
        mut id: int = 0;
        while id < count {
            let capacity: int = sh_capacity(heap, id);
            if heap[id * 5] == "" and capacity > 4096 and capacity >= required {
                return id;
            }
            id += 1;
        }
    }
    return count;
}

func sh_alloc(heap: [str], kind: str, payload: str, children: [int]) -> [str] {
    if kind == "" { return heap; }
    let encoded: str = sh_join_ids(children);
    let required: int = sh_allocation_size(payload, children);
    let count: int = sh_object_count(heap);
    let id: int = sh_find_free(heap, required);
    if id == count {
        return array_concat(heap, [kind, "0", to_str(required), payload, encoded]);
    }
    let next: [str] = heap;
    next[id * 5] = kind;
    next[id * 5 + 1] = "0";
    // Retain the capacity class of a reused slot.
    next[id * 5 + 3] = payload;
    next[id * 5 + 4] = encoded;
    return next;
}

func sh_set_children(heap: [str], id: int, children: [int]) -> [str] {
    if id < 0 or id >= sh_object_count(heap) { return heap; }
    if heap[id * 4] == "" { return heap; }
    let next: [str] = heap;
    next[id * 4 + 3] = sh_join_ids(children);
    return next;
}

func sh_set_payload(heap: [str], id: int, payload: str) -> [str] {
    if id < 0 or id >= sh_object_count(heap) { return heap; }
    if heap[id * 4] == "" { return heap; }
    let next: [str] = heap;
    next[id * 4 + 2] = payload;
    return next;
}

func sh_alive(heap: [str], id: int) -> bool {
    return id >= 0 and id < sh_object_count(heap) and heap[id * 4] != "";
}

func sh_kind(heap: [str], id: int) -> str {
    if not sh_alive(heap, id) { return ""; }
    return heap[id * 4];
}

func sh_payload(heap: [str], id: int) -> str {
    if not sh_alive(heap, id) { return ""; }
    return heap[id * 4 + 2];
}

func sh_children(heap: [str], id: int) -> [int] {
    let empty: [int] = [];
    if not sh_alive(heap, id) { return empty; }
    return sh_parse_ids(heap[id * 4 + 3]);
}

func sh_live_count(heap: [str]) -> int {
    mut count: int = 0;
    mut id: int = 0;
    while id < sh_object_count(heap) {
        if heap[id * 4] != "" { count += 1; }
        id += 1;
    }
    return count;
}

// Incremental collection state is [heap, grey-worklist, active-flag].
// Grey IDs are strings so the complete state is representable as [[str]].
func sh_mark_begin(heap: [str], roots: [int]) -> [[str]] {
    let next: [str] = heap;
    let count: int = sh_object_count(next);
    mut id: int = 0;
    while id < count {
        if next[id * 4] != "" { next[id * 4 + 1] = "0"; }
        id += 1;
    }
    mut work: [str] = [];
    mut r: int = 0;
    while r < array_len(roots) {
        let root: int = roots[r];
        if root >= 0 and root < count and
           next[root * 4] != "" and next[root * 4 + 1] == "0" {
            next[root * 4 + 1] = "1";
            work = array_concat(work, [to_str(root)]);
        }
        r += 1;
    }
    return [next, work, ["1"]];
}

func sh_mark_pending(state: [[str]]) -> int {
    if array_len(state) < 2 { return 0; }
    return array_len(state[1]);
}

func sh_mark_step(state: [[str]], budget: int, roots: [int]) -> [[str]] {
    if array_len(state) < 3 or state[2][0] != "1" { return state; }
    mut heap: [str] = state[0];
    mut work: [str] = state[1];
    let count: int = sh_object_count(heap);

    // Re-seed roots on every slice so roots published between slices survive.
    mut r: int = 0;
    while r < array_len(roots) {
        let root: int = roots[r];
        if root >= 0 and root < count and
           heap[root * 4] != "" and heap[root * 4 + 1] == "0" {
            heap[root * 4 + 1] = "1";
            work = array_concat(work, [to_str(root)]);
        }
        r += 1;
    }

    mut processed: int = 0;
    while processed < budget and array_len(work) > 0 {
        let last: int = array_len(work) - 1;
        let current: int = int_from_str(work[last]);
        work = slice(work, 0, last);
        let refs: [int] = sh_parse_ids(heap[current * 4 + 3]);
        mut child: int = 0;
        while child < array_len(refs) {
            let target: int = refs[child];
            if target >= 0 and target < count and
               heap[target * 4] != "" and heap[target * 4 + 1] == "0" {
                heap[target * 4 + 1] = "1";
                work = array_concat(work, [to_str(target)]);
            }
            child += 1;
        }
        heap[current * 4 + 1] = "2";
        processed += 1;
    }
    return [heap, work, state[2]];
}

func sh_find_free(heap: [str]) -> int {
    mut id: int = 0;
    let count: int = sh_object_count(heap);
    while id < count and heap[id * 4] != "" { id += 1; }
    return id;
}

func sh_alloc_incremental(state: [[str]], kind: str, payload: str,
                           children: [int]) -> [[str]] {
    if array_len(state) < 3 { return state; }
    let heap: [str] = state[0];
    let id: int = sh_find_free(heap);
    let next: [str] = sh_alloc(heap, kind, payload, children);
    mut work: [str] = state[1];
    if kind != "" and state[2][0] == "1" {
        next[id * 4 + 1] = "1";
        work = array_concat(work, [to_str(id)]);
    }
    return [next, work, state[2]];
}

func sh_write_barrier(state: [[str]], destination: int,
                      target: int) -> [[str]] {
    if array_len(state) < 3 or state[2][0] != "1" { return state; }
    mut heap: [str] = state[0];
    mut work: [str] = state[1];
    let count: int = sh_object_count(heap);
    if destination >= 0 and destination < count and
       target >= 0 and target < count and
       heap[destination * 4] != "" and heap[target * 4] != "" and
       heap[destination * 4 + 1] == "2" and
       heap[target * 4 + 1] == "0" {
        heap[target * 4 + 1] = "1";
        work = array_concat(work, [to_str(target)]);
    }
    return [heap, work, state[2]];
}

func sh_set_children_incremental(state: [[str]], destination: int,
                                 children: [int]) -> [[str]] {
    if array_len(state) < 3 { return state; }
    let heap: [str] = sh_set_children(state[0], destination, children);
    mut next: [[str]] = [heap, state[1], state[2]];
    mut i: int = 0;
    while i < array_len(children) {
        next = sh_write_barrier(next, destination, children[i]);
        i += 1;
    }
    return next;
}

func sh_sweep(heap: [str]) -> [str] {
    let next: [str] = heap;
    mut id: int = 0;
    while id < sh_object_count(next) {
        let base: int = id * 4;
        if next[base] != "" {
            if next[base + 1] == "0" {
                next[base] = "";
                next[base + 1] = "0";
                next[base + 2] = "";
                next[base + 3] = "";
            } else {
                next[base + 1] = "0";
            }
        }
        id += 1;
    }
    return next;
}

func sh_collect(heap: [str], roots: [int]) -> [str] {
    mut state: [[str]] = sh_mark_begin(heap, roots);
    let no_roots: [int] = [];
    let count: int = sh_object_count(heap);
    while sh_mark_pending(state) > 0 {
        state = sh_mark_step(state, count + 1, no_roots);
    }
    return sh_sweep(state[0]);
}

// Natural Syntax AST node representation with typed fields.
// Rendered format: "ast|kind|line|field1|field2|..."

type NAstNode {
    let kind: str;
    let line: int;
    let text: str;
}

// NAstNodeRef: Structured node reference with marker convention
// This replaces optional NAstNode (which doesn't compile in SURU)
type NAstNodeRef {
    let has_value: bool;
    let node_text: str;  // "~none~" when has_value=false, rendered AST when has_value=true
}

// None marker constant
const NAST_NONE: str = "~none~";

func na_ref_none() -> NAstNodeRef {
    return NAstNodeRef(false, NAST_NONE);
}

func na_ref_node(text: str) -> NAstNodeRef {
    return NAstNodeRef(true, text);
}

// ============================================
// Expression Nodes (Typed)
// ============================================

type NAstIntLiteral {
    let nkind: str;
    let nline: int;
    let nvalue: int;
}

type NAstFloatLiteral {
    let nkind: str;
    let nline: int;
    let nvalue: float;
}

type NAstStringLiteral {
    let nkind: str;
    let nline: int;
    let nvalue: str;
}

type NAstBoolLiteral {
    let nkind: str;
    let nline: int;
    let nvalue: bool;
}

type NAstNoneLiteral {
    let nkind: str;
    let nline: int;
}

type NAstVarRef {
    let nkind: str;
    let nline: int;
    let nname: str;
}

type NAstBinaryExpr {
    let nkind: str;
    let nline: int;
    let nop: str;
    let nleft: NAstNodeRef;
    let nright: NAstNodeRef;
}

type NAstUnaryExpr {
    let nkind: str;
    let nline: int;
    let nop: str;
    let noperand: NAstNodeRef;
}

type NAstCallExpr {
    let nkind: str;
    let nline: int;
    let nfunc: str;
    let nargs: [str];
}

type NAstIndexExpr {
    let nkind: str;
    let nline: int;
    let narray: str;
    let nindex: str;
}

type NAstFieldExpr {
    let nkind: str;
    let nline: int;
    let nrecord: str;
    let nfield: str;
}

type NAstArrayExpr {
    let nkind: str;
    let nline: int;
    let nelements: [str];
}

type NAstParenExpr {
    let nkind: str;
    let nline: int;
    let ninner: NAstNodeRef;
}

type NAstRoutineExpr {
    let nkind: str;
    let nline: int;
    let nparams: str;
    let nret_type: str;
    let nbody: str;
}

// ============================================
// Type Nodes (Typed)
// ============================================

type NAstPrimitiveType {
    let nkind: str;
    let nname: str;
}

type NAstArrayType {
    let nkind: str;
    let nelement_type: str;
}

type NAstFunctionType {
    let nkind: str;
    let nparams: [str];
    let nret_type: str;
}

type NAstNamedType {
    let nkind: str;
    let nname: str;
}

type NAstGenericType {
    let nkind: str;
    let nname: str;
    let nargs: [str];
}

// ============================================
// Constructor functions for expression nodes
// ============================================

func nae_make_int(line: int, value: int) -> NAstIntLiteral {
    return NAstIntLiteral("int_literal", line, value);
}

func nae_make_float(line: int, value: float) -> NAstFloatLiteral {
    return NAstFloatLiteral("float_literal", line, value);
}

func nae_make_string(line: int, value: str) -> NAstStringLiteral {
    return NAstStringLiteral("string_literal", line, value);
}

func nae_make_bool(line: int, value: bool) -> NAstBoolLiteral {
    return NAstBoolLiteral("bool_literal", line, value);
}

func nae_make_none(line: int) -> NAstNoneLiteral {
    return NAstNoneLiteral("none_literal", line);
}

func nae_make_var(line: int, name: str) -> NAstVarRef {
    return NAstVarRef("var_ref", line, name);
}

func nae_make_binary(line: int, op: str, left: NAstNodeRef, right: NAstNodeRef) -> NAstBinaryExpr {
    return NAstBinaryExpr("binary", line, op, left, right);
}

func nae_make_unary(line: int, op: str, operand: str) -> NAstUnaryExpr {
    return NAstUnaryExpr("unary", line, op, operand);
}

func nae_make_call(line: int, func_name: str, args: [str]) -> NAstCallExpr {
    return NAstCallExpr("call", line, func_name, args);
}

func nae_make_index(line: int, array: str, index: str) -> NAstIndexExpr {
    return NAstIndexExpr("index", line, array, index);
}

func nae_make_field(line: int, record: str, field: str) -> NAstFieldExpr {
    return NAstFieldExpr("field", line, record, field);
}

func nae_make_array(line: int, elements: [str]) -> NAstArrayExpr {
    return NAstArrayExpr("array", line, elements);
}

func nae_make_paren(line: int, inner: str) -> NAstParenExpr {
    return NAstParenExpr("paren", line, inner);
}

func nae_make_routine_expr(line: int, params: str, ret_type: str, body: str) -> NAstRoutineExpr {
    return NAstRoutineExpr("routine_expr", line, params, ret_type, body);
}

// ============================================
// Constructor functions for type nodes
// ============================================

func nat_make_primitive(name: str) -> NAstPrimitiveType {
    return NAstPrimitiveType("primitive_type", name);
}

func nat_make_array(element_type: str) -> NAstArrayType {
    return NAstArrayType("array_type", element_type);
}

func nat_make_function(params: [str], ret_type: str) -> NAstFunctionType {
    return NAstFunctionType("function_type", params, ret_type);
}

func nat_make_named(name: str) -> NAstNamedType {
    return NAstNamedType("named_type", name);
}

func nat_make_generic(name: str, args: [str]) -> NAstGenericType {
    return NAstGenericType("generic_type", name, args);
}

// ============================================
// Expression render functions (for debugging)
// ============================================

func nae_render_int(node: NAstIntLiteral) -> str {
    return "int(" + to_str(node.nvalue) + ")";
}

func nae_render_float(node: NAstFloatLiteral) -> str {
    return "float(" + to_str(node.nvalue) + ")";
}

func nae_render_string(node: NAstStringLiteral) -> str {
    return "string(\"" + node.nvalue + "\")";
}

func nae_render_bool(node: NAstBoolLiteral) -> str {
    if node.nvalue { return "bool(true)"; }
    return "bool(false)";
}

func nae_render_none(node: NAstNoneLiteral) -> str {
    return "none";
}

func nae_render_var(node: NAstVarRef) -> str {
    return "var(" + node.nname + ")";
}

func nae_render_binary(node: NAstBinaryExpr) -> str {
    return "binary(" + node.nop + "," + node.nleft + "," + node.nright + ")";
}

func nae_render_unary(node: NAstUnaryExpr) -> str {
    return "unary(" + node.nop + "," + node.noperand + ")";
}

func nae_render_call(node: NAstCallExpr) -> str {
    return "call(" + node.nfunc + ",[" + str_join(node.nargs, ",") + "])";
}

func nae_render_index(node: NAstIndexExpr) -> str {
    return "index(" + node.narray + "," + node.nindex + ")";
}

func nae_render_field(node: NAstFieldExpr) -> str {
    return "field(" + node.nrecord + "." + node.nfield + ")";
}

func nae_render_array(node: NAstArrayExpr) -> str {
    return "array([" + str_join(node.nelements, ",") + "])";
}

func nae_render_paren(node: NAstParenExpr) -> str {
    return "paren(" + node.ninner + ")";
}

func nae_render_routine_expr(node: NAstRoutineExpr) -> str {
    return "routine_expr(" + node.nparams + "->" + node.nret_type + "," + node.nbody + ")";
}

// ============================================
// OLD API - Kept for backward compatibility
// ============================================

// Binding modes
const BINDING_VALUE: str = "value";
const BINDING_CHANGE: str = "change";
const BINDING_CONSTANT: str = "constant";

// Each iteration modes
const EACH_ACROSS: str = "across";
const EACH_FROM: str = "from";

func na_make(kind: str, line: int, text: str) -> NAstNode {
    return NAstNode(kind, line, text);
}

func na_render(node: NAstNode) -> str {
    return "ast|" + node.kind + "|" + to_str(node.line) + "|" + node.text;
}

// Typed constructors for statements

func na_make_binding(line: int, mode: str, name: str, annotation: str, value: str) -> NAstNode {
    return NAstNode("binding", line, mode + "|" + name + "|" + annotation + "|" + value);
}

func na_make_assignment(line: int, target: str, value: str) -> NAstNode {
    return NAstNode("assignment", line, target + "|" + value);
}

func na_make_show(line: int, expression: str) -> NAstNode {
    return NAstNode("show", line, expression);
}

func na_make_give(line: int, value: str) -> NAstNode {
    return NAstNode("give", line, value);
}

func na_make_show_give(line: int) -> NAstNode {
    return NAstNode("give", line, "");
}

// Typed constructors for control flow

func na_make_when(line: int, condition: str) -> NAstNode {
    return NAstNode("when", line, condition);
}

func na_make_otherwise_when(line: int, condition: str) -> NAstNode {
    return NAstNode("otherwise-when", line, condition);
}

func na_make_otherwise(line: int) -> NAstNode {
    return NAstNode("otherwise", line, "");
}

func na_make_repeat(line: int, condition: str) -> NAstNode {
    return NAstNode("repeat", line, condition);
}

func na_make_each(line: int, item: str, mode: str, source: str) -> NAstNode {
    return NAstNode("each", line, item + "|" + mode + "|" + source);
}

func na_make_each_from(line: int, item: str, start: str, until_through: str, finish: str) -> NAstNode {
    return NAstNode("each", line, item + "|from|" + start + "|" + until_through + "|" + finish);
}

func na_make_choose(line: int, condition: str) -> NAstNode {
    return NAstNode("choose", line, condition);
}

func na_make_case(line: int, pattern: str) -> NAstNode {
    return NAstNode("case", line, pattern);
}

func na_make_end_block(line: int, block_kind: str) -> NAstNode {
    return NAstNode("end-" + block_kind, line, "");
}

// Attempt/handle/ensure

func na_make_attempt(line: int) -> NAstNode {
    return NAstNode("attempt", line, "");
}

func na_make_handle(line: int, name: str, exception_type: str) -> NAstNode {
    return NAstNode("handle", line, name + "|" + exception_type);
}

func na_make_ensure(line: int) -> NAstNode {
    return NAstNode("ensure", line, "");
}

// Typed constructors for declarations

func na_make_routine(line: int, name: str, params: str, return_type: str, throws: str) -> NAstNode {
    return NAstNode("routine", line, name + "|" + params + "|" + return_type + "|" + throws);
}

func na_make_record(line: int, name: str, supports: str) -> NAstNode {
    return NAstNode("record", line, name + "|" + supports);
}

func na_make_record_field(line: int, mutable: bool, name: str, field_type: str) -> NAstNode {
    mut mut_flag: str = "immutable";
    if mutable { mut_flag = "mutable"; }
    return NAstNode("field", line, mut_flag + "|" + name + "|" + field_type);
}

func na_make_contract(line: int, name: str) -> NAstNode {
    return NAstNode("contract", line, name);
}

func na_make_contract_signature(line: int, name: str, params: str, return_type: str, throws: str) -> NAstNode {
    return NAstNode("signature", line, name + "|" + params + "|" + return_type + "|" + throws);
}

func na_make_choice(line: int, name: str) -> NAstNode {
    return NAstNode("choice", line, name);
}

func na_make_choice_variant(line: int, name: str, payload: str) -> NAstNode {
    return NAstNode("variant", line, name + "|" + payload);
}

func na_make_constant(line: int, name: str, annotation: str, value: str) -> NAstNode {
    return NAstNode("constant", line, name + "|" + annotation + "|" + value);
}

func na_make_bring(line: int, path: str, alias: str) -> NAstNode {
    return NAstNode("bring", line, path + "|" + alias);
}

// Structured Natural Syntax token stream.
// The cursor is a byte offset; each call returns one structured token and its
// next offset. This representation is compatible with the current VM, which
// does not support arrays of records.

use "source.suru";
use "natural_lexer.suru";

const NT_EOF = 0;
const NT_NEWLINE = 1;
const NT_IDENT = 2;
const NT_INT = 3;
const NT_FLOAT = 4;
const NT_STRING = 5;
const NT_WORD = 6;
const NT_OPERATOR = 7;
const NT_PUNCT = 8;

type NToken {
    let kind: int;
    let line: int;
    let column: int;
    let start: int;
    let finish: int;
    let next: int;
    let text: str;
    let error: bool;
    let error_code: int;
}

func nt_make(kind: int, source: str, start: int, finish: int) -> NToken {
    return NToken(kind, source_line_at(source, start),
                  source_scalar_column_at(source, start), start, finish, finish,
                  substr(source, start, finish - start), false, 0);
}

func nt_error(source: str, position: int, code: int) -> NToken {
    return NToken(NT_EOF, source_line_at(source, position),
                  source_scalar_column_at(source, position), position, position,
                  position, "", true, code);
}

func nt_is_word(word: str) -> bool {
    return n_is_keyword(word);
}

func nt_operator_end(source: str, start: int, n: int) -> int {
    mut finish: int = start + 1;
    if finish < n and (source[finish] == "=" or
                       source[finish] == source[start] or
                       (source[start] == "-" and source[finish] == ">")) {
        finish += 1;
    }
    return finish;
}

func natural_next(source: str, position: int) -> NToken {
    let n: int = str_len(source);
    mut i: int = position;

    if position == 0 and n > 67108864 { return nt_error(source, 0, 208); }
    if position == 0 and str_valid_utf8(source) == false {
        return nt_error(source, 0, 207);
    }

    if i == 0 and n >= 2 and source[0] == "#" and source[1] == "!" {
        while i < n and source[i] != "\n" { i += 1; }
        if i < n and source[i] == "\n" { i += 1; }
    }
    while i < n {
        if source[i] == " " or source[i] == "\t" or source[i] == "\r" {
            i += 1;
        } else if i + 1 < n and source[i] == "/" and source[i + 1] == "/" {
            i += 2;
            while i < n and source[i] != "\n" { i += 1; }
        } else if i + 1 < n and source[i] == "/" and source[i + 1] == "*" {
            mut depth: int = 1;
            i += 2;
            while i < n and depth > 0 {
                if i + 1 < n and source[i] == "/" and source[i + 1] == "*" {
                    depth += 1;
                    if depth > 512 { return nt_error(source, i, 209); }
                    i += 2;
                } else if i + 1 < n and source[i] == "*" and source[i + 1] == "/" {
                    depth -= 1;
                    i += 2;
                } else {
                    i += 1;
                }
            }
            if depth > 0 { return nt_error(source, i, 201); }
        } else {
            break;
        }
    }
    if i >= n { return nt_make(NT_EOF, source, n, n); }
    if source[i] == "\n" { return nt_make(NT_NEWLINE, source, i, i + 1); }

    let start: int = i;
    let c: str = source[i];
    if n_is_alpha(c) or c >= "\u0080" {
        i += 1;
        while i < n and n_is_continue(source[i]) { i += 1; }
        let word: str = substr(source, start, i - start);
        if str_len(word) >= 2 and word[0] == "_" and word[1] == "_" {
            return nt_error(source, start, 211);
        }
        if nt_is_word(word) { return nt_make(NT_WORD, source, start, i); }
        return nt_make(NT_IDENT, source, start, i);
    }
    if n_is_digit(c) {
        mut kind: int = NT_INT;
        i += 1;
        while i < n and (n_is_digit(source[i]) or
                         str_contains("abcdefABCDEFxXbB_.eE+-", source[i])) {
            if (source[i] == "+" or source[i] == "-") and
               i > start and source[i - 1] != "e" and source[i - 1] != "E" {
                break;
            }
            if source[i] == "." or source[i] == "e" or source[i] == "E" {
                kind = NT_FLOAT;
            }
            i += 1;
        }
        return nt_make(kind, source, start, i);
    }
    if c == "\"" {
        i += 1;
        mut interpolation_depth: int = 0;
        while i < n and source[i] != "\"" {
            if source[i] == "\n" { return nt_error(source, start, 202); }
            if source[i] == "\\" {
                if i + 1 >= n or str_contains("ntr0\\\"'u", source[i + 1]) == false {
                    return nt_error(source, i, 203);
                }
                if source[i + 1] == "u" {
                    if i + 5 >= n { return nt_error(source, i, 203); }
                    mut h: int = 0;
                    while h < 4 {
                        if str_contains("0123456789abcdefABCDEF", source[i + 2 + h]) == false {
                            return nt_error(source, i, 203);
                        }
                        h += 1;
                    }
                    i += 6;
                } else { i += 2; }
            } else if i + 1 < n and source[i] == "{" and source[i + 1] == "{" {
                i += 2;
            } else if i + 1 < n and source[i] == "}" and source[i + 1] == "}" {
                i += 2;
            } else if source[i] == "{" {
                interpolation_depth += 1;
                if interpolation_depth > 128 { return nt_error(source, i, 210); }
                i += 1;
            } else if source[i] == "}" and interpolation_depth > 0 {
                interpolation_depth -= 1;
                i += 1;
            } else {
                i += 1;
            }
        }
        if i >= n { return nt_error(source, start, 202); }
        if interpolation_depth != 0 { return nt_error(source, start, 204); }
        return nt_make(NT_STRING, source, start, i + 1);
    }
    if c == "(" or c == ")" or c == "[" or c == "]" or
       c == "{" or c == "}" or c == "," or c == ":" or c == "." {
        return nt_make(NT_PUNCT, source, i, i + 1);
    }
    if str_contains("+-*/%=<>!&|^?~", c) {
        return nt_make(NT_OPERATOR, source, i, nt_operator_end(source, i, n));
    }
    return nt_error(source, i, 206);
}

func natural_token_dump(source: str) -> int {
    mut position: int = 0;
    while true {
        let t = natural_next(source, position);
        if t.error {
            println("error|" + to_str(t.error_code) + "|" + to_str(t.start) +
                    "|" + to_str(t.line) + "|" + to_str(t.column));
            return 1;
        }
        println(to_str(t.kind) + "|" + to_str(t.line) + "|" +
                to_str(t.column) + "|" + to_str(t.start) + "|" +
                to_str(t.finish) + "|" + t.text);
        position = t.next;
        if t.kind == NT_EOF { return 0; }
    }
    return 1;
}

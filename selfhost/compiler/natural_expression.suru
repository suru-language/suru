// Precedence-aware Natural Syntax expression parser.
// Results are serialized AST shapes until the full self-hosted AST is added.

use "natural_token_stream.suru";

func ne_ok(next: int, value: str) -> [str] {
    return [to_str(next), "ok", value, ""];
}

func ne_fail(next: int, message: str) -> [str] {
    return [to_str(next), "error", "", message];
}

func ne_next(result: [str]) -> int {
    return int_from_str(result[0]);
}

func ne_is_ok(result: [str]) -> bool {
    return result[1] == "ok";
}

func ne_value(result: [str]) -> str {
    return result[2];
}

func ne_message(result: [str]) -> str {
    return result[3];
}

func ne_skip_lines(source: str, position: int) -> int {
    mut p: int = position;
    while true {
        let t = natural_next(source, p);
        if t.kind != NT_NEWLINE { return p; }
        p = t.next;
    }
    return p;
}

func ne_match_delim(source: str, position: int, open: str, close: str) -> int {
    mut depth: int = 1;
    mut p: int = position;
    while true {
        let tok = natural_next(source, p);
        if tok.error { return -1; }
        if tok.kind == NT_EOF { return -1; }
        if tok.text == open { depth += 1; }
        else if tok.text == close {
            depth -= 1;
            if depth == 0 { return tok.next; }
        }
        p = tok.next;
    }
    return -1;
}

func ne_parse_routine(source: str, first: NToken) -> [str] {
    let start: int = first.start;
    let open = natural_next(source, first.next);
    if open.text != "(" { return ne_fail(open.start, "expected '(' in routine-expression"); }
    let after_params: int = ne_match_delim(source, open.next, "(", ")");
    if after_params < 0 { return ne_fail(open.start, "unterminated parameter list"); }
    mut p: int = after_params;
    let t = natural_next(source, p);
    if t.text == "->" {
        let rt = natural_next(source, t.next);
        if rt.text == "[" {
            let end = ne_match_delim(source, rt.next, "[", "]");
            if end < 0 { return ne_fail(rt.start, "invalid array return type"); }
            p = end;
        } else {
            p = rt.next;
        }
    }
    let tt = natural_next(source, p);
    if tt.text == "throws" {
        p = tt.next;
        mut done: bool = false;
        while not done {
            let ty = natural_next(source, p);
            if ty.kind == NT_IDENT or ty.kind == NT_WORD {
                p = ty.next;
            } else {
                done = true;
            }
        }
    }
    mut depth: int = 1;
    while true {
        let tok = natural_next(source, p);
        if tok.error { return ne_fail(tok.start, "lexical error"); }
        if tok.kind == NT_EOF { return ne_fail(tok.start, "unterminated routine-expression"); }
        if tok.text == "routine" or tok.text == "record" or tok.text == "contract" or
           tok.text == "choice" or tok.text == "when" or tok.text == "each" or
           tok.text == "repeat" or tok.text == "attempt" or tok.text == "choose" or
           tok.text == "handle" or tok.text == "ensure" {
            depth += 1;
            p = tok.next;
            continue;
        }
        if tok.text == "end" {
            let kindtok = natural_next(source, tok.next);
            depth -= 1;
            if depth == 0 {
                if kindtok.text == "routine" {
                    return ne_ok(kindtok.next, substr(source, start, kindtok.next - start));
                }
                return ne_fail(kindtok.start, "mismatched end in routine-expression");
            }
            p = kindtok.next;
            continue;
        }
        p = tok.next;
    }
    return ne_fail(p, "unterminated routine-expression");
}

func ne_prec(text: str) -> int {
    if text == "or" { return 1; }
    if text == "and" { return 2; }
    if text == "==" or text == "!=" or text == "<" or text == "<=" or
       text == ">" or text == ">=" { return 3; }
    if text == "|" { return 4; }
    if text == "^" { return 5; }
    if text == "&" { return 6; }
    if text == "<<" or text == ">>" { return 7; }
    if text == "+" or text == "-" { return 8; }
    if text == "*" or text == "/" or text == "%" { return 9; }
    return 0;
}

// The parser is intentionally one recursive routine. Keeping primary, unary,
// postfix, and binary parsing together avoids forward declarations, which are
// not part of the current SURU grammar.
func ne_parse_expression(source: str, position: int, minimum: int) -> [str] {
    let p: int = ne_skip_lines(source, position);
    let first = natural_next(source, p);
    if first.error { return ne_fail(p, "lexical error"); }

    mut result: [str] = ne_fail(p, "expected expression");
    if first.text == "routine" {
        result = ne_parse_routine(source, first);
    } else if first.text == "-" or first.text == "not" or first.text == "~" {
        let operand = ne_parse_expression(source, first.next, 10);
        if ne_is_ok(operand) == false { return operand; }
        result = ne_ok(ne_next(operand), "(" + first.text + " " + ne_value(operand) + ")");
    } else if first.kind == NT_IDENT or first.kind == NT_WORD or
              first.kind == NT_INT or first.kind == NT_FLOAT or
              first.kind == NT_STRING {
        result = ne_ok(first.next, first.text);
    } else if first.text == "(" {
        let inner = ne_parse_expression(source, first.next, 0);
        if ne_is_ok(inner) == false { return inner; }
        let close = natural_next(source, ne_skip_lines(source, ne_next(inner)));
        if close.text != ")" { return ne_fail(close.next, "expected ')'"); }
        result = ne_ok(close.next, "(" + ne_value(inner) + ")");
    } else if first.text == "[" {
        mut next: int = first.next;
        mut value: str = "[";
        let empty = natural_next(source, ne_skip_lines(source, next));
        if empty.text == "]" {
            result = ne_ok(empty.next, "[]");
        } else {
            mut count: int = 0;
            while true {
                let item = ne_parse_expression(source, next, 0);
                if ne_is_ok(item) == false { return item; }
                if count > 0 { value = value + ","; }
                value = value + ne_value(item);
                count += 1;
                next = ne_skip_lines(source, ne_next(item));
                let separator = natural_next(source, next);
                if separator.text == "," {
                    next = separator.next;
                    continue;
                }
                if separator.text == "]" {
                    result = ne_ok(separator.next, value + "]");
                    break;
                }
                return ne_fail(separator.next, "expected ',' or ']'");
            }
        }
    } else {
        return ne_fail(p, "expected expression");
    }

    mut next: int = ne_next(result);
    mut value: str = ne_value(result);
    while true {
        let postfix_position: int = ne_skip_lines(source, next);
        let postfix = natural_next(source, postfix_position);
        if postfix.text == "." {
            let name = natural_next(source, postfix.next);
            if name.kind != NT_IDENT { return ne_fail(name.next, "expected field name"); }
            value = value + "." + name.text;
            next = name.next;
        } else if postfix.text == "[" {
            let index = ne_parse_expression(source, postfix.next, 0);
            if ne_is_ok(index) == false { return index; }
            let close = natural_next(source, ne_skip_lines(source, ne_next(index)));
            if close.text != "]" { return ne_fail(close.next, "expected ']'"); }
            value = value + "[" + ne_value(index) + "]";
            next = close.next;
        } else if postfix.text == "(" {
            mut argument: int = postfix.next;
            mut call: str = value + "(";
            mut count: int = 0;
            let empty = natural_next(source, ne_skip_lines(source, argument));
            if empty.text == ")" {
                value = call + ")";
                next = empty.next;
                continue;
            }
            while true {
                let arg = ne_parse_expression(source, argument, 0);
                if ne_is_ok(arg) == false { return arg; }
                if count > 0 { call = call + ","; }
                call = call + ne_value(arg);
                count += 1;
                argument = ne_skip_lines(source, ne_next(arg));
                let separator = natural_next(source, argument);
                if separator.text == "," {
                    argument = separator.next;
                    continue;
                }
                if separator.text == ")" {
                    value = call + ")";
                    next = separator.next;
                    break;
                }
                return ne_fail(separator.next, "expected ',' or ')' in call");
            }
        } else {
            break;
        }
    }

    while true {
        let operator_position: int = ne_skip_lines(source, next);
        let operator = natural_next(source, operator_position);
        let precedence: int = ne_prec(operator.text);
        if precedence < minimum or precedence == 0 { break; }
        let right = ne_parse_expression(source, operator.next, precedence + 1);
        if ne_is_ok(right) == false { return right; }
        value = "(" + value + " " + operator.text + " " + ne_value(right) + ")";
        next = ne_next(right);
    }

    if minimum <= 1 {
        let ternary_position: int = ne_skip_lines(source, next);
        let maybe = natural_next(source, ternary_position);
        if maybe.text == "?" {
            let then = ne_parse_expression(source, maybe.next, 0);
            if ne_is_ok(then) == false { return then; }
            let colon_position: int = ne_skip_lines(source, ne_next(then));
            let colon = natural_next(source, colon_position);
            if colon.text != ":" { return ne_fail(colon.next, "expected ':'"); }
            let els = ne_parse_expression(source, colon.next, 0);
            if ne_is_ok(els) == false { return els; }
            return ne_ok(ne_next(els), "(" + value + " ? " +
                         ne_value(then) + " : " + ne_value(els) + ")");
        }
    }
    return ne_ok(next, value);
}

func natural_expression_check(source: str) -> int {
    let first = natural_next(source, 0);
    if first.error {
        println("expr-error|lexical error|" + to_str(first.error_code));
        return 1;
    }
    let result = ne_parse_expression(source, 0, 0);
    if ne_is_ok(result) == false {
        println("expr-error|" + ne_message(result));
        return 1;
    }
    let end = natural_next(source, ne_skip_lines(source, ne_next(result)));
    if end.kind != NT_EOF {
        println("expr-error|unexpected token|" + end.text);
        return 1;
    }
    println("expr|" + ne_value(result));
    return 0;
}

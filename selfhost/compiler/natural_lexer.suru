// Natural Syntax 2.0 lexer gate. This module intentionally emits a textual
// token trace; parser integration is a later phase and legacy lexer semantics
// remain in lexer.suru.

func strip_underscores(text: str) -> str {
    mut out: str = "";
    mut i: int = 0;
    while i < str_len(text) {
        if text[i] != "_" { out = out + text[i]; }
        i += 1;
    }
    return out;
}

func hex_value(c: str) -> int {
    if c >= "0" and c <= "9" { return int_from_str(c); }
    if c == "a" or c == "A" { return 10; }
    if c == "b" or c == "B" { return 11; }
    if c == "c" or c == "C" { return 12; }
    if c == "d" or c == "D" { return 13; }
    if c == "e" or c == "E" { return 14; }
    return 15;
}

func integer_value(text: str) -> int {
    let clean: str = strip_underscores(text);
    if str_len(clean) >= 2 and clean[0] == "0" and
       (clean[1] == "x" or clean[1] == "X") {
        mut value: int = 0;
        mut i: int = 2;
        while i < str_len(clean) {
            value = value * 16 + hex_value(clean[i]);
            i += 1;
        }
        return value;
    }
    if str_len(clean) >= 2 and clean[0] == "0" and
       (clean[1] == "b" or clean[1] == "B") {
        mut value: int = 0;
        mut i: int = 2;
        while i < str_len(clean) {
            value = value * 2 + int_from_str(clean[i]);
            i += 1;
        }
        return value;
    }
    return int_from_str(clean);
}

func decode_string(source: str, start: int, finish: int) -> str {
    mut out: str = "";
    mut i: int = start + 1;
    while i < finish - 1 {
        if source[i] != "\\" {
            out = out + source[i];
            i += 1;
        } else {
            let e: str = source[i + 1];
            if e == "n" { out = out + "\n"; }
            else if e == "t" { out = out + "\t"; }
            else if e == "r" { out = out + "\r"; }
            else if e == "0" { out = out + "\0"; }
            else if e == "\\" { out = out + "\\"; }
            else if e == "\"" { out = out + "\""; }
            else { out = out + "'"; }
            i += 2;
        }
    }
    return out;
}

func escaped_value(text: str) -> str {
    mut out: str = "";
    mut i: int = 0;
    while i < str_len(text) {
        let c: str = text[i];
        if c == "\\" { out = out + "\\\\"; }
        else if c == "\n" { out = out + "\\n"; }
        else if c == "\t" { out = out + "\\t"; }
        else if c == "\r" { out = out + "\\r"; }
        else if c == "\0" { out = out + "\\0"; }
        else { out = out + c; }
        i += 1;
    }
    return out;
}

const N_EOF = 0;
const N_NEWLINE = 1;
const N_IDENT = 2;
const N_NUMBER = 3;
const N_STRING = 4;
const N_KEYWORD = 5;
const N_OPERATOR = 6;
const N_PUNCT = 7;

func n_is_digit(c: str) -> bool {
    return str_contains("0123456789", c);
}

func n_is_alpha(c: str) -> bool {
    return str_contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c);
}

func n_is_continue(c: str) -> bool {
    // The runtime exposes source slices as UTF-8 text. Non-ASCII scalar
    // values are accepted as identifier continuation characters; punctuation
    // remains excluded so malformed source cannot be absorbed into a name.
    return n_is_alpha(c) or n_is_digit(c) or
           (str_contains(" \t\r\n()[]{}:,.;+-*/%=<>!&|^?~\"", c) == false);
}

func n_is_keyword(word: str) -> bool {
    return str_contains(" across and as attempt bring case change choose constant contract each end ensure exception expose false from give handle if in not through until otherwise or record repeat routine set show supports true value when while throws this none ", " " + word + " ");
}

func n_emit(kind: str, source: str, start: int, finish: int, decoded: str) {
    println(kind + "|" + to_str(source_line_at(source, start)) + "|" +
            to_str(source_scalar_column_at(source, start)) + "|" +
            to_str(start) + "|" + to_str(finish) + "|" +
            substr(source, start, finish - start) + "|" + decoded);
}

func n_error(source: str, position: int, code: int) {
    mut message: str = "invalid natural syntax";
    if code == 201 { message = "unterminated-comment"; }
    else if code == 202 { message = "unterminated-string"; }
    else if code == 203 { message = "invalid-escape"; }
    else if code == 204 { message = "unterminated-interpolation"; }
    else if code == 205 { message = "unmatched-delimiter"; }
    else if code == 206 { message = "invalid-character"; }
    else if code == 207 { message = "invalid-utf8"; }
    else if code == 208 { message = "source-too-large"; }
    else if code == 209 { message = "comment-nesting-too-deep"; }
    else if code == 210 { message = "interpolation-nesting-too-deep"; }
    println("error|" + to_str(code) + "|" + to_str(position) + "|" +
            to_str(source_line_at(source, position)) + "|" +
            to_str(source_scalar_column_at(source, position)) + "|" + message);
}

func natural_lex_dump(source: str) -> int {
    let n: int = str_len(source);
    mut i: int = 0;
    mut parens: int = 0;
    mut brackets: int = 0;
    mut line_start: bool = true;

    if n > 67108864 {
        n_error(source, 0, 208);
        return 1;
    }
    if str_valid_utf8(source) == false {
        n_error(source, 0, 207);
        return 1;
    }

    if n >= 2 and source[0] == "#" and source[1] == "!" {
        while i < n and source[i] != "\n" { i += 1; }
    }

    while i < n {
        let c: str = source[i];
        if c == " " or c == "\t" or c == "\r" {
            i += 1;
            continue;
        }
        if c == "\n" {
            if parens == 0 and brackets == 0 and not line_start {
                n_emit("NEWLINE", source, i, i + 1, "");
            }
            i += 1;
            line_start = true;
            continue;
        }
        if i + 1 < n and c == "/" and source[i + 1] == "/" {
            i += 2;
            while i < n and source[i] != "\n" { i += 1; }
            continue;
        }
        if i + 1 < n and c == "/" and source[i + 1] == "*" {
            mut depth: int = 1;
            i += 2;
            while i < n and depth > 0 {
                if i + 1 < n and source[i] == "/" and source[i + 1] == "*" {
                    depth += 1;
                    if depth > 512 { n_error(source, i, 209); return 1; }
                    i += 2;
                } else if i + 1 < n and source[i] == "*" and source[i + 1] == "/" {
                    depth -= 1;
                    i += 2;
                } else {
                    i += 1;
                }
            }
            if depth > 0 {
                n_error(source, i, 201);
                return 1;
            }
            continue;
        }

        let start: int = i;
        if n_is_alpha(c) or c >= "\u0080" {
            i += 1;
            while i < n and n_is_continue(source[i]) { i += 1; }
            let word: str = substr(source, start, i - start);
            if n_is_keyword(word) { n_emit("KEYWORD", source, start, i, word); }
            else { n_emit("IDENT", source, start, i, word); }
            line_start = false;
            continue;
        }

        if n_is_digit(c) {
            i += 1;
            while i < n and (n_is_digit(source[i]) or
                             str_contains("abcdefABCDEFxXbB_.eE+-", source[i])) {
                // Stop a sign unless it directly follows an exponent marker.
                if (source[i] == "+" or source[i] == "-") and
                   i > start and source[i - 1] != "e" and source[i - 1] != "E" {
                    break;
                }
                i += 1;
            }
            let raw: str = substr(source, start, i - start);
            mut decoded: str = raw;
            if str_len(raw) >= 2 and raw[0] == "0" and
               (raw[1] == "x" or raw[1] == "X" or raw[1] == "b" or raw[1] == "B") {
                decoded = to_str(integer_value(raw));
            } else if str_contains(raw, ".") or str_contains(raw, "e") or str_contains(raw, "E") {
                decoded = f64_to_str(str_to_f64(strip_underscores(raw)));
            } else {
                decoded = to_str(integer_value(raw));
            }
            n_emit("NUMBER", source, start, i, decoded);
            line_start = false;
            continue;
        }

        if c == "\"" {
            i += 1;
            mut interpolation_depth: int = 0;
            while i < n and source[i] != "\"" {
                if source[i] == "\n" {
                    n_error(source, start, 202);
                    return 1;
                }
                if source[i] == "\\" {
                    if i + 1 >= n or not str_contains("ntr0\\\"'u", source[i + 1]) {
                        n_error(source, i, 203);
                        return 1;
                    }
                    if source[i + 1] == "u" {
                        if i + 5 >= n { n_error(source, i, 203); return 1; }
                        mut h: int = 0;
                        while h < 4 {
                            if not str_contains("0123456789abcdefABCDEF", source[i + 2 + h]) {
                                n_error(source, i, 203);
                                return 1;
                            }
                            h += 1;
                        }
                        i += 6;
                    } else { i += 2; }
                } else if i + 1 < n and source[i] == "{" and source[i + 1] == "{" {
                    i += 2;
                } else if i + 1 < n and source[i] == "}" and source[i + 1] == "}" {
                    i += 2;
                } else if source[i] == "{" {
                    interpolation_depth += 1;
                    if interpolation_depth > 128 { n_error(source, i, 210); return 1; }
                    i += 1;
                } else if source[i] == "}" and interpolation_depth > 0 {
                    interpolation_depth -= 1;
                    i += 1;
                } else {
                    i += 1;
                }
            }
            if i >= n { n_error(source, start, 202); return 1; }
            if interpolation_depth != 0 { n_error(source, start, 204); return 1; }
            i += 1;
            let decoded: str = escaped_value(decode_string(source, start, i));
            n_emit("STRING", source, start, i, decoded);
            line_start = false;
            continue;
        }

        if c == "(" { parens += 1; n_emit("PUNCT", source, i, i + 1, "("); i += 1; line_start = false; continue; }
        if c == ")" { if parens > 0 { parens -= 1; } else { n_error(source, i, 205); return 1; } n_emit("PUNCT", source, i, i + 1, ")"); i += 1; line_start = false; continue; }
        if c == "[" { brackets += 1; n_emit("PUNCT", source, i, i + 1, "["); i += 1; line_start = false; continue; }
        if c == "]" { if brackets > 0 { brackets -= 1; } else { n_error(source, i, 205); return 1; } n_emit("PUNCT", source, i, i + 1, "]"); i += 1; line_start = false; continue; }
        if c == "{" or c == "}" or c == "," or c == ":" or c == "." {
            n_emit("PUNCT", source, i, i + 1, c);
            i += 1;
            line_start = false;
            continue;
        }
        if str_contains("+-*/%=<>!&|^?~", c) {
            i += 1;
            if i < n and (source[i] == "=" or source[i] == c or
                          (c == "-" and source[i] == ">")) { i += 1; }
            n_emit("OPERATOR", source, start, i, substr(source, start, i - start));
            line_start = false;
            continue;
        }
        n_error(source, i, 206);
        return 1;
    }
    n_emit("EOF", source, n, n, "");
    return 0;
}

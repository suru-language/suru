// Relative module resolver and cycle gate for Natural Syntax.

func nms_dirname(path: str) -> str {
    mut i: int = str_len(path);
    while i > 0 {
        i -= 1;
        if path[i] == "/" {
            if i == 0 { return "/"; }
            return substr(path, 0, i);
        }
    }
    return ".";
}

func nms_join(directory: str, relative: str) -> str {
    if str_len(relative) > 0 and relative[0] == "/" { return relative; }
    if directory == "." { return relative; }
    return directory + "/" + relative;
}

func nms_find(text: str, needle: str, start: int) -> int {
    mut i: int = start;
    while i + str_len(needle) <= str_len(text) {
        if substr(text, i, str_len(needle)) == needle { return i; }
        i += 1;
    }
    return -1;
}

func nms_has(paths: [str], path: str) -> bool {
    mut i: int = 0;
    while i < array_len(paths) {
        if paths[i] == path { return true; }
        i += 1;
    }
    return false;
}

func nms_error(message: str) {
    println("module-error|" + message);
}

func nms_check_file(path: str, active: [str]) -> int {
    if nms_has(active, path) {
        nms_error("import cycle at '" + path + "'");
        return 1;
    }
    if file_exists(path) == false {
        nms_error("module not found '" + path + "'");
        return 1;
    }
    let source: str = read_file(path);
    let lines: [str] = str_split(source, "\n");
    let next_active: [str] = array_concat(active, [path]);
    mut i: int = 0;
    while i < array_len(lines) {
        let line: str = str_trim(lines[i]);
        i += 1;
        if str_len(line) < 5 or substr(line, 0, 5) != "bring" { continue; }
        let quote: int = nms_find(line, "\"", 0);
        let close: int = nms_find(line, "\"", quote + 1);
        if quote < 0 or close <= quote + 1 {
            nms_error("bring requires a module path");
            return 1;
        }
        let relative: str = substr(line, quote + 1, close - quote - 1);
        let imported: str = nms_join(nms_dirname(path), relative);
        if nms_check_file(imported, next_active) != 0 { return 1; }
    }
    return 0;
}

func natural_module_check(path: str) -> int {
    let active: [str] = [];
    return nms_check_file(path, active);
}

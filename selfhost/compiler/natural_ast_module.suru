// Module-level statement/control AST collection and Stage 1 typed-expression
// attachment. The original NAstNode/NAstModule API stays stable for the
// Natural frontend; expression nodes are kept in a flat triplet table.

use "natural_token_stream.suru";
use "natural_control_parser.suru";
use "natural_expression_ast.suru";
use "natural_ast.suru";

func nam_add_expression(text: str, state: [str]) -> [str] {
    if state[0] != "ok" { return state; }
    let source: str = str_trim(text);
    if source == "" or source == "Unit" { return state; }
    let initial_nodes: [str] = slice(state, 2, array_len(state));
    let parsed = nea_parse_expression(source, 0, 0, initial_nodes);
    if nea_is_ok(parsed) == false { return ["error", nea_message(parsed)]; }
    let end = natural_next(source, nea_next(parsed));
    if end.kind != NT_EOF {
        return ["error", "unexpected token after expression: " + end.text];
    }
    let old_roots: str = state[1];
    let root_text: str = to_str(nea_root(parsed));
    let roots: str = old_roots == "" ? root_text : old_roots + "," + root_text;
    return array_concat(["ok", roots], nea_nodes(parsed));
}

func nam_attach_expressions(node: NAstNode, state: [str]) -> [str] {
    mut attached: [str] = state;
    if node.kind == "binding" {
        let equals: int = na_find(node.text, " = ", 0);
        if equals >= 0 {
            attached = nam_add_expression(
                substr(node.text, equals + 3, str_len(node.text)), attached);
        }
    } else if node.kind == "assignment" {
        let to_at: int = na_find(node.text, " to ", 0);
        if to_at >= 0 {
            attached = nam_add_expression(substr(node.text, 0, to_at), attached);
            if attached[0] == "ok" {
                attached = nam_add_expression(
                    substr(node.text, to_at + 4, str_len(node.text)), attached);
            }
        }
    } else if node.kind == "show" or node.kind == "when" or
              node.kind == "choose" or node.kind == "case" or
              node.kind == "otherwise-when" or node.kind == "give" {
        attached = nam_add_expression(node.text, attached);
    } else if node.kind == "repeat" {
        if str_len(node.text) >= 6 and substr(node.text, 0, 6) == "while " {
            attached = nam_add_expression(
                substr(node.text, 6, str_len(node.text)), attached);
        }
    } else if node.kind == "each" {
        let across: int = na_find(node.text, " across ", 0);
        if across >= 0 {
            attached = nam_add_expression(
                substr(node.text, across + 8, str_len(node.text)), attached);
        } else {
            let from: int = na_find(node.text, " from ", 0);
            if from >= 0 {
                let range: str = substr(node.text, from + 6, str_len(node.text));
                let until: int = na_find(range, " until ", 0);
                let through: int = na_find(range, " through ", 0);
                let split: int = until >= 0 ? until : through;
                let width: int = until >= 0 ? 7 : 9;
                if split < 0 {
                    attached = ["error", "range iteration requires until/through"];
                } else {
                    attached = nam_add_expression(substr(range, 0, split), attached);
                    if attached[0] == "ok" {
                        attached = nam_add_expression(
                            substr(range, split + width, str_len(range)), attached);
                    }
                }
            }
        }
    }
    return attached;
}

func nam_parse(source: str) -> NAstModule {
    mut nodes: [NAstNode] = [];
    mut stack: [str] = [];
    mut position: int = 0;
    while true {
        let first = natural_next(source, position);
        if first.error {
            return NAstModule(nodes, "ast-error", first.line,
                              "lexical error " + to_str(first.error_code));
        }
        if first.kind == NT_EOF {
            if array_len(stack) > 0 {
                return NAstModule(nodes, "control-error", first.line,
                                  "unterminated " + stack[array_len(stack) - 1]);
            }
            return NAstModule(nodes, "", 0, "");
        }
        if first.kind == NT_NEWLINE {
            position = first.next;
            continue;
        }

        mut control: [str] = nac_fail(first.start, "unsupported control statement");
        let is_control: bool = first.text == "when" or first.text == "repeat" or
            first.text == "each" or first.text == "choose" or
            first.text == "otherwise" or first.text == "case" or first.text == "end";
        if first.text == "when" {
            control = nac_parse_when(source, first);
        } else if first.text == "repeat" {
            control = nac_parse_repeat(source, first);
        } else if first.text == "each" {
            control = nac_parse_each(source, first);
        } else if first.text == "choose" {
            control = nac_parse_choose(source, first);
        } else if first.text == "otherwise" or first.text == "case" {
            if array_len(stack) == 0 {
                return NAstModule(nodes, "control-error", first.line,
                                  "clause has no owning block");
            }
            control = nac_parse_clause(source, first, stack);
        } else if first.text == "end" {
            control = nac_parse_end(source, first, stack);
        }

        if is_control {
            if nac_is_ok(control) == false {
                return NAstModule(nodes, "control-error", first.line,
                                  nac_message(control));
            }
            nodes = array_concat(nodes, [na_from_rendered(nac_node(control))]);
            if nac_action(control) == "push" {
                stack = array_concat(stack, [nac_kind(control)]);
            } else if nac_action(control) == "pop" {
                stack = slice(stack, 0, array_len(stack) - 1);
            }
            position = nac_next(control);
            continue;
        }

        let statement = nas_statement(source, position);
        if nas_is_ok(statement) == false {
            return NAstModule(nodes, "ast-error", first.line, nas_message(statement));
        }
        nodes = array_concat(nodes, [na_from_rendered(nas_node(statement))]);
        position = nas_next(statement);
    }
    return NAstModule(nodes, "", 0, "");
}

func nam_join_roots(roots: str) -> str { return roots; }

func nam_check(source: str) -> int {
    let module: NAstModule = nam_parse(source);
    if module.error_kind != "" {
        println(module.error_kind + "|" + to_str(module.error_line) + "|" +
                module.error_message);
        return 1;
    }
    mut i: int = 0;
    while i < array_len(module.nodes) {
        println(na_render(module.nodes[i]));
        i += 1;
    }
    return 0;
}

func nam_check_typed(source: str) -> int {
    let module: NAstModule = nam_parse(source);
    if module.error_kind != "" {
        println(module.error_kind + "|" + to_str(module.error_line) + "|" +
                module.error_message);
        return 1;
    }
    mut expressions: [str] = [];
    mut i: int = 0;
    while i < array_len(module.nodes) {
        let node: NAstNode = module.nodes[i];
        let state: [str] = array_concat(["ok", ""], expressions);
        let attached: [str] = nam_attach_expressions(node, state);
        if attached[0] == "error" {
            println("expression-ast-error|" + to_str(node.line) + "|" + attached[1]);
            return 1;
        }
        println("typed-node|" + to_str(i) + "|" + node.kind + "|" +
                to_str(node.line) + "|" + nam_join_roots(attached[1]));
        expressions = slice(attached, 2, array_len(attached));
        i += 1;
    }
    i = 0;
    while i < array_len(expressions) / 3 {
        let base: int = i * 3;
        println("typed-expr|" + to_str(i) + "|" + expressions[base] + "|" +
                expressions[base + 1] + "|" + expressions[base + 2]);
        i += 1;
    }
    return 0;
}

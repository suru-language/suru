// Structural parser gate for Natural Syntax 2.0.
//
// This is deliberately the first parser increment: it validates the approved
// line/block model and clause ownership before expression, type, and AST
// parsing are ported. It does not alter legacy parsing.

use "source.suru";

func np_starts(line: str, prefix: str) -> bool {
    return str_len(line) >= str_len(prefix) and
           substr(line, 0, str_len(prefix)) == prefix;
}

func np_word(line: str) -> str {
    mut i: int = 0;
    while i < str_len(line) and line[i] != " " and line[i] != "\t" {
        i += 1;
    }
    return substr(line, 0, i);
}

func np_error(line: int, code: int, message: str) {
    println("parse-error|" + to_str(code) + "|" + to_str(line) +
            "|1|" + message);
}

func np_has(stack: [str], kind: str) -> bool {
    mut i: int = array_len(stack);
    while i > 0 {
        i -= 1;
        if stack[i] == kind { return true; }
    }
    return false;
}

func np_top(stack: [str]) -> str {
    if array_len(stack) == 0 { return ""; }
    return stack[array_len(stack) - 1];
}

func np_push(stack: [str], kind: str) -> [str] {
    return array_concat(stack, [kind]);
}

func np_pop(stack: [str]) -> [str] {
    return slice(stack, 0, array_len(stack) - 1);
}

func np_pop_bool(stack: [bool]) -> [bool] {
    return slice(stack, 0, array_len(stack) - 1);
}

func np_find_text(text: str, needle: str, start: int) -> int {
    mut i: int = start;
    while i + str_len(needle) <= str_len(text) {
        if substr(text, i, str_len(needle)) == needle { return i; }
        i += 1;
    }
    return -1;
}

func np_binding_name(line: str, word: str) -> str {
    let rest: str = str_trim(substr(line, str_len(word), str_len(line)));
    mut i: int = 0;
    while i < str_len(rest) and rest[i] != " " and rest[i] != ":" and
          rest[i] != "=" {
        i += 1;
    }
    return substr(rest, 0, i);
}

func np_assignment_target(line: str) -> str {
    let rest: str = str_trim(substr(line, 4, str_len(line)));
    let at: int = np_find_text(rest, " to ", 0);
    if at < 0 { return rest; }
    return str_trim(substr(rest, 0, at));
}

func np_signature_params_valid(line: str) -> bool {
    let open: int = np_find_text(line, "(", 0);
    let close: int = np_find_text(line, ")", open + 1);
    if open < 0 or close < 0 { return false; }
    let params: str = str_trim(substr(line, open + 1, close - open - 1));
    if params == "" { return true; }
    let parts: [str] = str_split(params, ",");
    mut i: int = 0;
    while i < array_len(parts) {
        if str_contains(parts[i], ":") == false { return false; }
        i += 1;
    }
    return true;
}

func np_routine_returned_value(line: str) -> bool {
    return str_contains(line, "->") and str_contains(line, "-> Unit") == false;
}

func np_open_kind(line: str) -> str {
    let word: str = np_word(line);
    if word == "expose" {
        let rest: str = str_trim(substr(line, str_len(word), str_len(line)));
        return np_open_kind(rest);
    }
    if word == "routine" { return "routine"; }
    if word == "record" { return "record"; }
    if word == "contract" { return "contract"; }
    if word == "choice" { return "choice"; }
    if word == "when" { return "when"; }
    if word == "each" { return "each"; }
    if word == "repeat" { return "repeat"; }
    if word == "attempt" { return "attempt"; }
    if word == "choose" { return "choose"; }
    return "";
}

func np_end_kind(line: str) -> str {
    if np_starts(line, "end ") == false { return ""; }
    return np_word(str_trim(substr(line, 4, str_len(line))));
}

func natural_parse_check(source: str) -> int {
    let lines: [str] = str_split(source, "\n");
    mut stack: [str] = [];
    mut routine_nonunit: [bool] = [];
    mut routine_has_give: [bool] = [];
    mut immutable_names: [str] = [];
    mut mutable_names: [str] = [];
    mut in_routine: int = 0;
    mut i: int = 0;

    while i < array_len(lines) {
        let line: str = str_trim(lines[i]);
        let number: int = i + 1;
        i += 1;
        if line == "" or np_starts(line, "//") or np_starts(line, "#!") {
            continue;
        }
        if np_starts(line, "/*") { continue; }

        let end_kind: str = np_end_kind(line);
        if end_kind != "" {
            if end_kind == "exception" {
                if np_top(stack) != "exception" {
                    np_error(number, 301, "mismatched end exception");
                    return 1;
                }
            } else if np_top(stack) != end_kind {
                np_error(number, 301, "mismatched block terminator");
                return 1;
            }
            if end_kind == "routine" {
                if routine_nonunit[array_len(routine_nonunit) - 1] and
                   routine_has_give[array_len(routine_has_give) - 1] == false {
                    np_error(number, 311, "non-Unit routine has no give");
                    return 1;
                }
                routine_nonunit = np_pop_bool(routine_nonunit);
                routine_has_give = np_pop_bool(routine_has_give);
                in_routine -= 1;
            }
            stack = np_pop(stack);
            continue;
        }

        let open_kind: str = np_open_kind(line);
        if open_kind != "" {
            // Contract members are signatures terminated by their line, not
            // nested routine bodies. Record methods and top-level routines do
            // open a routine block.
            if open_kind == "routine" and np_top(stack) == "contract" {
                if np_signature_params_valid(line) == false {
                    np_error(number, 308, "routine parameters require explicit types");
                    return 1;
                }
                continue;
            }
            if open_kind == "routine" {
                if np_signature_params_valid(line) == false {
                    np_error(number, 308, "routine parameters require explicit types");
                    return 1;
                }
                if np_starts(line, "expose ") and str_contains(line, "->") == false {
                    np_error(number, 309, "public routine requires an explicit return type");
                    return 1;
                }
                routine_nonunit = array_concat(routine_nonunit,
                                               [np_routine_returned_value(line)]);
                routine_has_give = array_concat(routine_has_give, [false]);
            }
            stack = np_push(stack, open_kind);
            if open_kind == "routine" { in_routine += 1; }
            continue;
        }

        if np_starts(line, "otherwise") {
            if np_top(stack) != "when" {
                np_error(number, 302, "otherwise has no owning when");
                return 1;
            }
            continue;
        }
        if np_starts(line, "case ") {
            if np_top(stack) != "choose" {
                np_error(number, 303, "case has no owning choose");
                return 1;
            }
            continue;
        }
        if np_starts(line, "handle ") or line == "ensure" {
            if np_top(stack) != "attempt" {
                np_error(number, 304, "exception clause has no owning attempt");
                return 1;
            }
            stack = np_push(stack, "exception");
            continue;
        }
        if np_starts(line, "give") and in_routine == 0 {
            np_error(number, 305, "give is outside a routine");
            return 1;
        }
        if np_starts(line, "give") and in_routine > 0 {
            routine_has_give[array_len(routine_has_give) - 1] = true;
            if line == "give" and routine_nonunit[array_len(routine_nonunit) - 1] {
                np_error(number, 310, "non-Unit routine requires a value");
                return 1;
            }
        }
        if np_starts(line, "value ") or np_starts(line, "change ") {
            let binding_word: str = np_word(line);
            if np_top(stack) == "record" and str_contains(line, "=") == false {
                let field: str = np_binding_name(line, binding_word);
                if binding_word == "change" {
                    mutable_names = array_concat(mutable_names, [field]);
                } else {
                    immutable_names = array_concat(immutable_names, [field]);
                }
                continue;
            }
            if str_contains(line, "=") == false {
                np_error(number, 307, "binding requires an initializer");
                return 1;
            }
            let binding: str = np_binding_name(line, binding_word);
            if binding == "" {
                np_error(number, 308, "binding requires a name");
                return 1;
            }
            if binding_word == "change" {
                mutable_names = array_concat(mutable_names, [binding]);
            } else {
                immutable_names = array_concat(immutable_names, [binding]);
            }
        }
        if np_starts(line, "constant ") {
            if in_routine > 0 {
                np_error(number, 312, "constant is module-scoped");
                return 1;
            }
            if str_contains(line, "=") == false {
                np_error(number, 307, "constant requires an initializer");
                return 1;
            }
        }
        if np_starts(line, "set ") and str_contains(line, " to ") == false {
            np_error(number, 306, "set requires 'to'");
            return 1;
        }
        if np_starts(line, "set ") {
            let target: str = np_assignment_target(line);
            mut simple_target: str = target;
            if np_starts(target, "this.") {
                simple_target = substr(target, 5, str_len(target));
            }
            if array_len(mutable_names) == 0 or
               str_contains(str_join(mutable_names, "|"), simple_target) == false {
                if str_contains(str_join(immutable_names, "|"), simple_target) {
                    np_error(number, 313, "assignment target is immutable");
                } else {
                    np_error(number, 314, "assignment target is not mutable");
                }
                return 1;
            }
        }
    }

    if array_len(stack) != 0 {
        np_error(array_len(lines), 307, "unterminated block");
        return 1;
    }
    return 0;
}

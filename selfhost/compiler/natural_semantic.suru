// Initial Natural Syntax semantic/type pass.
// Symbols are kept in parallel arrays until the full typed AST is available.

use "natural_statement_parser.suru";

func nss_lookup(names: [str], types: [str], name: str) -> str {
    mut i: int = 0;
    while i < array_len(names) {
        if names[i] == name { return types[i]; }
        i += 1;
    }
    return "";
}

func nss_mutable(names: [str], mutable: [bool], name: str) -> bool {
    mut i: int = 0;
    while i < array_len(names) {
        if names[i] == name { return mutable[i]; }
        i += 1;
    }
    return false;
}

func remove_at_str(items: [str], idx: int) -> [str] {
    mut out: [str] = [];
    mut i: int = 0;
    while i < array_len(items) {
        if i != idx { out = array_concat(out, [items[i]]); }
        i += 1;
    }
    return out;
}

func remove_at_bool(items: [bool], idx: int) -> [bool] {
    mut out: [bool] = [];
    mut i: int = 0;
    while i < array_len(items) {
        if i != idx { out = array_concat(out, [items[i]]); }
        i += 1;
    }
    return out;
}

func nss_find_index(items: [str], name: str) -> int {
    mut i: int = 0;
    while i < array_len(items) {
        if items[i] == name { return i; }
        i += 1;
    }
    return -1;
}

func nss_skip_nl(source: str, position: int) -> int {
    mut p: int = position;
    mut t = natural_next(source, p);
    while t.kind == NT_NEWLINE {
        p = t.next;
        t = natural_next(source, p);
    }
    return p;
}

func nss_has(names: [str], name: str) -> bool {
    mut i: int = 0;
    while i < array_len(names) {
        if names[i] == name { return true; }
        i += 1;
    }
    return false;
}

func nss_outer_wrapped(expression: str) -> bool {
    if str_len(expression) < 2 or expression[0] != "(" {
        return false;
    }
    mut depth: int = 0;
    mut i: int = 0;
    while i < str_len(expression) {
        if expression[i] == "(" { depth += 1; }
        if expression[i] == ")" {
            depth -= 1;
            if depth == 0 and i != str_len(expression) - 1 { return false; }
        }
        i += 1;
    }
    return depth == 0;
}

func nss_base_type(typ: str) -> str {
    let lt: int = nss_find(typ, "<");
    if lt < 0 { return typ; }
    return str_trim(substr(typ, 0, lt));
}

func nss_find(expression: str, needle: str) -> int {
    mut i: int = 0;
    while i + str_len(needle) <= str_len(expression) {
        if substr(expression, i, str_len(needle)) == needle { return i; }
        i += 1;
    }
    return -1;
}

func nss_find_top(expression: str, needle: str) -> int {
    mut depth: int = 0;
    mut i: int = 0;
    while i + str_len(needle) <= str_len(expression) {
        if expression[i] == "(" { depth += 1; }
        if expression[i] == ")" { depth -= 1; }
        if depth == 0 and substr(expression, i, str_len(needle)) == needle {
            return i;
        }
        i += 1;
    }
    return -1;
}

func nss_split_top_level(text: str, sep: str) -> [str] {
    mut parts: [str] = [];
    mut depth: int = 0;
    mut quote: bool = false;
    mut start: int = 0;
    mut i: int = 0;
    while i < str_len(text) {
        let c: str = text[i];
        if c == "\"" { quote = not quote; }
        if not quote {
            if c == "(" or c == "[" { depth += 1; }
            if c == ")" or c == "]" { depth -= 1; }
            if depth == 0 and c == sep {
                parts = array_concat(parts, [str_trim(substr(text, start, i - start))]);
                start = i + 1;
            }
        }
        i += 1;
    }
    parts = array_concat(parts, [str_trim(substr(text, start, str_len(text) - start))]);
    return parts;
}

func nss_find_colon_after(expression: str, from: int) -> int {
    mut depth: int = 0;
    mut i: int = from + 1;
    while i < str_len(expression) {
        if expression[i] == "(" { depth += 1; }
        if expression[i] == ")" { depth -= 1; }
        if depth == 0 and expression[i] == ":" { return i; }
        i += 1;
    }
    return -1;
}

func nss_split(expression: str) -> [str] {
    let wrapped: bool = nss_outer_wrapped(expression);
    mut inner: str = expression;
    if wrapped { inner = substr(expression, 1, str_len(expression) - 2); }

    let question: int = nss_find_top(inner, "?");
    if question >= 0 {
        let colon: int = nss_find_colon_after(inner, question);
        if colon >= 0 {
            return ["ternary",
                    str_trim(substr(inner, 0, question)),
                    str_trim(substr(inner, question + 1, colon - question - 1)),
                    str_trim(substr(inner, colon + 1, str_len(inner)))];
        }
    }

    let words: [str] = [" or ", " and "];
    mut w: int = 0;
    while w < array_len(words) {
        let at: int = nss_find_top(inner, words[w]);
        if at >= 0 {
            return ["binary", words[w], str_trim(substr(inner, 0, at)),
                    str_trim(substr(inner, at + str_len(words[w]), str_len(inner)))];
        }
        w += 1;
    }
    let operators: [str] = [" == ", " != ", " <= ", " >= ", " < ", " > ",
                             " << ", " >> ", " + ", " - ", " * ", " / ",
                             " % ", " | ", " ^ ", " & "];
    mut i: int = 0;
    while i < array_len(operators) {
        let at: int = nss_find_top(inner, operators[i]);
        if at >= 0 {
            return ["binary", str_trim(operators[i]), str_trim(substr(inner, 0, at)),
                    str_trim(substr(inner, at + str_len(operators[i]), str_len(inner)))];
        }
        i += 1;
    }
    if str_len(inner) >= 2 and inner[0] == "-" and inner[1] == " " {
        return ["unary", "-", str_trim(substr(inner, 2, str_len(inner)))];
    }
    if str_len(inner) >= 4 and substr(inner, 0, 4) == "not " {
        return ["unary", "not", str_trim(substr(inner, 4, str_len(inner)))];
    }
    if str_len(inner) >= 2 and inner[0] == "~" and inner[1] == " " {
        return ["unary", "~", str_trim(substr(inner, 2, str_len(inner)))];
    }
    return ["atom", inner];
}

func nss_builtin_type(name: str) -> str {
    if name == "str_len" { return "Whole"; }
    if name == "array_len" { return "Whole"; }
    if name == "substr" { return "Text"; }
    if name == "str_contains" { return "Bool"; }
    if name == "to_str" { return "Text"; }
    if name == "str_compare" { return "Whole"; }
    if name == "int_from_str" { return "Whole"; }
    if name == "abs" { return "Whole"; }
    if name == "str_lower" { return "Text"; }
    if name == "str_upper" { return "Text"; }
    if name == "str_trim" { return "Text"; }
    return "";
}

func nss_expr_type(expression: str, names: [str], types: [str],
                   rt_names: [str], rt_types: [str]) -> [str] {
    let trimmed: str = str_trim(expression);
    if str_len(trimmed) >= 8 and substr(trimmed, 0, 8) == "routine(" {
        return ["ok", "routine"];
    }
    let parts: [str] = nss_split(expression);
    if parts[0] == "ternary" {
        let condition: [str] = nss_expr_type(parts[1], names, types, rt_names, rt_types);
        if condition[0] == "error" { return condition; }
        if condition[1] != "Bool" { return ["error", "ternary condition requires Bool"]; }
        let then_type: [str] = nss_expr_type(parts[2], names, types, rt_names, rt_types);
        if then_type[0] == "error" { return then_type; }
        let else_type: [str] = nss_expr_type(parts[3], names, types, rt_names, rt_types);
        if else_type[0] == "error" { return else_type; }
        if then_type[1] != else_type[1] {
            return ["error", "ternary branches must have the same type"];
        }
        return ["ok", then_type[1]];
    }
    if parts[0] == "unary" {
        let operand: [str] = nss_expr_type(parts[2], names, types, rt_names, rt_types);
        if operand[0] == "error" { return operand; }
        if parts[1] == "not" {
            if operand[1] != "Bool" { return ["error", "not requires Bool"]; }
            return ["ok", "Bool"];
        }
        if parts[1] == "~" {
            if operand[1] != "Whole" { return ["error", "~ requires Whole"]; }
            return ["ok", "Whole"];
        }
        if operand[1] != "Whole" and operand[1] != "Real" {
            return ["error", "unary '-' requires a numeric value"];
        }
        return ["ok", operand[1]];
    }
    if parts[0] == "binary" {
        let left: [str] = nss_expr_type(parts[2], names, types, rt_names, rt_types);
        let right: [str] = nss_expr_type(parts[3], names, types, rt_names, rt_types);
        if left[0] == "error" { return left; }
        if right[0] == "error" { return right; }
        let op: str = parts[1];
        if op == " and " or op == " or " {
            if left[1] != "Bool" or right[1] != "Bool" {
                return ["error", "logical operators require Bool operands"];
            }
            return ["ok", "Bool"];
        }
        if op == "==" or op == "!=" or op == "<" or op == "<=" or
           op == ">" or op == ">=" {
            if left[1] != right[1] { return ["error", "comparison types do not match"]; }
            return ["ok", "Bool"];
        }
        if op == "+" and left[1] == "Text" and right[1] == "Text" {
            return ["ok", "Text"];
        }
        if (left[1] != "Whole" and left[1] != "Real") or
           (right[1] != "Whole" and right[1] != "Real") {
            return ["error", "arithmetic requires numeric operands"];
        }
        if left[1] == "Real" or right[1] == "Real" { return ["ok", "Real"]; }
        return ["ok", "Whole"];
    }
    let atom: str = parts[1];
    if atom == "true" or atom == "false" { return ["ok", "Bool"]; }
    if atom == "none" { return ["ok", "None"]; }
    if str_len(atom) >= 2 and atom[0] == "[" and atom[str_len(atom) - 1] == "]" {
        let inner: str = substr(atom, 1, str_len(atom) - 2);
        if inner == "" { return ["ok", "[]"]; }
        let elems: [str] = nss_split_top_level(inner, ",");
        let elem_type: [str] = nss_expr_type(elems[0], names, types, rt_names, rt_types);
        if elem_type[0] == "error" { return elem_type; }
        mut elem_idx: int = 1;
        while elem_idx < array_len(elems) {
            let et: [str] = nss_expr_type(elems[elem_idx], names, types, rt_names, rt_types);
            if et[0] == "error" { return et; }
            if et[1] != elem_type[1] { return ["error", "array elements must share a type"]; }
            elem_idx += 1;
        }
        return ["ok", "[" + elem_type[1] + "]"];
    }
    if str_len(atom) > 0 and atom[0] == "\"" { return ["ok", "Text"]; }
    if str_contains(atom, ".") or str_contains(atom, "e") or str_contains(atom, "E") {
        if str_len(atom) > 0 and atom[0] >= "0" and atom[0] <= "9" {
            return ["ok", "Real"];
        }
    }
    if str_len(atom) > 0 and atom[0] >= "0" and atom[0] <= "9" {
        return ["ok", "Whole"];
    }
    if str_len(atom) >= 2 and atom[str_len(atom) - 1] == ")" {
        let open_idx: int = nss_find(atom, "(");
        if open_idx > 0 {
            let ctor: str = str_trim(substr(atom, 0, open_idx));
            let ctor_type: str = nss_lookup(names, types, ctor);
            if ctor_type != "" {
                return ["ok", ctor_type];
            }
            let ridx: int = nss_find_index(rt_names, ctor);
            if ridx >= 0 {
                return ["ok", rt_types[ridx]];
            }
            if ctor == "Some" or ctor == "none" { return ["ok", "Option"]; }
            if ctor == "ok" or ctor == "error" { return ["ok", "Result"]; }
            let btype: str = nss_builtin_type(ctor);
            if btype != "" { return ["ok", btype]; }
        }
    }
    let dot: int = nss_find_top(atom, ".");
    if dot > 0 {
        let base: str = str_trim(substr(atom, 0, dot));
        let field: str = str_trim(substr(atom, dot + 1, str_len(atom)));
        let base_type: str = nss_lookup(names, types, base);
        if base_type != "" {
            let qualified: str = base_type + "." + field;
            let ftype: str = nss_lookup(names, types, qualified);
            if ftype != "" { return ["ok", ftype]; }
        }
        return ["error", "unknown field '" + atom + "'"];
    }
    let known: str = nss_lookup(names, types, atom);
    if known == "" { return ["error", "unknown name '" + atom + "'"]; }
    return ["ok", known];
}

func nss_error(line: int, message: str) {
    println("semantic-error|" + to_str(line) + "|" + message);
}

func nss_finish(source: str, position: int) -> int {
    let t = natural_next(source, position);
    if t.kind == NT_NEWLINE or t.kind == NT_EOF { return t.next; }
    return -1;
}

func nss_skip_statement(source: str, position: int) -> int {
    mut p: int = position;
    while true {
        let t = natural_next(source, p);
        if t.kind == NT_NEWLINE or t.kind == NT_EOF { return t.next; }
        p = t.next;
    }
    return p;
}

func nss_skip_routine(source: str, position: int) -> int {
    mut depth: int = 1;
    mut p: int = position;
    while true {
        let t = natural_next(source, p);
        if t.error or t.kind == NT_EOF { return -1; }
        if t.text == "routine" { depth += 1; }
        else if t.text == "end" {
            let k = natural_next(source, t.next);
            depth -= 1;
            if depth == 0 { return k.next; }
            p = k.next;
            continue;
        }
        p = t.next;
    }
    return -1;
}

func nss_skip_to_end(source: str, position: int, kind: str) -> int {
    mut p: int = position;
    while true {
        let t = natural_next(source, p);
        if t.error or t.kind == NT_EOF { return -1; }
        if t.text == "end" {
            let k = natural_next(source, t.next);
            if k.text == kind { return k.next; }
            p = k.next;
            continue;
        }
        p = t.next;
    }
    return -1;
}

func natural_semantic_check(source: str) -> int {
    mut names: [str] = [];
    mut types: [str] = [];
    mut mutable: [bool] = [];
    mut rec_names: [str] = [];
    mut choice_variants: [str] = [];
    mut choice_payload_types: [str] = [];
    mut current_choice: str = "";
    mut choose_bound: [[str]] = [];
    mut routine_bound: [[str]] = [];
    mut rt_names: [str] = [];
    mut rt_types: [str] = [];
    mut rec_fields: [[str]] = [];
    mut rec_ftypes: [[str]] = [];
    mut rec_mut: [[bool]] = [];
    mut position: int = 0;
    while true {
        let first = natural_next(source, position);
        if first.error { nss_error(first.line, "lexical error"); return 1; }
        if first.kind == NT_EOF { return 0; }
        if first.kind == NT_NEWLINE { position = first.next; continue; }

        if first.text == "record" {
            let rname = natural_next(source, first.next);
            if rname.kind != NT_IDENT { nss_error(first.line, "expected record name"); return 1; }
            if nss_has(names, rname.text) or nss_has(rec_names, rname.text) {
                nss_error(first.line, "duplicate declaration '" + rname.text + "'"); return 1;
            }
            rec_names = array_concat(rec_names, [rname.text]);
            mut fields: [str] = [];
            mut ftypes: [str] = [];
            mut muts: [bool] = [];
            mut pos: int = rname.next;
            let supports = natural_next(source, pos);
            if supports.text == "supports" {
                pos = nss_skip_statement(source, supports.next);
                if pos < 0 { nss_error(first.line, "expected record body"); return 1; }
            }
            mut closed: bool = false;
            while not closed {
                let t = natural_next(source, pos);
                if t.error { nss_error(first.line, "lexical error"); return 1; }
                if t.kind == NT_NEWLINE { pos = t.next; continue; }
                if t.kind == NT_EOF { nss_error(first.line, "unterminated record"); return 1; }
                if t.text == "end" {
                    let k = natural_next(source, t.next);
                    if k.text == "record" { pos = k.next; closed = true; continue; }
                    nss_error(first.line, "mismatched end in record"); return 1;
                }
                if t.text == "routine" {
                    let after = nss_skip_routine(source, t.next);
                    if after < 0 { nss_error(first.line, "unterminated record method"); return 1; }
                    pos = after;
                    continue;
                }
                mut f_mut: bool = false;
                mut field_tok = t;
                if t.text == "change" {
                    f_mut = true;
                    field_tok = natural_next(source, t.next);
                }
                 if field_tok.kind == NT_IDENT {
                    mut ftype: str = "Whole";
                    let colon_tok = natural_next(source, field_tok.next);
                    if colon_tok.text == ":" {
                        let type_tok = natural_next(source, colon_tok.next);
                        if type_tok.kind == NT_IDENT or type_tok.kind == NT_WORD {
                            ftype = type_tok.text;
                        }
                    }
                    fields = array_concat(fields, [field_tok.text]);
                    ftypes = array_concat(ftypes, [ftype]);
                    muts = array_concat(muts, [f_mut]);
                    pos = nss_skip_statement(source, field_tok.next);
                    continue;
                }
                nss_error(first.line, "invalid record member"); return 1;
            }
            rec_fields = array_concat(rec_fields, [fields]);
            rec_ftypes = array_concat(rec_ftypes, [ftypes]);
            rec_mut = array_concat(rec_mut, [muts]);
            mut fi2: int = 0;
            while fi2 < array_len(fields) {
                names = array_concat(names, [rname.text + "." + fields[fi2]]);
                types = array_concat(types, [ftypes[fi2]]);
                fi2 += 1;
            }
            position = pos;
            continue;
        }

        if first.text == "expose" {
            position = first.next;
            continue;
        }
        if first.text == "bring" {
            position = nss_skip_statement(source, first.next);
            if position < 0 { nss_error(first.line, "expected bring declaration"); return 1; }
            continue;
        }
        if first.text == "routine" {
            let rname = natural_next(source, first.next);
            if rname.kind != NT_IDENT { nss_error(first.line, "expected routine name"); return 1; }
            let empty_rscope: [str] = [];
            routine_bound = array_concat(routine_bound, [empty_rscope]);
            let lp = natural_next(source, rname.next);
            if lp.text != "(" { nss_error(first.line, "expected '(' in routine"); return 1; }
            mut p: int = lp.next;
            let rp = natural_next(source, p);
            if rp.text != ")" {
                while true {
                    let pname = natural_next(source, p);
                    if pname.kind != NT_IDENT { nss_error(first.line, "expected parameter name"); return 1; }
                    let colon = natural_next(source, pname.next);
                    if colon.text != ":" { nss_error(first.line, "parameter requires explicit type"); return 1; }
                    let typ = nas_parse_type(source, colon.next);
                    if typ[0] != "ok" { nss_error(first.line, typ[2]); return 1; }
                    names = array_concat(names, [pname.text]);
                    types = array_concat(types, [typ[2]]);
                    mutable = array_concat(mutable, [false]);
                    let rbl: [str] = routine_bound[array_len(routine_bound) - 1];
                    routine_bound[array_len(routine_bound) - 1] =
                        array_concat(rbl, [pname.text]);
                    p = int_from_str(typ[1]);
                    let sep = natural_next(source, p);
                    if sep.text == "," { p = sep.next; continue; }
                    if sep.text == ")" { p = sep.next; break; }
                    nss_error(first.line, "expected ',' or ')' in parameters"); return 1;
                }
            } else {
                p = rp.next;
            }
            let arrow_pos: int = nss_skip_nl(source, p);
            let arrow = natural_next(source, arrow_pos);
            if arrow.text == "->" {
                let rt = nas_parse_type(source, arrow.next);
                if rt[0] != "ok" { nss_error(first.line, rt[2]); return 1; }
                rt_names = array_concat(rt_names, [rname.text]);
                rt_types = array_concat(rt_types, [rt[2]]);
                p = int_from_str(rt[1]);
            }
            position = nss_skip_statement(source, p);
            if position < 0 { nss_error(first.line, "expected routine body"); return 1; }
            continue;
        }
        if first.text == "choice" {
            let cname = natural_next(source, first.next);
            mut cpos: int = cname.next;
            while true {
                let ct = natural_next(source, cpos);
                if ct.error { nss_error(first.line, "lexical error"); return 1; }
                if ct.kind == NT_EOF { nss_error(first.line, "unterminated choice"); return 1; }
                if ct.text == "end" {
                    let ck = natural_next(source, ct.next);
                    if ck.text == "choice" { position = ck.next; break; }
                }
                if ct.kind == NT_IDENT {
                    let vt = natural_next(source, ct.next);
                    let vname: str = ct.text;
                    mut vtype: str = "Whole";
                    if vt.text == "(" {
                        let pname_t = natural_next(source, vt.next);
                        let pcolon = natural_next(source, pname_t.next);
                        mut pend: int = pcolon.next;
                        if pcolon.text == ":" {
                            let ptype_t = natural_next(source, pcolon.next);
                            vtype = ptype_t.text;
                            pend = ptype_t.next;
                        }
                        cpos = pend;
                    } else {
                        cpos = vt.next;
                    }
                    choice_variants = array_concat(choice_variants,
                        [cname.text + "." + vname]);
                    choice_payload_types = array_concat(choice_payload_types, [vtype]);
                    names = array_concat(names, [vname]);
                    types = array_concat(types, [cname.text]);
                    mutable = array_concat(mutable, [false]);
                    continue;
                }
                cpos = ct.next;
            }
            continue;
        }
        if first.text == "contract" {
            let cname = natural_next(source, first.next);
            let end = nss_skip_to_end(source, cname.next, first.text);
            if end < 0 { nss_error(first.line, "unterminated " + first.text); return 1; }
            position = end;
            continue;
        }
        if first.text == "attempt" {
            let end = nss_skip_to_end(source, first.next, "attempt");
            if end < 0 { nss_error(first.line, "unterminated attempt"); return 1; }
            position = end;
            continue;
        }

        if first.text == "value" or first.text == "change" or first.text == "constant" {
            let name = natural_next(source, first.next);
            if name.kind != NT_IDENT { nss_error(first.line, "expected binding name"); return 1; }
            if nss_has(names, name.text) { nss_error(first.line, "duplicate binding '" + name.text + "'"); return 1; }
            mut declared: str = "";
            mut after_name: int = name.next;
            let colon = natural_next(source, after_name);
            if colon.text == ":" {
                let typ = nas_parse_type(source, colon.next);
                if typ[0] != "ok" { nss_error(first.line, typ[2]); return 1; }
                declared = typ[2];
                after_name = int_from_str(typ[1]);
            }
            let equals = natural_next(source, after_name);
            if equals.text != "=" { nss_error(first.line, "binding requires an initializer"); return 1; }
            let expression = ne_parse_expression(source, equals.next, 0);
            if ne_is_ok(expression) == false { nss_error(first.line, ne_message(expression)); return 1; }
            let inferred = nss_expr_type(ne_value(expression), names, types, rt_names, rt_types);
            if inferred[0] == "error" { nss_error(first.line, inferred[1]); return 1; }
            let declared_base: str = nss_base_type(declared);
            let inferred_base: str = nss_base_type(inferred[1]);
            if declared != "" and declared_base != inferred_base and inferred_base != "None" {
                nss_error(first.line, "initializer type " + inferred[1] + " does not match " + declared);
                return 1;
            }
            let final_type: str = declared == "" ? inferred[1] : declared;
            names = array_concat(names, [name.text]);
            types = array_concat(types, [final_type]);
            mutable = array_concat(mutable, [first.text == "change"]);
            position = nss_finish(source, ne_next(expression));
            if position < 0 { nss_error(first.line, "expected statement terminator"); return 1; }
            continue;
        }

        if first.text == "set" {
            let target = ne_parse_expression(source, first.next, 0);
            if ne_is_ok(target) == false { nss_error(first.line, ne_message(target)); return 1; }
            let target_name: str = ne_value(target);
            let to_word = natural_next(source, ne_next(target));
            if to_word.text != "to" { nss_error(first.line, "set requires 'to'"); return 1; }
            let dot: int = nss_find_top(target_name, ".");
            if dot >= 0 {
                let base: str = str_trim(substr(target_name, 0, dot));
                let field: str = str_trim(substr(target_name, dot + 1, str_len(target_name)));
                let base_type: str = nss_lookup(names, types, base);
                if base_type == "" { nss_error(first.line, "unknown assignment target '" + base + "'"); return 1; }
                let ri: int = nss_find_index(rec_names, base_type);
                if ri < 0 { nss_error(first.line, "assignment target is not a record"); return 1; }
                let fi: int = nss_find_index(rec_fields[ri], field);
                if fi < 0 { nss_error(first.line, "unknown field '" + field + "'"); return 1; }
                if rec_mut[ri][fi] == false {
                    nss_error(first.line, "assignment target is immutable"); return 1;
                }
                let expression = ne_parse_expression(source, to_word.next, 0);
                if ne_is_ok(expression) == false { nss_error(first.line, ne_message(expression)); return 1; }
                let value_type = nss_expr_type(ne_value(expression), names, types, rt_names, rt_types);
                if value_type[0] == "error" { nss_error(first.line, value_type[1]); return 1; }
                position = nss_finish(source, ne_next(expression));
                if position < 0 { nss_error(first.line, "expected statement terminator"); return 1; }
                continue;
            }
            let target_type: str = nss_lookup(names, types, target_name);
            if target_type == "" { nss_error(first.line, "unknown assignment target '" + target_name + "'"); return 1; }
            if nss_mutable(names, mutable, target_name) == false {
                nss_error(first.line, "assignment target is immutable"); return 1;
            }
            let expression = ne_parse_expression(source, to_word.next, 0);
            if ne_is_ok(expression) == false { nss_error(first.line, ne_message(expression)); return 1; }
            let value_type = nss_expr_type(ne_value(expression), names, types, rt_names, rt_types);
            if value_type[0] == "error" { nss_error(first.line, value_type[1]); return 1; }
            if value_type[1] != target_type { nss_error(first.line, "assignment type does not match target"); return 1; }
            position = nss_finish(source, ne_next(expression));
            if position < 0 { nss_error(first.line, "expected statement terminator"); return 1; }
            continue;
        }

        if first.text == "give" {
            let nxt = natural_next(source, first.next);
            if nxt.kind != NT_NEWLINE and nxt.kind != NT_EOF {
                let e = ne_parse_expression(source, first.next, 0);
                if ne_is_ok(e) == false { nss_error(first.line, ne_message(e)); return 1; }
                let et = nss_expr_type(ne_value(e), names, types, rt_names, rt_types);
                if et[0] == "error" { nss_error(first.line, et[1]); return 1; }
                position = nss_finish(source, ne_next(e));
            } else {
                position = nss_finish(source, first.next);
            }
            if position < 0 { nss_error(first.line, "expected statement terminator"); return 1; }
            continue;
        }

        if first.text == "when" or first.text == "repeat" {
            mut expression_position: int = first.next;
            if first.text == "repeat" {
                let while_word = natural_next(source, expression_position);
                if while_word.text != "while" { nss_error(first.line, "repeat requires 'while'"); return 1; }
                expression_position = while_word.next;
            }
            let expression = ne_parse_expression(source, expression_position, 0);
            if ne_is_ok(expression) == false { nss_error(first.line, ne_message(expression)); return 1; }
            let condition = nss_expr_type(ne_value(expression), names, types, rt_names, rt_types);
            if condition[0] == "error" { nss_error(first.line, condition[1]); return 1; }
            if condition[1] != "Bool" { nss_error(first.line, "condition requires Bool"); return 1; }
            position = nss_finish(source, ne_next(expression));
            if position < 0 { nss_error(first.line, "expected statement terminator"); return 1; }
            continue;
        }

        if first.text == "case" {
            let crest = natural_next(source, first.next);
            if crest.kind == NT_IDENT {
                let variant_name: str = crest.text;
                let after_v = natural_next(source, crest.next);
                if after_v.text == "(" {
                    let pname = natural_next(source, after_v.next);
                    if pname.kind == NT_IDENT and nss_has(names, pname.text) == false {
                        mut vtype: str = "Whole";
                        let vi: int = nss_find_index(choice_variants,
                            current_choice + "." + variant_name);
                        if vi >= 0 { vtype = choice_payload_types[vi]; }
                        names = array_concat(names, [pname.text]);
                        types = array_concat(types, [vtype]);
                        mutable = array_concat(mutable, [true]);
                        if array_len(choose_bound) > 0 {
                            let tbl: [str] = choose_bound[array_len(choose_bound) - 1];
                            choose_bound[array_len(choose_bound) - 1] =
                                array_concat(tbl, [pname.text]);
                        }
                    }
                    let pre = natural_next(source, pname.next);
                    position = pre.next;
                } else {
                    position = after_v.next;
                }
            } else {
                position = nss_skip_statement(source, first.next);
            }
            continue;
        }
        if first.text == "choose" {
            let csel = natural_next(source, first.next);
            if csel.kind == NT_IDENT {
                let resolved: str = nss_lookup(names, types, csel.text);
                current_choice = resolved == "" ? csel.text : resolved;
            }
            let empty_strs: [str] = [];
            choose_bound = array_concat(choose_bound, [empty_strs]);
            position = nss_skip_statement(source, first.next);
            continue;
        }
        if first.text == "end" {
            let end_kind = natural_next(source, first.next);
            mut pop_bound: [str] = [];
            mut pop_stack: [[str]] = [];
            if end_kind.text == "choose" {
                pop_stack = choose_bound;
            } else if end_kind.text == "routine" {
                pop_stack = routine_bound;
            }
            if array_len(pop_stack) > 0 {
                pop_bound = pop_stack[array_len(pop_stack) - 1];
                mut bi: int = 0;
                while bi < array_len(pop_bound) {
                    let bname: str = pop_bound[bi];
                    let idx: int = nss_find_index(names, bname);
                    if idx >= 0 {
                        names = remove_at_str(names, idx);
                        types = remove_at_str(types, idx);
                        mutable = remove_at_bool(mutable, idx);
                    }
                    bi += 1;
                }
                if end_kind.text == "choose" {
                    choose_bound = slice(choose_bound, 0, array_len(choose_bound) - 1);
                } else {
                    routine_bound = slice(routine_bound, 0, array_len(routine_bound) - 1);
                }
            }
            position = end_kind.next;
            continue;
        }
        if first.text == "otherwise" or first.text == "each" {
            position = nss_skip_statement(source, first.next);
            continue;
        }

        let statement = nas_statement(source, position);
        if nas_is_ok(statement) == false {
            nss_error(first.line, nas_message(statement));
            return 1;
        }
        position = nas_next(statement);
    }
    return 0;
}

// Typed exception propagation gate for Natural Syntax.
// Effects are collected from routine signatures, then checked at call sites.

use "natural_declaration_semantic.suru";

func nes_effects(line: str) -> str {
    let at: int = nds_find(line, " throws ", 0);
    if at < 0 { return ""; }
    return str_trim(substr(line, at + 8, str_len(line)));
}

func nes_contains_effect(list: str, effect: str) -> bool {
    if list == "" { return false; }
    return str_contains("," + list + ",", "," + effect + ",");
}

func nes_has_call(line: str, routine: str) -> bool {
    return str_contains(line, routine + "(");
}

func nes_future_handles(lines: [str], start: int, effect: str) -> bool {
    mut i: int = start;
    while i < array_len(lines) {
        let line: str = str_trim(lines[i]);
        if line == "end attempt" { return false; }
        if nds_word(line) == "handle" {
            let colon: int = nds_find(line, ":", 0);
            if colon >= 0 and str_trim(substr(line, colon + 1, str_len(line))) == effect {
                return true;
            }
        }
        i += 1;
    }
    return false;
}

func nes_error(line: int, message: str) {
    println("effect-error|" + to_str(line) + "|" + message);
}

func natural_effect_check(source: str) -> int {
    let lines: [str] = str_split(source, "\n");
    mut routine_names: [str] = [];
    mut routine_effects: [str] = [];
    mut i: int = 0;

    // Declaration pass: establish the effect signature of every routine.
    while i < array_len(lines) {
    let line: str = str_trim(lines[i]);
        i += 1;
        let open: str = nds_open_word(line);
        if open == "routine" {
            let name: str = nds_open_name(line, "routine");
            if name != "" {
                routine_names = array_concat(routine_names, [name]);
                routine_effects = array_concat(routine_effects, [nes_effects(line)]);
            }
        }
    }

    mut active_routines: [str] = [];
    mut active_effects: [str] = [];
    mut handled: [str] = [];
    i = 0;
    while i < array_len(lines) {
        let raw: str = str_trim(lines[i]);
        let line: int = i + 1;
        i += 1;
        if raw == "" or nds_word(raw) == "//" or nds_word(raw) == "#!" { continue; }

        let open: str = nds_open_word(raw);
        if open == "routine" {
            let name: str = nds_open_name(raw, "routine");
            mut effects: str = "";
            mut r: int = 0;
            while r < array_len(routine_names) {
                if routine_names[r] == name { effects = routine_effects[r]; }
                r += 1;
            }
            active_routines = array_concat(active_routines, [name]);
            active_effects = array_concat(active_effects, [effects]);
            continue;
        }
        if raw == "end routine" {
            if array_len(active_routines) > 0 {
                active_routines = slice(active_routines, 0, array_len(active_routines) - 1);
                active_effects = slice(active_effects, 0, array_len(active_effects) - 1);
            }
            continue;
        }
        if raw == "attempt" {
            handled = array_concat(handled, [""]);
            continue;
        }
        if nds_word(raw) == "handle" {
            if array_len(handled) == 0 {
                nes_error(line, "handle has no owning attempt"); return 1;
            }
            let colon: int = nds_find(raw, ":", 0);
            if colon < 0 { nes_error(line, "handle requires an exception type"); return 1; }
            let rest: str = str_trim(substr(raw, colon + 1, str_len(raw)));
            handled[array_len(handled) - 1] = rest;
            continue;
        }
        if raw == "ensure" {
            if array_len(handled) == 0 {
                nes_error(line, "ensure has no owning attempt"); return 1;
            }
            continue;
        }
        if raw == "end exception" { continue; }
        if raw == "end attempt" {
            if array_len(handled) == 0 {
                nes_error(line, "mismatched end attempt"); return 1;
            }
            handled = slice(handled, 0, array_len(handled) - 1);
            continue;
        }
        if array_len(active_routines) == 0 { continue; }

        mut r: int = 0;
        while r < array_len(routine_names) {
            if nes_has_call(raw, routine_names[r]) {
                let effects: str = routine_effects[r];
                let effect_parts: [str] = str_split(effects, ",");
                mut e: int = 0;
                while e < array_len(effect_parts) {
                    let effect: str = str_trim(effect_parts[e]);
                    if effect != "" and
                       nes_contains_effect(active_effects[array_len(active_effects) - 1], effect) == false {
                        mut caught: bool = false;
                        mut h: int = array_len(handled);
                        while h > 0 {
                            h -= 1;
                            if nes_contains_effect(handled[h], effect) { caught = true; }
                        }
                        if caught == false and nes_future_handles(lines, i, effect) == false {
                            nes_error(line, "undeclared propagation of " + effect +
                                      " from '" + routine_names[r] + "'");
                            return 1;
                        }
                    }
                    e += 1;
                }
            }
            r += 1;
        }
    }
    return 0;
}

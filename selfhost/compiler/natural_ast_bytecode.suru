// Module-AST-driven Stage 1 bytecode collector.
// Supports typed routines, bindings, assignments, show/give, control flow,
// each array/range loops, and indexed array stores.
// The legacy source collector remains the reference for other constructs.
use "natural_ast_module.suru";
use "natural_bytecode.suru";
use "natural_expression_types.suru";

func nab_fail(message: str) -> [str] {
    println("ast-bytecode-error|" + message);
    return ["#emit-failed"];
}

func nab_binding_parts(text: str) -> [str] {
    let equals: int = nam_find(text, " = ", 0);
    let first_space: int = nam_find(text, " ", 0);
    if equals < 0 or first_space < 0 { return ["", "", ""]; }
    let colon: int = nam_find(text, ":", first_space + 1);
    let name_end: int = colon >= 0 ? colon : equals;
    let name: str = str_trim(substr(text, first_space + 1,
                                    name_end - first_space - 1));
    let declared: str = colon < 0 ? "" :
        str_trim(substr(text, colon + 1, equals - colon - 1));
    return [name, declared, substr(text, equals + 3, str_len(text))];
}

func nab_collect_ast(source: str) -> [str] {
    let module: [str] = nam_parse(source);
    if module[0] == "error" {
        println("ast-bytecode-error|" + module[1] + "|" + module[2] + "|" + module[3]);
        return ["#emit-failed"];
    }
    let lines: [str] = str_split(source, "\n");
    mut instructions: [str] = [];
    instructions = nbc_collect_functions(instructions, lines);
    instructions = nbc_collect_records(instructions, lines);
    instructions = nbc_collect_choices(instructions, lines);

    mut expressions: [str] = [];
    mut names: [str] = [];
    mut types: [str] = [];
    let field_names: [str] = [];
    let field_types: [str] = [];
    mut current_function: str = "";
    mut return_type: str = "";
    mut returned: bool = false;
    mut controls: [str] = [""];
    mut next_label: int = 0;
    mut i: int = 1;
    while i < array_len(module) {
        let raw: str = module[i];
        let kind: str = nam_node_kind(raw);
        let line: int = nam_node_line(raw);
        let text: str = nam_node_text(raw);

        if kind == "routine" {
            if current_function != "" {
                return nab_fail("nested routine boundary at line " + to_str(line));
            }
            let signature: [str] = str_split(text, "|");
            if array_len(signature) < 3 { return nab_fail("malformed routine AST"); }
            current_function = signature[0];
            return_type = signature[2];
            returned = false;
            controls = [""];
            names = slice(names, array_len(names), 0);
            types = slice(types, array_len(types), 0);
            expressions = slice(expressions, array_len(expressions), 0);
            let params: [str] = signature[1] == "" ?
                slice(signature, array_len(signature), 0) : str_split(signature[1], ",");
            instructions = array_concat(instructions,
                ["#funcbody|" + current_function + "|" + to_str(array_len(params))]);
            mut p: int = 0;
            while p < array_len(params) {
                let colon: int = nbc_find(params[p], ":");
                if colon < 1 { return nab_fail("invalid parameter in " + current_function); }
                let pname: str = str_trim(substr(params[p], 0, colon));
                let ptype: str = str_trim(substr(params[p], colon + 1, str_len(params[p])));
                if pname == "" or ptype == "" { return nab_fail("invalid parameter in " + current_function); }
                if nbc_slot(instructions, pname) >= 0 {
                    return nab_fail("duplicate parameter '" + pname + "'");
                }
                instructions = nbc_bind(instructions, pname);
                instructions = nbc_note_type(instructions, pname, ptype);
                names = array_concat(names, [pname]);
                types = array_concat(types, [ptype]);
                p += 1;
            }
            i += 1;
            continue;
        }

        if kind == "end-routine" {
            if current_function == "" { return nab_fail("end routine without routine"); }
            if array_len(controls) != 1 {
                return nab_fail("unterminated control block in '" + current_function + "'");
            }
            if return_type != "Unit" and not returned {
                return nab_fail("non-Unit routine '" + current_function + "' has no give");
            }
            // Match the reference collector's explicit end-routine terminator;
            // after a non-Unit give this is unreachable but bytecode-stable.
            instructions = nbc_emit(instructions, "BC_RET_UNIT", "");
            current_function = "";
            return_type = "";
            returned = false;
            controls = [""];
            names = slice(names, array_len(names), 0);
            types = slice(types, array_len(types), 0);
            expressions = slice(expressions, array_len(expressions), 0);
            i += 1;
            continue;
        }

        if current_function == "" {
            return nab_fail("statement outside routine at line " + to_str(line));
        }

        let state: [str] = array_concat(["ok", ""], expressions);
        let attached: [str] = nam_attach_expressions(kind, text, state);
        if attached[0] == "error" { return nab_fail(attached[1]); }
        let roots: [int] = net_children(attached[1]);
        let nodes: [str] = slice(attached, 2, array_len(attached));

        if kind == "binding" {
            if array_len(roots) != 1 { return nab_fail("binding requires one initializer"); }
            let parts: [str] = nab_binding_parts(text);
            if parts[0] == "" { return nab_fail("malformed binding at line " + to_str(line)); }
            let inferred: [str] = net_infer(nodes, roots[0], names, types,
                                            field_names, field_types);
            if inferred[0] == "error" { return nab_fail(inferred[1]); }
            if parts[1] != "" and parts[1] != inferred[1] {
                return nab_fail("binding '" + parts[0] + "' expected " +
                                parts[1] + ", got " + inferred[1]);
            }
            if nbc_slot(instructions, parts[0]) >= 0 {
                return nab_fail("duplicate local '" + parts[0] + "'");
            }
            instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
            instructions = nbc_bind(instructions, parts[0]);
            instructions = nbc_note_type(instructions, parts[0],
                                          parts[1] == "" ? inferred[1] : parts[1]);
            instructions = nbc_emit(instructions, "BC_ST_LOCAL",
                                    to_str(nbc_slot(instructions, parts[0])));
            names = array_concat(names, [parts[0]]);
            types = array_concat(types, [parts[1] == "" ? inferred[1] : parts[1]]);
        } else if kind == "assignment" {
            if array_len(roots) != 2 { return nab_fail("assignment requires target and value"); }
            let target_kind: str = nbc_ast_kind(nodes, roots[0]);
            let left: [str] = net_infer(nodes, roots[0], names, types, field_names, field_types);
            let right: [str] = net_infer(nodes, roots[1], names, types, field_names, field_types);
            if left[0] == "error" { return nab_fail(left[1]); }
            if right[0] == "error" { return nab_fail(right[1]); }
            if net_common_type(left[1], right[1]) == "" {
                return nab_fail("assignment type mismatch");
            }
            if target_kind == "atom" {
                let target: str = nbc_ast_value(nodes, roots[0]);
                let slot: int = nbc_slot(instructions, target);
                if slot < 0 { return nab_fail("unknown local assignment target '" + target + "'"); }
                instructions = nbc_emit_ast_node(instructions, nodes, roots[1]);
                instructions = nbc_emit(instructions, "BC_ST_LOCAL", to_str(slot));
            } else if target_kind == "index" {
                let target_children: [int] = nbc_ast_children(nodes, roots[0]);
                if array_len(target_children) != 2 {
                    return nab_fail("invalid indexed assignment target");
                }
                let array_type: [str] = net_infer(nodes, target_children[0], names, types,
                                                  field_names, field_types);
                let index_type: [str] = net_infer(nodes, target_children[1], names, types,
                                                  field_names, field_types);
                if array_type[0] == "error" { return nab_fail(array_type[1]); }
                if index_type[0] == "error" { return nab_fail(index_type[1]); }
                if not net_is_array(array_type[1]) or index_type[1] != "Whole" {
                    return nab_fail("indexed assignment requires Array and Whole index");
                }
                instructions = nbc_emit_ast_node(instructions, nodes, target_children[0]);
                instructions = nbc_emit_ast_node(instructions, nodes, target_children[1]);
                instructions = nbc_emit_ast_node(instructions, nodes, roots[1]);
                instructions = nbc_emit(instructions, "BC_IDX_ST", "");
            } else {
                return nab_fail("AST bytecode slice does not yet lower this assignment target");
            }
        } else if kind == "show" {
            if array_len(roots) != 1 { return nab_fail("show requires one expression"); }
            instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
            instructions = nbc_emit(instructions, "BC_BUILTIN", "1");
            instructions = nbc_emit(instructions, "BC_POP", "");
        } else if kind == "when" {
            if array_len(roots) != 1 {
                return nab_fail("when requires one condition expression");
            }
            let condition: [str] = net_infer(nodes, roots[0], names, types,
                                             field_names, field_types);
            if condition[0] == "error" { return nab_fail(condition[1]); }
            if condition[1] != "Bool" {
                return nab_fail("when condition must be Bool, got " + condition[1]);
            }
            let finish: str = "ast-when-end-" + to_str(next_label);
            let next: str = "ast-when-next-" + to_str(next_label);
            next_label += 1;
            instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
            instructions = nbc_emit(instructions, "BC_JZ", "@" + next);
            controls = array_concat(controls,
                ["when|" + finish + "|" + next + "|0"]);
        } else if kind == "otherwise-when" {
            if array_len(controls) <= 1 {
                return nab_fail("otherwise when without an open when");
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if current[0] != "when" or current[3] == "2" {
                return nab_fail("otherwise when has no active when clause");
            }
            if array_len(roots) != 1 {
                return nab_fail("otherwise when requires one condition expression");
            }
            let condition: [str] = net_infer(nodes, roots[0], names, types,
                                             field_names, field_types);
            if condition[0] == "error" { return nab_fail(condition[1]); }
            if condition[1] != "Bool" {
                return nab_fail("otherwise when condition must be Bool, got " + condition[1]);
            }
            let next: str = "ast-when-next-" + to_str(next_label);
            next_label += 1;
            instructions = nbc_emit(instructions, "BC_JMP", "@" + current[1]);
            instructions = nbc_label(instructions, current[2]);
            instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
            instructions = nbc_emit(instructions, "BC_JZ", "@" + next);
            controls[array_len(controls) - 1] =
                "when|" + current[1] + "|" + next + "|1";
        } else if kind == "otherwise" {
            if array_len(controls) <= 1 {
                return nab_fail("otherwise without an open when");
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if current[0] != "when" or current[3] == "2" {
                return nab_fail("otherwise has no active when clause");
            }
            instructions = nbc_emit(instructions, "BC_JMP", "@" + current[1]);
            instructions = nbc_label(instructions, current[2]);
            controls[array_len(controls) - 1] =
                "when|" + current[1] + "||2";
        } else if kind == "end-when" {
            if array_len(controls) <= 1 {
                return nab_fail("end when without an open when");
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if current[0] != "when" {
                return nab_fail("mismatched when terminator");
            }
            if current[3] != "2" {
                instructions = nbc_label(instructions, current[2]);
            }
            instructions = nbc_label(instructions, current[1]);
            controls = slice(controls, 0, array_len(controls) - 1);
        } else if kind == "repeat" {
            if array_len(roots) != 1 {
                return nab_fail("repeat while requires one condition expression");
            }
            let condition: [str] = net_infer(nodes, roots[0], names, types,
                                             field_names, field_types);
            if condition[0] == "error" { return nab_fail(condition[1]); }
            if condition[1] != "Bool" {
                return nab_fail("repeat while condition must be Bool, got " + condition[1]);
            }
            let start: str = "ast-repeat-start-" + to_str(next_label);
            let finish: str = "ast-repeat-end-" + to_str(next_label);
            next_label += 1;
            instructions = nbc_label(instructions, start);
            instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
            instructions = nbc_emit(instructions, "BC_JZ", "@" + finish);
            controls = array_concat(controls, ["repeat|" + start + "|" + finish]);
        } else if kind == "end-repeat" {
            if array_len(controls) <= 1 {
                return nab_fail("end repeat without an open repeat");
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if current[0] != "repeat" {
                return nab_fail("mismatched repeat terminator");
            }
            instructions = nbc_emit(instructions, "BC_JMP", "@" + current[1]);
            instructions = nbc_label(instructions, current[2]);
            controls = slice(controls, 0, array_len(controls) - 1);
        } else if kind == "each" {
            let across_at: int = nam_find(text, " across ", 0);
            let from_at: int = nam_find(text, " from ", 0);
            if across_at < 0 and from_at < 0 {
                return nab_fail("each requires across or from range");
            }
            let item_end: int = across_at >= 0 ? across_at : from_at;
            let item_name: str = str_trim(substr(text, 0, item_end));
            if item_name == "" { return nab_fail("each binding name is empty"); }
            if net_lookup(names, types, item_name) != "" or
               nbc_slot(instructions, item_name) >= 0 {
                return nab_fail("each binding '" + item_name + "' conflicts with an existing local");
            }
            let saved_names: int = array_len(names);
            let saved_types: int = array_len(types);
            let start_label: str = "ast-each-start-" + to_str(next_label);
            let finish_label: str = "ast-each-end-" + to_str(next_label);
            let index_name: str = "__nab_each_index_" + to_str(next_label);
            next_label += 1;
            if across_at >= 0 {
                if array_len(roots) != 1 {
                    return nab_fail("each across requires one iterable expression");
                }
                let iterable: [str] = net_infer(nodes, roots[0], names, types,
                                                field_names, field_types);
                if iterable[0] == "error" { return nab_fail(iterable[1]); }
                if not net_is_array(iterable[1]) {
                    return nab_fail("AST each across currently requires an Array");
                }
                let element_type: str = net_array_element(iterable[1]);
                if element_type == "" {
                    return nab_fail("cannot infer each element type from an empty array");
                }
                let array_name: str = "__nab_each_array_" + to_str(next_label - 1);
                instructions = nbc_bind(instructions, array_name);
                instructions = nbc_note_type(instructions, array_name, iterable[1]);
                instructions = nbc_bind(instructions, index_name);
                instructions = nbc_note_type(instructions, index_name, "Whole");
                instructions = nbc_bind(instructions, item_name);
                instructions = nbc_note_type(instructions, item_name, element_type);
                let array_slot: int = nbc_slot(instructions, array_name);
                let index_slot: int = nbc_slot(instructions, index_name);
                let item_slot: int = nbc_slot(instructions, item_name);
                instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
                instructions = nbc_emit(instructions, "BC_ST_LOCAL", to_str(array_slot));
                instructions = nbc_const(instructions, "int", "BC_CONST_INT", "0");
                instructions = nbc_emit(instructions, "BC_ST_LOCAL", to_str(index_slot));
                instructions = nbc_label(instructions, start_label);
                instructions = nbc_emit(instructions, "BC_LD_LOCAL", to_str(index_slot));
                instructions = nbc_emit(instructions, "BC_LD_LOCAL", to_str(array_slot));
                instructions = nbc_emit(instructions, "BC_ARR_LEN", "");
                instructions = nbc_emit(instructions, "BC_LT_I", "");
                instructions = nbc_emit(instructions, "BC_JZ", "@" + finish_label);
                instructions = nbc_emit(instructions, "BC_LD_LOCAL", to_str(array_slot));
                instructions = nbc_emit(instructions, "BC_LD_LOCAL", to_str(index_slot));
                instructions = nbc_emit(instructions, "BC_IDX_LD", "");
                instructions = nbc_emit(instructions, "BC_ST_LOCAL", to_str(item_slot));
                names = array_concat(names, [item_name]);
                types = array_concat(types, [element_type]);
                controls = array_concat(controls,
                    ["each|across|" + start_label + "|" + finish_label + "|" +
                     index_name + "|" + array_name + "|" + item_name + "|" +
                     to_str(saved_names) + "|" + to_str(saved_types)]);
            } else {
                if array_len(roots) != 2 {
                    return nab_fail("each range requires start and finish expressions");
                }
                let start_type: [str] = net_infer(nodes, roots[0], names, types,
                                                  field_names, field_types);
                if start_type[0] == "error" { return nab_fail(start_type[1]); }
                let finish_type: [str] = net_infer(nodes, roots[1], names, types,
                                                   field_names, field_types);
                if finish_type[0] == "error" { return nab_fail(finish_type[1]); }
                if start_type[1] != "Whole" or finish_type[1] != "Whole" {
                    return nab_fail("each range bounds must be Whole");
                }
                let range_text: str = substr(text, from_at + 6, str_len(text));
                let until_at: int = nam_find(range_text, " until ", 0);
                let through_at: int = nam_find(range_text, " through ", 0);
                let inclusive: str = through_at >= 0 ? "through" : "until";
                if until_at < 0 and through_at < 0 {
                    return nab_fail("each range requires until or through");
                }
                let limit_name: str = "__nab_each_limit_" + to_str(next_label - 1);
                instructions = nbc_bind(instructions, index_name);
                instructions = nbc_note_type(instructions, index_name, "Whole");
                instructions = nbc_bind(instructions, limit_name);
                instructions = nbc_note_type(instructions, limit_name, "Whole");
                instructions = nbc_bind(instructions, item_name);
                instructions = nbc_note_type(instructions, item_name, "Whole");
                let index_slot: int = nbc_slot(instructions, index_name);
                let limit_slot: int = nbc_slot(instructions, limit_name);
                let item_slot: int = nbc_slot(instructions, item_name);
                instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
                instructions = nbc_emit(instructions, "BC_ST_LOCAL", to_str(index_slot));
                instructions = nbc_emit_ast_node(instructions, nodes, roots[1]);
                instructions = nbc_emit(instructions, "BC_ST_LOCAL", to_str(limit_slot));
                instructions = nbc_label(instructions, start_label);
                instructions = nbc_emit(instructions, "BC_LD_LOCAL", to_str(index_slot));
                instructions = nbc_emit(instructions, "BC_LD_LOCAL", to_str(limit_slot));
                instructions = nbc_emit(instructions,
                    inclusive == "through" ? "BC_LE_I" : "BC_LT_I", "");
                instructions = nbc_emit(instructions, "BC_JZ", "@" + finish_label);
                instructions = nbc_emit(instructions, "BC_LD_LOCAL", to_str(index_slot));
                instructions = nbc_emit(instructions, "BC_ST_LOCAL", to_str(item_slot));
                names = array_concat(names, [item_name]);
                types = array_concat(types, ["Whole"]);
                controls = array_concat(controls,
                    ["each|range|" + start_label + "|" + finish_label + "|" +
                     index_name + "|" + limit_name + "|" + item_name + "|" +
                     inclusive + "|" + to_str(saved_names) + "|" + to_str(saved_types)]);
            }
        } else if kind == "end-each" {
            if array_len(controls) <= 1 {
                return nab_fail("end each without an open each");
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if current[0] != "each" {
                return nab_fail("mismatched each terminator");
            }
            let index_slot: int = nbc_slot(instructions, current[4]);
            if index_slot < 0 { return nab_fail("missing each index slot"); }
            instructions = nbc_emit(instructions, "BC_LD_LOCAL", to_str(index_slot));
            instructions = nbc_const(instructions, "int", "BC_CONST_INT", "1");
            instructions = nbc_emit(instructions, "BC_ADD_I", "");
            instructions = nbc_emit(instructions, "BC_ST_LOCAL", to_str(index_slot));
            instructions = nbc_emit(instructions, "BC_JMP", "@" + current[2]);
            instructions = nbc_label(instructions, current[3]);
            names = slice(names, 0, int_from_str(current[current[1] == "across" ? 7 : 8]));
            types = slice(types, 0, int_from_str(current[current[1] == "across" ? 8 : 9]));
            controls = slice(controls, 0, array_len(controls) - 1);
        } else if kind == "give" {
            if return_type == "Unit" and array_len(roots) > 0 {
                return nab_fail("Unit routine cannot give a value");
            }
            if return_type != "Unit" and array_len(roots) != 1 {
                return nab_fail("non-Unit routine must give a value");
            }
            if array_len(roots) == 1 {
                let checked: [str] = net_infer(nodes, roots[0], names, types,
                                               field_names, field_types);
                if checked[0] == "error" { return nab_fail(checked[1]); }
                if checked[1] != return_type {
                    return nab_fail("routine '" + current_function + "' returns " +
                                    return_type + ", got " + checked[1]);
                }
                instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
                instructions = nbc_emit(instructions, "BC_RET", "");
            } else {
                instructions = nbc_emit(instructions, "BC_RET_UNIT", "");
            }
            returned = true;
        } else {
            return nab_fail("AST bytecode slice does not yet lower '" + kind +
                            "' at line " + to_str(line));
        }

        expressions = nodes;
        i += 1;
    }

    if current_function != "" { return nab_fail("unterminated routine '" + current_function + "'"); }
    return instructions;
}

// First module-AST-driven bytecode collector.
// The supported slice is typed routines, local bindings/assignments, indexed array
// writes, integer ranges and array-across iteration, show and give.
// The legacy source collector remains the reference for other constructs.
use "natural_ast_module.suru";
use "natural_bytecode.suru";
use "natural_expression_types.suru";

func nab_fail(message: str) -> [str] {
    println("ast-bytecode-error|" + message);
    return ["#emit-failed"];
}

func nab_collect_routine_declarations(instructions: [str], module: [str]) -> [str] {
    mut result: [str] = instructions;
    mut i: int = 1;
    while i < array_len(module) {
        let raw: str = module[i];
        if nam_node_kind(raw) == "routine" {
            let signature: [str] = str_split(nam_node_text(raw), "|");
            if array_len(signature) < 3 {
                println("ast-bytecode-error|malformed routine declaration");
                return ["#emit-failed"];
            }
            let name: str = signature[0];
            if name == "" {
                println("ast-bytecode-error|routine name is empty");
                return ["#emit-failed"];
            }
            if nbc_func_index(result, name) < 0 {
                let index: int = nbc_pool_count(result, "func");
                result = array_concat(result, ["#func|" + name + "|" + to_str(index)]);
            }
            if nbc_func_return_type(result, name) == "" {
                result = array_concat(result, ["#functype|" + name + "|" + signature[2]]);
            }
        }
        i += 1;
    }
    return result;
}

func nab_strip_record_declarations(source: str) -> str {
    let lines: [str] = str_split(source, "\n");
    mut out: str = "";
    mut in_record: bool = false;
    mut i: int = 0;
    while i < array_len(lines) {
        let line: str = str_trim(lines[i]);
        mut kept: str = lines[i];
        if in_record {
            kept = "";
            if line == "end record" { in_record = false; }
        } else if nbc_word(line) == "record" {
            // Record field layout is collected separately below; leave a blank
            // line so the statement AST keeps the original source line numbers.
            kept = "";
            in_record = true;
        }
        if i > 0 { out = out + "\n"; }
        out = out + kept;
        i += 1;
    }
    return out;
}

func nab_strip_choice_declarations(source: str) -> str {
    let lines: [str] = str_split(source, "\\n");
    mut out: str = "";
    mut in_choice: bool = false;
    mut i: int = 0;
    while i < array_len(lines) {
        let line: str = str_trim(lines[i]);
        mut kept: str = lines[i];
        if in_choice {
            kept = "";
            if line == "end choice" { in_choice = false; }
        } else if nbc_word(line) == "choice" {
            // Choice variants are read by the declaration metadata prepass;
            // keep blank lines so statement AST source locations stay stable.
            kept = "";
            in_choice = true;
        }
        if i > 0 { out = out + "\\n"; }
        out = out + kept;
        i += 1;
    }
    return out;
}

func nab_binding_parts(text: str) -> [str] {
    let equals: int = nam_find(text, " = ", 0);
    let first_space: int = nam_find(text, " ", 0);
    if equals < 0 or first_space < 0 { return ["", "", ""]; }
    let colon: int = nam_find(text, ":", first_space + 1);
    let name_end: int = colon >= 0 ? colon : equals;
    let name: str = str_trim(substr(text, first_space + 1,
                                    name_end - first_space - 1));
    let declared: str = colon < 0 ? "" :
        str_trim(substr(text, colon + 1, equals - colon - 1));
    return [name, declared, substr(text, equals + 3, str_len(text))];
}

func nab_collect_ast(source: str) -> [str] {
    let record_source: str = nab_strip_record_declarations(source);
    let ast_source: str = nab_strip_choice_declarations(record_source);
    let module: [str] = nam_parse(ast_source);
    if module[0] == "error" {
        println("ast-bytecode-error|" + module[1] + "|" + module[2] + "|" + module[3]);
        return ["#emit-failed"];
    }
    let lines: [str] = str_split(source, "\n");
    mut instructions: [str] = [];
    instructions = nab_collect_routine_declarations(instructions, module);
    if array_len(instructions) == 1 and instructions[0] == "#emit-failed" {
        return instructions;
    }
    instructions = nbc_collect_records(instructions, lines);
    instructions = nbc_collect_choices(instructions, lines);

    mut expressions: [str] = [];
    mut names: [str] = [];
    mut types: [str] = [];
    mut field_names: [str] = [];
    mut field_types: [str] = [];
    mut field_meta_index: int = 0;
    while field_meta_index < array_len(instructions) {
        if nbc_has_prefix(instructions[field_meta_index], "#fieldtype|") {
            let field_meta: [str] = str_split(instructions[field_meta_index], "|");
            if array_len(field_meta) >= 4 {
                field_names = array_concat(field_names,
                    [field_meta[1] + "." + field_meta[2]]);
                field_types = array_concat(field_types, [field_meta[3]]);
            }
        } else if nbc_has_prefix(instructions[field_meta_index], "#variant|") {
            let variant_meta: [str] = str_split(instructions[field_meta_index], "|");
            if array_len(variant_meta) >= 6 {
                field_names = array_concat(field_names,
                    ["@variant:" + variant_meta[2]]);
                field_types = array_concat(field_types,
                    [variant_meta[1] + "|" + variant_meta[4] + "|" + variant_meta[5]]);
            }
        }
        field_meta_index += 1;
    }
    // Make every routine signature visible before lowering any body. This
    // permits forward calls and gives expression typing one shared namespace
    // for record fields and routine signatures.
    mut routine_meta_index: int = 1;
    while routine_meta_index < array_len(module) {
        let declaration: str = module[routine_meta_index];
        if nam_node_kind(declaration) == "routine" {
            let signature: [str] = str_split(nam_node_text(declaration), "|");
            if array_len(signature) < 3 {
                return nab_fail("malformed routine signature during type prepass");
            }
            mut parameters: [str] = [];
            if signature[1] != "" { parameters = str_split(signature[1], ","); }
            mut parameter_types: [str] = [];
            mut parameter_index: int = 0;
            while parameter_index < array_len(parameters) {
                let colon: int = nbc_find(parameters[parameter_index], ":");
                if colon < 1 {
                    return nab_fail("malformed parameter type in routine '" + signature[0] + "'");
                }
                let parameter_type: str = str_trim(substr(
                    parameters[parameter_index], colon + 1,
                    str_len(parameters[parameter_index])));
                if parameter_type == "" {
                    return nab_fail("empty parameter type in routine '" + signature[0] + "'");
                }
                parameter_types = array_concat(parameter_types, [parameter_type]);
                parameter_index += 1;
            }
            field_names = array_concat(field_names, ["@routine:" + signature[0]]);
            field_types = array_concat(field_types,
                [signature[2] + "|" + nam_join(parameter_types, ",")]);
        }
        routine_meta_index += 1;
    }
    mut current_function: str = "";
    mut return_type: str = "";
    mut returned: bool = false;
    mut controls: [str] = [];
    mut labels: int = 0;
    mut i: int = 1;
    while i < array_len(module) {
        let raw: str = module[i];
        let kind: str = nam_node_kind(raw);
        let line: int = nam_node_line(raw);
        let text: str = nam_node_text(raw);

        if kind == "routine" {
            if current_function != "" {
                return nab_fail("nested routine boundary at line " + to_str(line));
            }
            let signature: [str] = str_split(text, "|");
            if array_len(signature) < 3 { return nab_fail("malformed routine AST"); }
            current_function = signature[0];
            return_type = signature[2];
            returned = false;
            names = slice(names, array_len(names), 0);
            types = slice(types, array_len(types), 0);
            expressions = slice(expressions, array_len(expressions), 0);
            let params: [str] = signature[1] == "" ?
                slice(signature, array_len(signature), 0) : str_split(signature[1], ",");
            instructions = array_concat(instructions,
                ["#funcbody|" + current_function + "|" + to_str(array_len(params))]);
            mut p: int = 0;
            while p < array_len(params) {
                let colon: int = nbc_find(params[p], ":");
                if colon < 1 { return nab_fail("invalid parameter in " + current_function); }
                let pname: str = str_trim(substr(params[p], 0, colon));
                let ptype: str = str_trim(substr(params[p], colon + 1, str_len(params[p])));
                if pname == "" or ptype == "" { return nab_fail("invalid parameter in " + current_function); }
                if nbc_slot(instructions, pname) >= 0 {
                    return nab_fail("duplicate parameter '" + pname + "'");
                }
                instructions = nbc_bind(instructions, pname);
                instructions = nbc_note_type(instructions, pname, ptype);
                names = array_concat(names, [pname]);
                types = array_concat(types, [ptype]);
                p += 1;
            }
            i += 1;
            continue;
        }

        if kind == "end-routine" {
            if current_function == "" { return nab_fail("end routine without routine"); }
            if array_len(controls) != 0 {
                return nab_fail("unterminated control block in '" + current_function + "'");
            }
            if return_type != "Unit" and not returned {
                return nab_fail("non-Unit routine '" + current_function + "' has no give");
            }
            // Match the reference collector's explicit end-routine terminator;
            // after a non-Unit give this is unreachable but bytecode-stable.
            instructions = nbc_emit(instructions, "BC_RET_UNIT", "");
            current_function = "";
            return_type = "";
            returned = false;
            names = slice(names, array_len(names), 0);
            types = slice(types, array_len(types), 0);
            expressions = slice(expressions, array_len(expressions), 0);
            i += 1;
            continue;
        }

        if current_function == "" {
            return nab_fail("statement outside routine at line " + to_str(line));
        }

        let state: [str] = array_concat(["ok", ""], expressions);
        let attached: [str] = nam_attach_expressions(kind, text, state);
        if attached[0] == "error" { return nab_fail(attached[1]); }
        let roots: [int] = net_children(attached[1]);
        let nodes: [str] = slice(attached, 2, array_len(attached));

        if kind == "binding" {
            if array_len(roots) != 1 { return nab_fail("binding requires one initializer"); }
            let parts: [str] = nab_binding_parts(text);
            if parts[0] == "" { return nab_fail("malformed binding at line " + to_str(line)); }
            let inferred: [str] = net_infer(nodes, roots[0], names, types,
                                            field_names, field_types);
            let record_index: int = parts[1] == "" ? -1 :
                nbc_record_index(instructions, parts[1]);
            let default_record: bool = record_index >= 0 and
                nbc_ast_kind(nodes, roots[0]) == "atom" and
                nbc_ast_value(nodes, roots[0]) == "none";
            if inferred[0] == "error" and not default_record {
                return nab_fail(inferred[1]);
            }
            let inferred_type: str = default_record ? parts[1] : inferred[1];
            if parts[1] != "" and parts[1] != inferred_type {
                return nab_fail("binding '" + parts[0] + "' expected " +
                                parts[1] + ", got " + inferred_type);
            }
            if nbc_slot(instructions, parts[0]) >= 0 {
                return nab_fail("duplicate local '" + parts[0] + "'");
            }
            if default_record {
                let nfields: int = nbc_record_nfields(instructions, parts[1]);
                mut field_index: int = 0;
                while field_index < nfields {
                    instructions = nbc_emit(instructions, "BC_CONST_NONE", "");
                    field_index += 1;
                }
                instructions = nbc_emit(instructions, "BC_NEW_RECORD",
                    to_str(record_index) + "|" + to_str(nfields));
            } else {
                instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
            }
            instructions = nbc_bind(instructions, parts[0]);
            instructions = nbc_note_type(instructions, parts[0], inferred_type);
            instructions = nbc_emit(instructions, "BC_ST_LOCAL",
                                    to_str(nbc_slot(instructions, parts[0])));
            names = array_concat(names, [parts[0]]);
            types = array_concat(types, [inferred_type]);
        } else if kind == "assignment" {
            if array_len(roots) != 2 { return nab_fail("assignment requires target and value"); }
            let target_kind: str = nbc_ast_kind(nodes, roots[0]);
            let left: [str] = net_infer(nodes, roots[0], names, types, field_names, field_types);
            let right: [str] = net_infer(nodes, roots[1], names, types, field_names, field_types);
            if left[0] == "error" { return nab_fail(left[1]); }
            if right[0] == "error" { return nab_fail(right[1]); }
            if net_common_type(left[1], right[1]) == "" {
                return nab_fail("assignment type mismatch");
            }
            if target_kind == "atom" {
                let target: str = nbc_ast_value(nodes, roots[0]);
                let slot: int = nbc_slot(instructions, target);
                if slot < 0 { return nab_fail("unknown local assignment target '" + target + "'"); }
                instructions = nbc_emit_ast_node(instructions, nodes, roots[1]);
                instructions = nbc_emit(instructions, "BC_ST_LOCAL", to_str(slot));
            } else if target_kind == "index" {
                let target_children: [int] = nbc_ast_children(nodes, roots[0]);
                if array_len(target_children) != 2 {
                    return nab_fail("indexed assignment requires an array and index");
                }
                let receiver: [str] = net_infer(nodes, target_children[0], names, types,
                                                field_names, field_types);
                if receiver[0] == "error" { return nab_fail(receiver[1]); }
                if not net_is_array(receiver[1]) {
                    return nab_fail("indexed assignment requires an Array target");
                }
                instructions = nbc_emit_ast_node(instructions, nodes, target_children[0]);
                instructions = nbc_emit_ast_node(instructions, nodes, target_children[1]);
                instructions = nbc_emit_ast_node(instructions, nodes, roots[1]);
                instructions = nbc_emit(instructions, "BC_IDX_ST", "");
            } else if target_kind == "field" {
                let target_children: [int] = nbc_ast_children(nodes, roots[0]);
                if array_len(target_children) != 1 {
                    return nab_fail("record-field assignment requires one receiver");
                }
                let receiver: [str] = net_infer(nodes, target_children[0], names, types,
                                                field_names, field_types);
                if receiver[0] == "error" { return nab_fail(receiver[1]); }
                let record: int = nbc_record_index(instructions, receiver[1]);
                let field: int = nbc_field_index(instructions, receiver[1],
                                                nbc_ast_value(nodes, roots[0]));
                if record < 0 or field < 0 {
                    return nab_fail("unknown record field '" +
                                    nbc_ast_value(nodes, roots[0]) + "'");
                }
                instructions = nbc_emit_ast_node(instructions, nodes, target_children[0]);
                instructions = nbc_emit_ast_node(instructions, nodes, roots[1]);
                instructions = nbc_emit(instructions, "BC_FIELD_ST",
                                        to_str(record) + "|" + to_str(field));
            } else {
                return nab_fail("AST bytecode slice does not yet lower assignment target '" +
                                target_kind + "'");
            }
        } else if kind == "show" {
            if array_len(roots) != 1 { return nab_fail("show requires one expression"); }
            let checked: [str] = net_infer(nodes, roots[0], names, types,
                                           field_names, field_types);
            if checked[0] == "error" { return nab_fail(checked[1]); }
            instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
            instructions = nbc_emit(instructions, "BC_BUILTIN", "1");
            instructions = nbc_emit(instructions, "BC_POP", "");
        } else if kind == "give" {
            if return_type == "Unit" and array_len(roots) > 0 {
                return nab_fail("Unit routine cannot give a value");
            }
            if return_type != "Unit" and array_len(roots) != 1 {
                return nab_fail("non-Unit routine must give a value");
            }
            if array_len(roots) == 1 {
                let checked: [str] = net_infer(nodes, roots[0], names, types,
                                               field_names, field_types);
                if checked[0] == "error" { return nab_fail(checked[1]); }
                if checked[1] != return_type {
                    return nab_fail("routine '" + current_function + "' returns " +
                                    return_type + ", got " + checked[1]);
                }
                instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
                instructions = nbc_emit(instructions, "BC_RET", "");
            } else {
                instructions = nbc_emit(instructions, "BC_RET_UNIT", "");
            }
            returned = true;
        } else if kind == "choose" {
            if array_len(roots) != 1 {
                return nab_fail("choose requires one subject expression");
            }
            let subject: [str] = net_infer(nodes, roots[0], names, types,
                                            field_names, field_types);
            if subject[0] == "error" { return nab_fail(subject[1]); }
            if nbc_choice_index(instructions, subject[1]) < 0 {
                return nab_fail("choose subject must have a declared choice type, got " + subject[1]);
            }
            let selector_name: str = "$ast-choose-selector-" + to_str(labels);
            let finish_name: str = "ast-choose-end-" + to_str(labels);
            labels += 1;
            instructions = nbc_bind(instructions, selector_name);
            instructions = nbc_note_type(instructions, selector_name, subject[1]);
            instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
            instructions = nbc_emit(instructions, "BC_ST_LOCAL",
                                    to_str(nbc_slot(instructions, selector_name)));
            controls = array_concat(controls,
                ["choose|" + selector_name + "|" + subject[1] + "|" +
                 finish_name + "||0"]);
        } else if kind == "case" {
            if array_len(controls) == 0 {
                return nab_fail("case without an open choose");
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if array_len(current) < 6 or current[0] != "choose" {
                return nab_fail("mismatched case clause");
            }
            if current[5] == "1" {
                return nab_fail("case cannot follow wildcard case");
            }
            if array_len(roots) != 1 {
                return nab_fail("case requires one variant or wildcard pattern");
            }
            if current[4] != "" {
                instructions = nbc_emit(instructions, "BC_JMP", "@" + current[3]);
                instructions = nbc_label(instructions, current[4]);
            }
            let pattern_kind: str = nbc_ast_kind(nodes, roots[0]);
            let pattern_name: str = nbc_ast_value(nodes, roots[0]);
            if pattern_kind == "atom" and pattern_name == "_" {
                controls[array_len(controls) - 1] =
                    "choose|" + current[1] + "|" + current[2] + "|" + current[3] + "||1";
            } else {
                if pattern_kind == "call" {
                    return nab_fail("choice payload patterns are not yet lowered in the AST bytecode path");
                }
                if pattern_kind != "atom" {
                    return nab_fail("case pattern must name a choice variant or '_'");
                }
                let variant_choice: str = nbc_variant_choice(instructions, pattern_name);
                if variant_choice == "" or variant_choice != current[2] {
                    return nab_fail("case variant '" + pattern_name +
                                    "' does not belong to choice '" + current[2] + "'");
                }
                if nbc_variant_nargs(instructions, current[2], pattern_name) != 0 {
                    return nab_fail("case variant '" + pattern_name +
                                    "' requires a payload pattern");
                }
                let variant_tag: int = nbc_variant_tag(instructions, current[2], pattern_name);
                if variant_tag < 0 {
                    return nab_fail("missing tag for choice variant '" + pattern_name + "'");
                }
                let next_case: str = "ast-choose-next-" + to_str(labels);
                labels += 1;
                let selector_slot: int = nbc_slot(instructions, current[1]);
                if selector_slot < 0 {
                    return nab_fail("missing choose selector slot");
                }
                instructions = nbc_emit(instructions, "BC_LD_LOCAL", to_str(selector_slot));
                instructions = nbc_const(instructions, "int", "BC_CONST_INT",
                                          to_str(variant_tag));
                instructions = nbc_emit(instructions, "BC_EQ_I", "");
                instructions = nbc_emit(instructions, "BC_JZ", "@" + next_case);
                controls[array_len(controls) - 1] =
                    "choose|" + current[1] + "|" + current[2] + "|" +
                    current[3] + "|" + next_case + "|0";
            }
        } else if kind == "end-choose" {
            if array_len(controls) == 0 {
                return nab_fail("end choose without choose");
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if array_len(current) < 6 or current[0] != "choose" {
                return nab_fail("mismatched choose terminator");
            }
            if current[4] != "" { instructions = nbc_label(instructions, current[4]); }
            instructions = nbc_label(instructions, current[3]);
            controls = slice(controls, 0, array_len(controls) - 1);
        } else if kind == "when" {
            if array_len(roots) != 1 {
                return nab_fail("when requires one condition expression");
            }
            let condition: [str] = net_infer(nodes, roots[0], names, types,
                                             field_names, field_types);
            if condition[0] == "error" { return nab_fail(condition[1]); }
            if condition[1] != "Bool" {
                return nab_fail("when condition must be Bool, got " + condition[1]);
            }
            let finish: str = "ast-when-end-" + to_str(labels);
            let next: str = "ast-when-next-" + to_str(labels);
            labels += 1;
            instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
            instructions = nbc_emit(instructions, "BC_JZ", "@" + next);
            controls = array_concat(controls, ["when|" + finish + "|" + next + "|0"]);
        } else if kind == "otherwise" or kind == "otherwise-when" {
            if array_len(controls) == 0 {
                return nab_fail(kind + " without an open when");
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if array_len(current) < 4 or current[0] != "when" or current[3] == "2" {
                return nab_fail("mismatched or repeated when clause");
            }
            if current[2] == "" {
                return nab_fail("when clause has no pending false branch");
            }
            instructions = nbc_emit(instructions, "BC_JMP", "@" + current[1]);
            instructions = nbc_label(instructions, current[2]);
            if kind == "otherwise-when" {
                if array_len(roots) != 1 {
                    return nab_fail("otherwise when requires one condition expression");
                }
                let condition: [str] = net_infer(nodes, roots[0], names, types,
                                                 field_names, field_types);
                if condition[0] == "error" { return nab_fail(condition[1]); }
                if condition[1] != "Bool" {
                    return nab_fail("otherwise when condition must be Bool, got " + condition[1]);
                }
                let next: str = "ast-when-next-" + to_str(labels);
                labels += 1;
                instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
                instructions = nbc_emit(instructions, "BC_JZ", "@" + next);
                controls[array_len(controls) - 1] =
                    "when|" + current[1] + "|" + next + "|1";
            } else {
                if array_len(roots) != 0 {
                    return nab_fail("otherwise clause cannot have an expression");
                }
                controls[array_len(controls) - 1] = "when|" + current[1] + "||2";
            }
        } else if kind == "end-when" {
            if array_len(controls) == 0 {
                return nab_fail("end when without an open when");
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if array_len(current) < 4 or current[0] != "when" {
                return nab_fail("mismatched when terminator");
            }
            if current[2] != "" { instructions = nbc_label(instructions, current[2]); }
            instructions = nbc_label(instructions, current[1]);
            controls = slice(controls, 0, array_len(controls) - 1);
        } else if kind == "each" {
            if array_len(roots) == 1 {
                let across_at: int = nam_find(text, " across ", 0);
                if across_at < 1 {
                    return nab_fail("malformed each-across at line " + to_str(line));
                }
                let item_name: str = str_trim(substr(text, 0, across_at));
                if item_name == "" or nbc_slot(instructions, item_name) >= 0 {
                    return nab_fail("invalid or duplicate each binding '" + item_name + "'");
                }
                let iterable: [str] = net_infer(nodes, roots[0], names, types,
                                                 field_names, field_types);
                if iterable[0] == "error" { return nab_fail(iterable[1]); }
                if not net_is_array(iterable[1]) {
                    return nab_fail("each across currently requires an Array");
                }
                let item_type: str = net_array_element(iterable[1]);
                if item_type == "" {
                    return nab_fail("each across cannot infer the element type of an empty Array");
                }
                let loop_start: str = "ast-each-across-start-" + to_str(labels);
                let loop_end: str = "ast-each-across-end-" + to_str(labels);
                let array_name: str = "$ast-each-array-" + to_str(labels);
                let index_name: str = "$ast-each-index-" + to_str(labels);
                labels += 1;

                // Evaluate the iterable once so mutations in the loop body do
                // not change which array is being traversed.
                instructions = nbc_bind(instructions, array_name);
                instructions = nbc_note_type(instructions, array_name, iterable[1]);
                instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
                instructions = nbc_emit(instructions, "BC_ST_LOCAL",
                                        to_str(nbc_slot(instructions, array_name)));

                instructions = nbc_bind(instructions, index_name);
                instructions = nbc_note_type(instructions, index_name, "Whole");
                instructions = nbc_const(instructions, "int", "BC_CONST_INT", "0");
                instructions = nbc_emit(instructions, "BC_ST_LOCAL",
                                        to_str(nbc_slot(instructions, index_name)));

                instructions = nbc_bind(instructions, item_name);
                instructions = nbc_note_type(instructions, item_name, item_type);
                names = array_concat(names, [item_name]);
                types = array_concat(types, [item_type]);

                instructions = nbc_label(instructions, loop_start);
                instructions = nbc_emit(instructions, "BC_LD_LOCAL",
                                        to_str(nbc_slot(instructions, index_name)));
                instructions = nbc_emit(instructions, "BC_LD_LOCAL",
                                        to_str(nbc_slot(instructions, array_name)));
                instructions = nbc_emit(instructions, "BC_ARR_LEN", "");
                instructions = nbc_emit(instructions, "BC_LT_I", "");
                instructions = nbc_emit(instructions, "BC_JZ", "@" + loop_end);
                instructions = nbc_emit(instructions, "BC_LD_LOCAL",
                                        to_str(nbc_slot(instructions, array_name)));
                instructions = nbc_emit(instructions, "BC_LD_LOCAL",
                                        to_str(nbc_slot(instructions, index_name)));
                instructions = nbc_emit(instructions, "BC_IDX_LD", "");
                instructions = nbc_emit(instructions, "BC_ST_LOCAL",
                                        to_str(nbc_slot(instructions, item_name)));
                controls = array_concat(controls,
                    ["each-across|" + item_name + "|" + array_name + "|" +
                     index_name + "|" + loop_start + "|" + loop_end]);
            } else if array_len(roots) == 2 {
                let from_at: int = nam_find(text, " from ", 0);
                let until_at: int = nam_find(text, " until ", 0);
                let through_at: int = nam_find(text, " through ", 0);
                let bound_at: int = until_at >= 0 ? until_at : through_at;
                let bound_word: str = until_at >= 0 ? "until" : "through";
                if from_at < 1 or bound_at <= from_at {
                    return nab_fail("malformed each range at line " + to_str(line));
                }
                let item_name: str = str_trim(substr(text, 0, from_at));
                if item_name == "" or nbc_slot(instructions, item_name) >= 0 {
                    return nab_fail("invalid or duplicate each binding '" + item_name + "'");
                }
                let start_type: [str] = net_infer(nodes, roots[0], names, types,
                                                  field_names, field_types);
                if start_type[0] == "error" { return nab_fail(start_type[1]); }
                let finish_type: [str] = net_infer(nodes, roots[1], names, types,
                                                   field_names, field_types);
                if finish_type[0] == "error" { return nab_fail(finish_type[1]); }
                if start_type[1] != "Whole" or finish_type[1] != "Whole" {
                    return nab_fail("each range bounds must be Whole");
                }

                let loop_start: str = "ast-each-start-" + to_str(labels);
                let loop_end: str = "ast-each-end-" + to_str(labels);
                let limit_name: str = "$ast-each-limit-" + to_str(labels);
                labels += 1;

                instructions = nbc_bind(instructions, item_name);
                instructions = nbc_note_type(instructions, item_name, "Whole");
                names = array_concat(names, [item_name]);
                types = array_concat(types, ["Whole"]);
                instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
                instructions = nbc_emit(instructions, "BC_ST_LOCAL",
                                        to_str(nbc_slot(instructions, item_name)));

                instructions = nbc_bind(instructions, limit_name);
                instructions = nbc_note_type(instructions, limit_name, "Whole");
                instructions = nbc_emit_ast_node(instructions, nodes, roots[1]);
                instructions = nbc_emit(instructions, "BC_ST_LOCAL",
                                        to_str(nbc_slot(instructions, limit_name)));

                instructions = nbc_label(instructions, loop_start);
                instructions = nbc_emit(instructions, "BC_LD_LOCAL",
                                        to_str(nbc_slot(instructions, item_name)));
                instructions = nbc_emit(instructions, "BC_LD_LOCAL",
                                        to_str(nbc_slot(instructions, limit_name)));
                instructions = nbc_emit(instructions,
                                        bound_word == "until" ? "BC_LT_I" : "BC_LE_I", "");
                instructions = nbc_emit(instructions, "BC_JZ", "@" + loop_end);
                controls = array_concat(controls,
                    ["each|" + item_name + "|" + limit_name + "|" +
                     loop_start + "|" + loop_end + "|" + bound_word]);
            } else {
                return nab_fail("each requires one across expression or two range expressions");
            }
        } else if kind == "end-each" {
            if array_len(controls) == 0 {
                return nab_fail("end each without an open each");
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if array_len(current) > 0 and current[0] == "each-across" {
                if array_len(current) < 6 {
                    return nab_fail("malformed each-across control state");
                }
                let index_slot: int = nbc_slot(instructions, current[3]);
                if index_slot < 0 {
                    return nab_fail("missing each-across index slot");
                }
                instructions = nbc_emit(instructions, "BC_LD_LOCAL", to_str(index_slot));
                instructions = nbc_const(instructions, "int", "BC_CONST_INT", "1");
                instructions = nbc_emit(instructions, "BC_ADD_I", "");
                instructions = nbc_emit(instructions, "BC_ST_LOCAL", to_str(index_slot));
                instructions = nbc_emit(instructions, "BC_JMP", "@" + current[4]);
                instructions = nbc_label(instructions, current[5]);
            } else {
                if array_len(current) < 6 or current[0] != "each" {
                    return nab_fail("mismatched each terminator");
                }
                let item_slot: int = nbc_slot(instructions, current[1]);
                let limit_slot: int = nbc_slot(instructions, current[2]);
                if item_slot < 0 or limit_slot < 0 {
                    return nab_fail("missing each iterator or limit slot");
                }
                // A through loop must stop before incrementing its maximum bound;
                // otherwise the final increment could overflow Whole.
                if current[5] == "through" {
                    instructions = nbc_emit(instructions, "BC_LD_LOCAL", to_str(item_slot));
                    instructions = nbc_emit(instructions, "BC_LD_LOCAL", to_str(limit_slot));
                    instructions = nbc_emit(instructions, "BC_EQ_I", "");
                    instructions = nbc_emit(instructions, "BC_JNZ", "@" + current[4]);
                }
                instructions = nbc_emit(instructions, "BC_LD_LOCAL", to_str(item_slot));
                instructions = nbc_const(instructions, "int", "BC_CONST_INT", "1");
                instructions = nbc_emit(instructions, "BC_ADD_I", "");
                instructions = nbc_emit(instructions, "BC_ST_LOCAL", to_str(item_slot));
                instructions = nbc_emit(instructions, "BC_JMP", "@" + current[3]);
                instructions = nbc_label(instructions, current[4]);
            }
            controls = slice(controls, 0, array_len(controls) - 1);
        } else if kind == "repeat" {
            if array_len(roots) != 1 {
                return nab_fail("repeat while requires one condition expression");
            }
            let condition: [str] = net_infer(nodes, roots[0], names, types,
                                             field_names, field_types);
            if condition[0] == "error" { return nab_fail(condition[1]); }
            if condition[1] != "Bool" {
                return nab_fail("repeat condition must be Bool, got " + condition[1]);
            }
            let start: str = "ast-repeat-start-" + to_str(labels);
            let finish: str = "ast-repeat-end-" + to_str(labels);
            labels += 1;
            instructions = nbc_label(instructions, start);
            instructions = nbc_emit_ast_node(instructions, nodes, roots[0]);
            instructions = nbc_emit(instructions, "BC_JZ", "@" + finish);
            controls = array_concat(controls, ["repeat|" + start + "|" + finish]);
        } else if kind == "end-repeat" {
            if array_len(controls) == 0 {
                return nab_fail("end repeat without an open repeat");
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if array_len(current) < 3 or current[0] != "repeat" {
                return nab_fail("mismatched repeat terminator");
            }
            instructions = nbc_emit(instructions, "BC_JMP", "@" + current[1]);
            instructions = nbc_label(instructions, current[2]);
            controls = slice(controls, 0, array_len(controls) - 1);
        } else {
            return nab_fail("AST bytecode slice does not yet lower '" + kind +
                            "' at line " + to_str(line));
        }

        expressions = nodes;
        i += 1;
    }

    if current_function != "" { return nab_fail("unterminated routine '" + current_function + "'"); }
    return instructions;
}

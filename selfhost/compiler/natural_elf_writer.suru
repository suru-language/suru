// SURU-owned ELF64 emitter (Stage 3 seed). Produces minimal static x86-64
// ELF64 executables (no C compiler/linker) for trivial Natural programs:
// `show("literal")`, `show(<int constant>)`, and `show(<int expression>)`
// over const_int / neg / add / sub / mul / div. Values are printed via a raw
// divide-by-10 decimal routine and `write`/`exit` syscalls.

use "natural_module_writer.suru";

func nw_u16(n: int) -> str {
    return str_chr_byte(n & 255) + str_chr_byte((n >> 8) & 255);
}

func nw_elf_header(total: int, entry: int) -> str {
    mut hd: str = "";
    hd = hd + str_chr_byte(0x7f) + "ELF" +
        str_chr_byte(2) + str_chr_byte(1) + str_chr_byte(1) + str_chr_byte(0) +
        str_chr_byte(0) + str_chr_byte(0) + str_chr_byte(0) + str_chr_byte(0) +
        str_chr_byte(0) + str_chr_byte(0) + str_chr_byte(0) + str_chr_byte(0);
    hd = hd + nw_u16(2);
    hd = hd + nw_u16(62);
    hd = hd + nw_u32(1);
    hd = hd + nw_i64(entry);
    hd = hd + nw_i64(64);
    hd = hd + nw_i64(0);
    hd = hd + nw_u32(0);
    hd = hd + nw_u16(64);
    hd = hd + nw_u16(56);
    hd = hd + nw_u16(1);
    hd = hd + nw_u16(0);
    hd = hd + nw_u16(0);
    hd = hd + nw_u16(0);

    mut ph: str = "";
    ph = ph + nw_u32(1);
    ph = ph + nw_u32(7);
    ph = ph + nw_i64(0);
    ph = ph + nw_i64(0x400000);
    ph = ph + nw_i64(0x400000);
    ph = ph + nw_i64(total);
    ph = ph + nw_i64(total);
    ph = ph + nw_i64(0x1000);

    return hd + ph;
}

func nw_print_routine() -> str {
    mut code: str = "";
    // sub rsp, 32
    code = code + str_chr_byte(0x48) + str_chr_byte(0x83) + str_chr_byte(0xEC) + str_chr_byte(0x20);
    // mov rbx, 10
    code = code + str_chr_byte(0x48) + str_chr_byte(0xC7) + str_chr_byte(0xC3);
    code = code + str_chr_byte(0x0A) + str_chr_byte(0) + str_chr_byte(0) + str_chr_byte(0);
    // lea rcx, [rsp+32]
    code = code + str_chr_byte(0x48) + str_chr_byte(0x8D) + str_chr_byte(0x4C) + str_chr_byte(0x24) + str_chr_byte(0x20);
    // mov r8, rax
    code = code + str_chr_byte(0x49) + str_chr_byte(0x89) + str_chr_byte(0xC0);
    // loop: xor rdx, rdx
    code = code + str_chr_byte(0x48) + str_chr_byte(0x31) + str_chr_byte(0xD2);
    // div rbx
    code = code + str_chr_byte(0x48) + str_chr_byte(0xF7) + str_chr_byte(0xF3);
    // add rdx, 48
    code = code + str_chr_byte(0x48) + str_chr_byte(0x83) + str_chr_byte(0xC2) + str_chr_byte(0x30);
    // dec rcx
    code = code + str_chr_byte(0x48) + str_chr_byte(0xFF) + str_chr_byte(0xC9);
    // mov byte [rcx], dl
    code = code + str_chr_byte(0x88) + str_chr_byte(0x11);
    // test rax, rax
    code = code + str_chr_byte(0x48) + str_chr_byte(0x85) + str_chr_byte(0xC0);
    // jnz loop (disp -24)
    code = code + str_chr_byte(0x0F) + str_chr_byte(0x85) + nw_u32(0xFFFFFFE8);
    // mov r9, rcx
    code = code + str_chr_byte(0x49) + str_chr_byte(0x89) + str_chr_byte(0xC9);
    // mov rax, 1
    code = code + str_chr_byte(0x48) + str_chr_byte(0xC7) + str_chr_byte(0xC0);
    code = code + str_chr_byte(0x01) + str_chr_byte(0) + str_chr_byte(0) + str_chr_byte(0);
    // mov rdi, 1
    code = code + str_chr_byte(0x48) + str_chr_byte(0xC7) + str_chr_byte(0xC7);
    code = code + str_chr_byte(0x01) + str_chr_byte(0) + str_chr_byte(0) + str_chr_byte(0);
    // mov rsi, r9
    code = code + str_chr_byte(0x4C) + str_chr_byte(0x89) + str_chr_byte(0xCE);
    // lea rdx, [rsp+32]
    code = code + str_chr_byte(0x48) + str_chr_byte(0x8D) + str_chr_byte(0x54) + str_chr_byte(0x24) + str_chr_byte(0x20);
    // sub rdx, r9
    code = code + str_chr_byte(0x4C) + str_chr_byte(0x29) + str_chr_byte(0xCA);
    // syscall
    code = code + str_chr_byte(0x0F) + str_chr_byte(0x05);
    return code;
}

func nw_exit_syscall() -> str {
    mut code: str = "";
    code = code + str_chr_byte(0x48) + str_chr_byte(0xC7) + str_chr_byte(0xC0);
    code = code + str_chr_byte(0x3C) + str_chr_byte(0) + str_chr_byte(0) + str_chr_byte(0);
    code = code + str_chr_byte(0x48) + str_chr_byte(0x31) + str_chr_byte(0xFF);
    code = code + str_chr_byte(0x0F) + str_chr_byte(0x05);
    return code;
}

func nw_emit_elf_int_expr(ops: [int], avs: [int]) -> str {
    // Header(64) + phdr(56) = 120; entry at file offset 120.
    // Frame: one 8-byte slot per local; locals live at [rbp - 8*(slot+1)].
    mut nlocals: int = 0;
    mut i: int = 0;
    while i < array_len(ops) {
        if (ops[i] == 5 or ops[i] == 6) and avs[i] + 1 > nlocals {
            nlocals = avs[i] + 1;
        }
        i += 1;
    }

    mut code: str = "";
    // prologue
    code = code + str_chr_byte(0x55);
    code = code + str_chr_byte(0x48) + str_chr_byte(0x89) + str_chr_byte(0xE5);
    code = code + str_chr_byte(0x48) + str_chr_byte(0x83) + str_chr_byte(0xEC) + str_chr_byte(96 + nlocals * 8);

    mut j: int = 0;
    while j < array_len(ops) {
        let op: int = ops[j];
        if op == 1 {
            code = code + str_chr_byte(0x48) + str_chr_byte(0xC7) + str_chr_byte(0xC0);
            code = code + nw_u32(avs[j]);
            code = code + str_chr_byte(0x50);
        } else if op == 5 {
            mut disp: int = 256 - 8 * (avs[j] + 1);
            code = code + str_chr_byte(0x48) + str_chr_byte(0x8B) + str_chr_byte(0x45) + str_chr_byte(disp);
            code = code + str_chr_byte(0x50);
        } else if op == 6 {
            mut disp: int = 256 - 8 * (avs[j] + 1);
            code = code + str_chr_byte(0x58);
            code = code + str_chr_byte(0x48) + str_chr_byte(0x89) + str_chr_byte(0x45) + str_chr_byte(disp);
        } else if op == 11 {
            code = code + str_chr_byte(0x58);
            code = code + str_chr_byte(0x48) + str_chr_byte(0xF7) + str_chr_byte(0xD8);
            code = code + str_chr_byte(0x50);
        } else if op == 14 or op == 15 or op == 16 {
            code = code + str_chr_byte(0x5B) + str_chr_byte(0x58);
            if op == 14 { code = code + str_chr_byte(0x48) + str_chr_byte(0x01) + str_chr_byte(0xD8); }
            else if op == 15 { code = code + str_chr_byte(0x48) + str_chr_byte(0x29) + str_chr_byte(0xD8); }
            else { code = code + str_chr_byte(0x48) + str_chr_byte(0x0F) + str_chr_byte(0xAF) + str_chr_byte(0xC3); }
            code = code + str_chr_byte(0x50);
        } else if op == 17 {
            code = code + str_chr_byte(0x5B) + str_chr_byte(0x58);
            code = code + str_chr_byte(0x48) + str_chr_byte(0x31) + str_chr_byte(0xD2);
            code = code + str_chr_byte(0x48) + str_chr_byte(0xF7) + str_chr_byte(0xF3);
            code = code + str_chr_byte(0x50);
        } else {
            return "";
        }
        j += 1;
    }
    code = code + str_chr_byte(0x58); // pop rax (result)
    code = code + nw_print_routine();
    code = code + nw_exit_syscall();
    let total: int = 120 + str_len(code);
    return nw_elf_header(total, 0x400000 + 120) + code;
}

func nw_emit_elf_message(msg: str) -> str {
    let base: int = 0x400000;
    let code_off: int = 120;
    let entry: int = base + code_off;
    let code_len: int = 46;
    let msg_off: int = code_off + code_len;
    let total: int = msg_off + str_len(msg);

    mut code: str = "";
    code = code + str_chr_byte(0x48) + str_chr_byte(0xC7) + str_chr_byte(0xC0);
    code = code + str_chr_byte(0x01) + str_chr_byte(0) + str_chr_byte(0) + str_chr_byte(0);
    code = code + str_chr_byte(0x48) + str_chr_byte(0xC7) + str_chr_byte(0xC7);
    code = code + str_chr_byte(0x01) + str_chr_byte(0) + str_chr_byte(0) + str_chr_byte(0);
    code = code + str_chr_byte(0x48) + str_chr_byte(0x8D) + str_chr_byte(0x35);
    mut disp: int = (base + msg_off) - (base + code_off + 21);
    code = code + nw_u32(disp);
    code = code + str_chr_byte(0x48) + str_chr_byte(0xC7) + str_chr_byte(0xC2);
    code = code + nw_u32(str_len(msg));
    code = code + str_chr_byte(0x0F) + str_chr_byte(0x05);
    code = code + str_chr_byte(0x48) + str_chr_byte(0xC7) + str_chr_byte(0xC0);
    code = code + str_chr_byte(0x3C) + str_chr_byte(0) + str_chr_byte(0) + str_chr_byte(0);
    code = code + str_chr_byte(0x48) + str_chr_byte(0xC7) + str_chr_byte(0xC7);
    code = code + str_chr_byte(0) + str_chr_byte(0) + str_chr_byte(0) + str_chr_byte(0);
    code = code + str_chr_byte(0x0F) + str_chr_byte(0x05);

    return nw_elf_header(total, entry) + code + msg;
}

func nw_emit_elf_int(value: int) -> str {
    return nw_emit_elf_int_expr([1], [value]);
}

func nw_emit_minimal_elf() -> str {
    return nw_emit_elf_message("hi\n");
}

func nw_emit_elf_multifunc(fn_ops: [[int]], fn_avs: [[int]], fn_nparams: [int], fn_entry: int) -> str {
    let nfuncs: int = array_len(fn_ops);
    mut nl: [int] = [];
    mut f0: int = 0;
    while f0 < nfuncs {
        let ops: [int] = fn_ops[f0];
        let avs: [int] = fn_avs[f0];
        mut mx: int = 0;
        mut p0: int = 0;
        while p0 < array_len(ops) {
            if (ops[p0] == 5 or ops[p0] == 6) and avs[p0] + 1 > mx {
                mx = avs[p0] + 1;
            }
            p0 += 1;
        }
        nl = array_concat(nl, [mx]);
        f0 += 1;
    }

    mut buf: [int] = [];
    mut fn_start: [int] = [];
    mut pc_all: [[int]] = [];
    mut fx: [str] = [];

    mut f: int = 0;
    while f < nfuncs {
        fn_start = array_concat(fn_start, [array_len(buf)]);
        buf = array_concat(buf, [0x55, 0x48,0x89,0xE5, 0x48,0x83,0xEC,0x68]);
        buf[array_len(buf) - 1] = (96 + nl[f] * 8) & 255;
        if fn_nparams[f] >= 2 {
            buf = array_concat(buf, [0x48,0x89,0x75,0xF0]);
        }
        if fn_nparams[f] >= 1 {
            buf = array_concat(buf, [0x48,0x89,0x7D,0xF8]);
        }

        let ops: [int] = fn_ops[f];
        let avs: [int] = fn_avs[f];
        let nins: int = array_len(ops);
        mut pcrel: [int] = [];
        mut pc: int = 0;
        while pc < nins {
            pcrel = array_concat(pcrel, [array_len(buf) - fn_start[f]]);
            let op: int = ops[pc];
            let a: int = avs[pc];
            let b: int = bs[pc];
            if op == 1 {
                buf = array_concat(buf, [0x48,0xC7,0xC0]);
                buf = array_concat(buf, [a & 255, (a >> 8) & 255, (a >> 16) & 255, (a >> 24) & 255, 0x50]);
            } else if op == 5 {
                let disp: int = 256 - 8 * (a + 1);
                buf = array_concat(buf, [0x48,0x8B,0x45,disp, 0x50]);
            } else if op == 6 {
                let disp: int = 256 - 8 * (a + 1);
                buf = array_concat(buf, [0x58, 0x48,0x89,0x45,disp]);
            } else if op == 11 {
                buf = array_concat(buf, [0x58, 0x48,0xF7,0xD8, 0x50]);
            } else if op == 14 or op == 15 or op == 16 {
                buf = array_concat(buf, [0x5B,0x58]);
                if op == 14 { buf = array_concat(buf, [0x48,0x01,0xD8]); }
                else if op == 15 { buf = array_concat(buf, [0x48,0x29,0xD8]); }
                else { buf = array_concat(buf, [0x48,0x0F,0xAF,0xC3]); }
                buf = array_concat(buf, [0x50]);
            } else if op == 17 {
                buf = array_concat(buf, [0x5B,0x58, 0x48,0x31,0xD2, 0x48,0xF7,0xF3, 0x50]);
            } else if op == 29 or op == 30 or op == 31 or op == 32 or op == 33 or op == 34 {
                buf = array_concat(buf, [0x5B,0x58, 0x48,0x39,0xD8]);
                if op == 29 { buf = array_concat(buf, [0x0F,0x94,0xC0]); }
                else if op == 30 { buf = array_concat(buf, [0x0F,0x95,0xC0]); }
                else if op == 31 { buf = array_concat(buf, [0x0F,0x9C,0xC0]); }
                else if op == 32 { buf = array_concat(buf, [0x0F,0x9E,0xC0]); }
                else if op == 33 { buf = array_concat(buf, [0x0F,0x9F,0xC0]); }
                else { buf = array_concat(buf, [0x0F,0x9D,0xC0]); }
                buf = array_concat(buf, [0x48,0x0F,0xB6,0xC0, 0x50]);
            } else if op == 63 {
                if a == 5 {
                    // to_str on int subset: no-op (println prints ints directly)
                } else if a != 1 {
                    return "";
                }
                if a == 1 {
                    buf = array_concat(buf, [0x58]);
                    let pr: str = nw_print_routine();
                    mut k: int = 0;
                    while k < str_len(pr) {
                        buf = array_concat(buf, [str_byte_at(pr, k)]);
                        k += 1;
                    }
                    buf = array_concat(buf, [0x50]);
                }
            } else if op == 7 {
                buf = array_concat(buf, [0x58]);
            } else if op == 51 or op == 52 {
                // NEW_ARRAY a (51) / NEW_RECORD b (52): pop `count` values,
                // store at bump pointer (data_vaddr), advance bump, push pointer.
                let cnt: int = op == 51 ? a : b;
                buf = array_concat(buf, [0x48,0x8B,0x14,0x25]);
                let bp: int = array_len(buf);
                buf = array_concat(buf, [0,0,0,0]);
                fx = array_concat(fx, [to_str(bp) + "|B"]);
                mut ei: int = cnt - 1;
                while ei >= 0 {
                    buf = array_concat(buf, [0x58]);
                    buf = array_concat(buf, [0x48,0x89,0x52, ei * 8]);
                    ei -= 1;
                }
                buf = array_concat(buf, [0x48,0x8D,0x4A, cnt * 8]);
                buf = array_concat(buf, [0x48,0x89,0x0C,0x25]);
                let bp2: int = array_len(buf);
                buf = array_concat(buf, [0,0,0,0]);
                fx = array_concat(fx, [to_str(bp2) + "|B"]);
                buf = array_concat(buf, [0x52]);
            } else if op == 4 {
                // CONST_NONE: push 0
                buf = array_concat(buf, [0x31,0xC0, 0x50]);
            } else if op == 54 {
                // IDX_LD: pop idx -> rbx, pop ptr -> rax, mov rax,[rax+rbx*8]
                buf = array_concat(buf, [0x5B, 0x58, 0x48,0x8B,0x04,0xD8, 0x50]);
            } else if op == 57 {
                // FIELD_LD: pop ptr -> rax, push [rax + b*8]
                buf = array_concat(buf, [0x58, 0x48,0x8B,0x40, b * 8, 0x50]);
            } else if op == 58 {
                // FIELD_ST: pop val -> rcx, pop ptr -> rax, mov [rax+b*8],rcx, push rax
                buf = array_concat(buf, [0x59, 0x58, 0x48,0x89,0x48, b * 8, 0x50]);
            } else if op == 59 {
                if fn_nparams[a] >= 2 {
                    buf = array_concat(buf, [0x5E]);
                }
                if fn_nparams[a] >= 1 {
                    buf = array_concat(buf, [0x5F]);
                }
                buf = array_concat(buf, [0xE8]);
                mut d: int = array_len(buf);
                buf = array_concat(buf, [0,0,0,0]);
                fx = array_concat(fx, [to_str(d) + "|C|" + to_str(a)]);
                buf = array_concat(buf, [0x50]);
            } else if op == 64 or op == 65 {
                if f != fn_entry {
                    if op == 64 {
                        buf = array_concat(buf, [0x58]);
                    }
                    buf = array_concat(buf, [0xC9, 0xC3]);
                }
            } else if op == 66 {
                buf = array_concat(buf, [0xE9]);
                mut d: int = array_len(buf);
                buf = array_concat(buf, [0,0,0,0]);
                fx = array_concat(fx, [to_str(d) + "|" + to_str(f) + "|" + to_str(a)]);
            } else if op == 67 {
                buf = array_concat(buf, [0x58, 0x48,0x85,0xC0, 0x0F,0x84]);
                mut d: int = array_len(buf);
                buf = array_concat(buf, [0,0,0,0]);
                fx = array_concat(fx, [to_str(d) + "|" + to_str(f) + "|" + to_str(a)]);
            } else if op == 68 {
                buf = array_concat(buf, [0x58, 0x48,0x85,0xC0, 0x0F,0x85]);
                mut d: int = array_len(buf);
                buf = array_concat(buf, [0,0,0,0]);
                fx = array_concat(fx, [to_str(d) + "|" + to_str(f) + "|" + to_str(a)]);
            } else {
                return "";
            }
            pc += 1;
        }
        pc_all = array_concat(pc_all, [pcrel]);
        f += 1;
    }

    buf = array_concat(buf, [0x48,0xC7,0xC0,0x3C,0,0,0, 0x48,0x31,0xFF, 0x0F,0x05]);

    mut fi: int = 0;
    let data_vaddr: int = 0x400078 + array_len(buf);
    while fi < array_len(fx) {
        let entry: [str] = str_split(fx[fi], "|");
        let d: int = int_from_str(entry[0]);
        if entry[1] == "B" {
            let val: int = data_vaddr;
            buf[d] = val & 255;
            buf[d + 1] = (val >> 8) & 255;
            buf[d + 2] = (val >> 16) & 255;
            buf[d + 3] = (val >> 24) & 255;
        } else if entry[1] == "V" {
            let val: int = data_vaddr + int_from_str(entry[2]) * 8;
            buf[d] = val & 255;
            buf[d + 1] = (val >> 8) & 255;
            buf[d + 2] = (val >> 16) & 255;
            buf[d + 3] = (val >> 24) & 255;
        } else if entry[1] == "D" {
            let val: int = data_vaddr;
            buf[d] = val & 255;
            buf[d + 1] = (val >> 8) & 255;
            buf[d + 2] = (val >> 16) & 255;
            buf[d + 3] = (val >> 24) & 255;
            buf[d + 4] = (val >> 32) & 255;
            buf[d + 5] = (val >> 40) & 255;
            buf[d + 6] = (val >> 48) & 255;
            buf[d + 7] = (val >> 56) & 255;
        } else {
            mut tpos: int = 0;
            if entry[1] == "C" {
                tpos = fn_start[int_from_str(entry[2])];
            } else {
                let fidx: int = int_from_str(entry[1]);
                let tp: int = int_from_str(entry[2]);
                tpos = fn_start[fidx] + pc_all[fidx][tp];
            }
            let disp: int = tpos - (d + 4);
            buf[d] = disp & 255;
            buf[d + 1] = (disp >> 8) & 255;
            buf[d + 2] = (disp >> 16) & 255;
            buf[d + 3] = (disp >> 24) & 255;
        }
        fi += 1;
    }

    mut s: str = "";
    mut bi: int = 0;
    while bi < array_len(buf) {
        s = s + str_chr_byte(buf[bi]);
        bi += 1;
    }
    let total: int = 120 + str_len(s);
    let prog_entry: int = 0x400078 + fn_start[fn_entry];
    mut data: str = nw_i64(8);
    while str_len(data) < 512 {
        data = data + str_chr_byte(0);
    }
    return nw_elf_header(total + 512, prog_entry) + s + data;
}

func nw_emit_elf_program(ops: [int], avs: [int], bs: [int], cs: [int]) -> str {
    let nins: int = array_len(ops);
    mut nlocals: int = 0;
    mut i0: int = 0;
    while i0 < nins {
        if (ops[i0] == 5 or ops[i0] == 6) and avs[i0] + 1 > nlocals {
            nlocals = avs[i0] + 1;
        }
        i0 += 1;
    }

    mut buf: [int] = [];
    mut pc_pos: [int] = [];
    mut fx: [str] = [];

    buf = array_concat(buf, [0x55, 0x48,0x89,0xE5, 0x48,0x83,0xEC,0x68]);
    let pad: int = 96 + nlocals * 8;
    buf[7] = pad & 255;

    mut pc: int = 0;
    while pc < nins {
        pc_pos = array_concat(pc_pos, [array_len(buf)]);
        let op: int = ops[pc];
        let a: int = avs[pc];
        if op == 1 {
            buf = array_concat(buf, [0x48,0xC7,0xC0]);
            buf = array_concat(buf, [a & 255, (a >> 8) & 255, (a >> 16) & 255, (a >> 24) & 255, 0x50]);
        } else if op == 5 {
            let disp: int = 256 - 8 * (a + 1);
            buf = array_concat(buf, [0x48,0x8B,0x45,disp, 0x50]);
        } else if op == 6 {
            let disp: int = 256 - 8 * (a + 1);
            buf = array_concat(buf, [0x58, 0x48,0x89,0x45,disp]);
        } else if op == 11 {
            buf = array_concat(buf, [0x58, 0x48,0xF7,0xD8, 0x50]);
        } else if op == 14 or op == 15 or op == 16 {
            buf = array_concat(buf, [0x5B,0x58]);
            if op == 14 { buf = array_concat(buf, [0x48,0x01,0xD8]); }
            else if op == 15 { buf = array_concat(buf, [0x48,0x29,0xD8]); }
            else { buf = array_concat(buf, [0x48,0x0F,0xAF,0xC3]); }
            buf = array_concat(buf, [0x50]);
        } else if op == 17 {
            buf = array_concat(buf, [0x5B,0x58, 0x48,0x31,0xD2, 0x48,0xF7,0xF3, 0x50]);
        } else if op == 29 or op == 30 or op == 31 or op == 32 or op == 33 or op == 34 {
            buf = array_concat(buf, [0x5B,0x58, 0x48,0x39,0xD8]);
            if op == 29 { buf = array_concat(buf, [0x0F,0x94,0xC0]); }
            else if op == 30 { buf = array_concat(buf, [0x0F,0x95,0xC0]); }
            else if op == 31 { buf = array_concat(buf, [0x0F,0x9C,0xC0]); }
            else if op == 32 { buf = array_concat(buf, [0x0F,0x9E,0xC0]); }
            else if op == 33 { buf = array_concat(buf, [0x0F,0x9F,0xC0]); }
            else { buf = array_concat(buf, [0x0F,0x9D,0xC0]); }
            buf = array_concat(buf, [0x48,0x0F,0xB6,0xC0, 0x50]);
        } else if op == 63 {
            if a != 1 { return ""; }
            buf = array_concat(buf, [0x58]);
            let pr: str = nw_print_routine();
            mut k: int = 0;
            while k < str_len(pr) {
                buf = array_concat(buf, [str_byte_at(pr, k)]);
                k += 1;
            }
            buf = array_concat(buf, [0x50]);
        } else if op == 7 {
            buf = array_concat(buf, [0x58]);
        } else if op == 64 or op == 65 {
            // fall through; final exit syscall terminates
        } else if op == 66 {
            buf = array_concat(buf, [0xE9]);
            mut d: int = array_len(buf);
            buf = array_concat(buf, [0,0,0,0]);
            fx = array_concat(fx, [to_str(d) + "|" + to_str(a)]);
        } else if op == 67 {
            buf = array_concat(buf, [0x58, 0x48,0x85,0xC0, 0x0F,0x84]);
            mut d: int = array_len(buf);
            buf = array_concat(buf, [0,0,0,0]);
            fx = array_concat(fx, [to_str(d) + "|" + to_str(a)]);
        } else if op == 68 {
            buf = array_concat(buf, [0x58, 0x48,0x85,0xC0, 0x0F,0x85]);
            mut d: int = array_len(buf);
            buf = array_concat(buf, [0,0,0,0]);
            fx = array_concat(fx, [to_str(d) + "|" + to_str(a)]);
        } else {
            return "";
        }
        pc += 1;
    }

    buf = array_concat(buf, [0x48,0xC7,0xC0,0x3C,0,0,0, 0x48,0x31,0xFF, 0x0F,0x05]);

    mut fi: int = 0;
    while fi < array_len(fx) {
        let entry: [str] = str_split(fx[fi], "|");
        let d: int = int_from_str(entry[0]);
        let tg: int = int_from_str(entry[1]);
        let tpos: int = tg < array_len(pc_pos) ? pc_pos[tg] : -1;
        let disp: int = tpos - (d + 4);
        buf[d] = disp & 255;
        buf[d + 1] = (disp >> 8) & 255;
        buf[d + 2] = (disp >> 16) & 255;
        buf[d + 3] = (disp >> 24) & 255;
        fi += 1;
    }

    mut s: str = "";
    mut bi: int = 0;
    while bi < array_len(buf) {
        s = s + str_chr_byte(buf[bi]);
        bi += 1;
    }
    let total: int = 120 + str_len(s);
    return nw_elf_header(total, 0x400000 + 120) + s;
}

func nw_emit_elf_repeat() -> str {
    // Micro-assembler loop: `change i=0; repeat while i<3 { show(i); i=i+1 }`.
    // Frame reserves a red zone (via +96) so the print routine's 32-byte stack
    // scratch never overlaps the local at [rbp-8].
    mut buf: [int] = [];
    mut lab_names: [str] = [];
    mut lab_pos: [int] = [];
    mut fx: [str] = [];

    buf = array_concat(buf, [0x55, 0x48,0x89,0xE5, 0x48,0x83,0xEC,0x68]);
    buf = array_concat(buf, [0x48,0xC7,0xC0,0,0,0,0, 0x50]);
    buf = array_concat(buf, [0x58, 0x48,0x89,0x45,0xF8]);

    lab_names = array_concat(lab_names, ["loop"]);
    lab_pos = array_concat(lab_pos, [array_len(buf)]);

    buf = array_concat(buf, [0x48,0x8B,0x45,0xF8, 0x50]);
    buf = array_concat(buf, [0x48,0xC7,0xC0,3,0,0,0, 0x50]);
    buf = array_concat(buf, [0x5B,0x58, 0x48,0x39,0xD8, 0x0F,0x9C,0xC0, 0x48,0x0F,0xB6,0xC0, 0x50]);
    buf = array_concat(buf, [0x58, 0x48,0x85,0xC0, 0x0F,0x84]);
    let d0: int = array_len(buf);
    buf = array_concat(buf, [0,0,0,0]);
    fx = array_concat(fx, [to_str(d0) + "|exit"]);

    buf = array_concat(buf, [0x48,0x8B,0x45,0xF8, 0x50]);
    buf = array_concat(buf, [0x58]);
    let pr: str = nw_print_routine();
    mut k: int = 0;
    while k < str_len(pr) {
        buf = array_concat(buf, [str_byte_at(pr, k)]);
        k += 1;
    }
    buf = array_concat(buf, [0x50]);
    buf = array_concat(buf, [0x58]);
    buf = array_concat(buf, [0x48,0x8B,0x45,0xF8, 0x50]);
    buf = array_concat(buf, [0x48,0xC7,0xC0,1,0,0,0, 0x50]);
    buf = array_concat(buf, [0x5B,0x58, 0x48,0x01,0xD8, 0x50]);
    buf = array_concat(buf, [0x58, 0x48,0x89,0x45,0xF8]);

    buf = array_concat(buf, [0xE9]);
    let d1: int = array_len(buf);
    buf = array_concat(buf, [0,0,0,0]);
    fx = array_concat(fx, [to_str(d1) + "|loop"]);

    lab_names = array_concat(lab_names, ["exit"]);
    lab_pos = array_concat(lab_pos, [array_len(buf)]);

    buf = array_concat(buf, [0x48,0xC7,0xC0,0x3C,0,0,0, 0x48,0x31,0xFF, 0x0F,0x05]);

    mut fi: int = 0;
    while fi < array_len(fx) {
        let entry: [str] = str_split(fx[fi], "|");
        let d: int = int_from_str(entry[0]);
        let tname: str = entry[1];
        mut tpos: int = -1;
        mut li: int = 0;
        while li < array_len(lab_names) {
            if lab_names[li] == tname { tpos = lab_pos[li]; }
            li += 1;
        }
        let disp: int = tpos - (d + 4);
        buf[d] = disp & 255;
        buf[d + 1] = (disp >> 8) & 255;
        buf[d + 2] = (disp >> 16) & 255;
        buf[d + 3] = (disp >> 24) & 255;
        fi += 1;
    }

    mut s: str = "";
    mut bi: int = 0;
    while bi < array_len(buf) {
        s = s + str_chr_byte(buf[bi]);
        bi += 1;
    }
    let total: int = 120 + str_len(s);
    return nw_elf_header(total, 0x400000 + 120) + s;
}

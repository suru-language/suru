// Natural Syntax effect bytecode lowering.
// Pass one collects instructions and symbolic labels. Pass two removes labels
// and resolves every branch/handler target to a native instruction index.

func nbc_word(line: str) -> str {
    mut i: int = 0;
    while i < str_len(line) and line[i] != " " and line[i] != "\t" { i += 1; }
    return substr(line, 0, i);
}

func nbc_after(line: str, word: str) -> str {
    return str_trim(substr(line, str_len(word), str_len(line)));
}

func nbc_find(text: str, needle: str) -> int {
    mut i: int = 0;
    while i + str_len(needle) <= str_len(text) {
        if substr(text, i, str_len(needle)) == needle { return i; }
        i += 1;
    }
    return -1;
}

func nbc_emit(instructions: [str], op: str, operands: str) -> [str] {
    let record: str = op + "|" + operands;
    // Materialize a private copy before retaining the record in the growing
    // instruction array. This keeps later source-string temporaries from
    // aliasing an instruction record during bootstrap GC.
    let stable: str = substr(record, 0, str_len(record));
    return array_concat(instructions, [stable]);
}

func nbc_has_prefix(text: str, prefix: str) -> bool {
    return str_len(text) >= str_len(prefix) and
           substr(text, 0, str_len(prefix)) == prefix;
}

func nbc_pool_index(instructions: [str], kind: str, value: str) -> int {
    let wanted: str = "#" + kind + "|" + value;
    mut i: int = 0;
    mut index: int = 0;
    while i < array_len(instructions) {
        if instructions[i] == wanted { return index; }
        if nbc_has_prefix(instructions[i], "#" + kind + "|") { index += 1; }
        i += 1;
    }
    return -1;
}

func nbc_pool_count(instructions: [str], kind: str) -> int {
    mut count: int = 0;
    mut i: int = 0;
    while i < array_len(instructions) {
        if nbc_has_prefix(instructions[i], "#" + kind + "|") { count += 1; }
        i += 1;
    }
    return count;
}

func nbc_const(instructions: [str], kind: str, op: str, value: str) -> [str] {
    mut result: [str] = instructions;
    mut index: int = nbc_pool_index(result, kind, value);
    if index < 0 {
        index = nbc_pool_count(result, kind);
        result = array_concat(result, ["#" + kind + "|" + value]);
    }
    return nbc_emit(result, op, to_str(index));
}

func nbc_intern(instructions: [str], kind: str, value: str) -> [str] {
    if nbc_pool_index(instructions, kind, value) >= 0 { return instructions; }
    return array_concat(instructions, ["#" + kind + "|" + value]);
}

func nbc_find_type(instructions: [str], name: str) -> str {
    let needle: str = "#type|" + name + "|";
    mut i: int = 0;
    while i < array_len(instructions) {
        if nbc_has_prefix(instructions[i], needle) {
            return substr(instructions[i], str_len(needle), str_len(instructions[i]));
        }
        i += 1;
    }
    return "";
}

func nbc_note_type(instructions: [str], name: str, typ: str) -> [str] {
    if typ == "" { return instructions; }
    if nbc_find_type(instructions, name) != "" { return instructions; }
    return array_concat(instructions, ["#type|" + name + "|" + typ]);
}

func nbc_slot(instructions: [str], name: str) -> int {
    let wanted: str = "#slot|" + name + "|";
    mut i: int = 0;
    while i < array_len(instructions) {
        if nbc_has_prefix(instructions[i], wanted) {
            let field: str = substr(instructions[i], str_len(wanted), str_len(instructions[i]));
            return int_from_str(field);
        }
        i += 1;
    }
    return -1;
}

func nbc_bind(instructions: [str], name: str) -> [str] {
    if nbc_slot(instructions, name) >= 0 { return instructions; }
    let index: int = 0 + nbc_pool_count(instructions, "slot");
    let marker: str = "#slot|" + name + "|" + to_str(index);
    let stable: str = substr(marker, 0, str_len(marker));
    return array_concat(instructions, [stable]);
}

func nbc_is_digit(c: str) -> bool {
    return c >= "0" and c <= "9";
}

func nbc_is_float(text: str) -> bool {
    if str_len(text) == 0 or text[0] == "\"" { return false; }
    if not (str_contains(text, ".") or str_contains(text, "e") or
            str_contains(text, "E")) { return false; }
    mut has_digit: bool = false;
    mut i: int = 0;
    while i < str_len(text) {
        if nbc_is_digit(text[i]) { has_digit = true; }
        i += 1;
    }
    return has_digit;
}

func nbc_is_text(instructions: [str], expr: str) -> bool {
    if str_len(expr) >= 2 and expr[0] == "\"" { return true; }
    return nbc_find_type(instructions, expr) == "Text";
}

func nbc_is_real(instructions: [str], expr: str) -> bool {
    if nbc_is_float(expr) { return true; }
    return nbc_find_type(instructions, expr) == "Real";
}

func nbc_is_integer(text: str) -> bool {
    if str_len(text) == 0 { return false; }
    mut i: int = 0;
    if text[0] == "-" { i = 1; }
    if i == str_len(text) { return false; }
    while i < str_len(text) {
        if not nbc_is_digit(text[i]) and text[i] != "_" { return false; }
        i += 1;
    }
    return true;
}

func nbc_outer_parens(text: str) -> str {
    if str_len(text) < 2 or text[0] != "(" or
       text[str_len(text) - 1] != ")" { return text; }
    mut depth: int = 0;
    mut i: int = 0;
    while i < str_len(text) {
        if text[i] == "(" { depth += 1; }
        if text[i] == ")" { depth -= 1; }
        if depth == 0 and i < str_len(text) - 1 { return text; }
        i += 1;
    }
    return str_trim(substr(text, 1, str_len(text) - 1));
}

func nbc_top_operator(text: str, operators: [str]) -> [str] {
    mut depth: int = 0;
    mut quote: bool = false;
    mut i: int = str_len(text) - 1;
    while i >= 0 {
        let c: str = text[i];
        if c == "\"" { quote = not quote; }
        if not quote {
            if c == ")" or c == "]" { depth += 1; }
            if c == "(" or c == "[" { depth -= 1; }
            if depth == 0 {
                mut j: int = 0;
                while j < array_len(operators) {
                    let op: str = operators[j];
                    let start: int = i - str_len(op) + 1;
                    if start >= 0 and substr(text, start, str_len(op)) == op {
                        return [to_str(start), op];
                    }
                    j += 1;
                }
            }
        }
        i -= 1;
    }
    return ["-1", ""];
}

func nbc_split_ternary(text: str) -> [str] {
    mut depth: int = 0;
    mut quote: bool = false;
    mut question: int = -1;
    mut i: int = 0;
    while i < str_len(text) {
        let c: str = text[i];
        if c == "\"" { quote = not quote; }
        if not quote {
            if c == "(" or c == "[" { depth += 1; }
            if c == ")" or c == "]" { depth -= 1; }
            if depth == 0 and c == "?" { question = i; break; }
        }
        i += 1;
    }
    if question < 0 { return ["", "", ""]; }
    let cond: str = str_trim(substr(text, 0, question));
    mut colon: int = -1;
    depth = 0;
    quote = false;
    i = question + 1;
    while i < str_len(text) {
        let c: str = text[i];
        if c == "\"" { quote = not quote; }
        if not quote {
            if c == "(" or c == "[" { depth += 1; }
            if c == ")" or c == "]" { depth -= 1; }
            if depth == 0 and c == ":" { colon = i; break; }
        }
        i += 1;
    }
    if colon < 0 { return ["", "", ""]; }
    return [cond,
            str_trim(substr(text, question + 1, colon - question - 1)),
            str_trim(substr(text, colon + 1, str_len(text)))];
}

func nbc_record_index(instructions: [str], name: str) -> int {
    let wanted: str = "#record|" + name + "|";
    mut i: int = 0;
    while i < array_len(instructions) {
        if nbc_has_prefix(instructions[i], wanted) {
            return int_from_str(substr(instructions[i], str_len(wanted),
                                       str_len(instructions[i])));
        }
        i += 1;
    }
    return -1;
}

func nbc_variant_choice(instructions: [str], variant: str) -> str {
    let needle: str = "#variant|";
    mut i: int = 0;
    while i < array_len(instructions) {
        let item: str = instructions[i];
        if nbc_has_prefix(item, needle) and str_contains(item, "|" + variant + "|") {
            let rest: str = substr(item, str_len(needle), str_len(item));
            let bar: int = nbc_find(rest, "|");
            if bar > 0 {
                let choice: str = substr(rest, 0, bar);
                return substr(choice, 0, str_len(choice));
            }
        }
        i += 1;
    }
    return "";
}

func nbc_is_variant(instructions: [str], variant: str) -> bool {
    return nbc_variant_choice(instructions, variant) != "";
}

func nbc_choice_index(instructions: [str], name: str) -> int {
    let wanted: str = "#choice|" + name + "|";
    mut i: int = 0;
    while i < array_len(instructions) {
        if nbc_has_prefix(instructions[i], wanted) {
            return int_from_str(substr(instructions[i], str_len(wanted),
                                       str_len(instructions[i])));
        }
        i += 1;
    }
    return -1;
}

func nbc_variant_nargs(instructions: [str], choice: str, variant: str) -> int {
    let prefix: str = "#variant|" + choice + "|";
    let suffix: str = "|" + variant + "|";
    mut i: int = 0;
    while i < array_len(instructions) {
        let item: str = instructions[i];
        if nbc_has_prefix(item, prefix) and str_contains(item, suffix) {
            let after_name: str = substr(item, str_len(prefix) + str_len(variant) + 1,
                                          str_len(item));
            let bar: int = nbc_find(after_name, "|");
            if bar >= 0 {
                let after_tag: str = substr(after_name, bar + 1,
                                             str_len(after_name));
                let bar2: int = nbc_find(after_tag, "|");
                let nargstext: str = bar2 < 0 ? after_tag :
                    substr(after_tag, 0, bar2);
                return int_from_str(str_trim(nargstext));
            }
        }
        i += 1;
    }
    return 0;
}

func nbc_variant_argtype(instructions: [str], choice: str, variant: str,
                         idx: int) -> str {
    let prefix: str = "#variant|" + choice + "|";
    let suffix: str = "|" + variant + "|";
    mut i: int = 0;
    while i < array_len(instructions) {
        let item: str = instructions[i];
        if nbc_has_prefix(item, prefix) and str_contains(item, suffix) {
            let rest: str = substr(item, str_len(prefix) + str_len(variant) + 1,
                                    str_len(item));
            let bar1: int = nbc_find(rest, "|");
            let rest2: str = bar1 < 0 ? "" :
                substr(rest, bar1 + 1, str_len(rest));
            let bar2: int = nbc_find(rest2, "|");
            let types: str = bar2 < 0 ? "" :
                substr(rest2, bar2 + 1, str_len(rest2));
            if types == "" { return "Whole"; }
            let tlist: [str] = str_split(types, ",");
            if idx >= 0 and idx < array_len(tlist) {
                return str_trim(tlist[idx]);
            }
            return "Whole";
        }
        i += 1;
    }
    return "Whole";
}

func nbc_variant_tag(instructions: [str], choice: str, variant: str) -> int {
    let prefix: str = "#variant|" + choice + "|";
    let suffix: str = "|" + variant + "|";
    mut i: int = 0;
    while i < array_len(instructions) {
        let item: str = instructions[i];
        if nbc_has_prefix(item, prefix) and str_contains(item, suffix) {
            let rest: str = substr(item, str_len(prefix), str_len(item));
            let rest2: str = substr(rest, str_len(variant) + 1, str_len(rest));
            let bar: int = nbc_find(rest2, "|");
            let tagtext: str = bar < 0 ? rest2 :
                substr(rest2, 0, bar);
            return int_from_str(str_trim(tagtext));
        }
        i += 1;
    }
    return -1;
}

func nbc_register_known_choices(instructions: [str]) -> [str] {
    mut result: [str] = instructions;
    let known: [str] = ["Option", "Result"];
    mut ki: int = 0;
    while ki < array_len(known) {
        let cname: str = known[ki];
        if nbc_choice_index(result, cname) >= 0 { ki += 1; continue; }
        let cidx: int = nbc_pool_count(result, "choice");
        result = array_concat(result, ["#choice|" + cname + "|" + to_str(cidx)]);
        if cname == "Option" {
            result = array_concat(result, ["#variant|Option|none|0|0|"]);
            result = array_concat(result, ["#variant|Option|Some|1|1|Whole"]);
        } else {
            result = array_concat(result, ["#variant|Result|ok|0|1|Whole"]);
            result = array_concat(result, ["#variant|Result|error|1|1|Whole"]);
        }
        ki += 1;
    }
    return result;
}

func nbc_collect_choices(instructions: [str], lines: [str]) -> [str] {
    mut result: [str] = nbc_register_known_choices(instructions);
    mut i: int = 0;
    while i < array_len(lines) {
        let line: str = str_trim(lines[i]);
        if nbc_word(line) != "choice" { i += 1; continue; }
        let raw_cname: str = str_trim(nbc_after(line, "choice"));
        let cname: str = substr(raw_cname, 0, str_len(raw_cname));
        if nbc_choice_index(result, cname) >= 0 { i += 1; continue; }
        let cidx: int = nbc_pool_count(result, "choice");
        result = array_concat(result, ["#choice|" + cname + "|" + to_str(cidx)]);
        mut tag: int = 0;
        i += 1;
        while i < array_len(lines) {
            let raw_vl: str = str_trim(lines[i]);
            let vl: str = substr(raw_vl, 0, str_len(raw_vl));
            if vl == "end choice" { i += 1; break; }
            if vl == "" or nbc_word(vl) == "//" { i += 1; continue; }
            let vopen: int = nbc_find(vl, "(");
            let vname: str = vopen < 0 ? vl : str_trim(substr(vl, 0, vopen));
            let vclose: int = nbc_find(vl, ")");
            mut vnargs: int = 0;
            mut vtypes: str = "";
            if vopen >= 0 and vclose > vopen {
                let vparams: str = str_trim(substr(vl, vopen + 1,
                                                    vclose - vopen - 1));
                if vparams != "" {
                    let ptags: [str] = str_split(vparams, ",");
                    vnargs = array_len(ptags);
                    mut ti: int = 0;
                    while ti < array_len(ptags) {
                        let pt: str = str_trim(ptags[ti]);
                        let pcolon: int = nbc_find(pt, ":");
                        let ptype: str = pcolon < 0 ? "Whole" :
                            str_trim(substr(pt, pcolon + 1, str_len(pt)));
                        vtypes = vtypes + ptype;
                        if ti + 1 < array_len(ptags) { vtypes = vtypes + ","; }
                        ti += 1;
                    }
                }
            }
            result = array_concat(result,
                ["#variant|" + cname + "|" + vname + "|" + to_str(tag) +
                 "|" + to_str(vnargs) + "|" + vtypes]);
            tag += 1;
            i += 1;
        }
    }
    return result;
}

func nbc_record_nfields(instructions: [str], record: str) -> int {
    let prefix: str = "#field|" + record + "|";
    mut count: int = 0;
    mut i: int = 0;
    while i < array_len(instructions) {
        if nbc_has_prefix(instructions[i], prefix) { count += 1; }
        i += 1;
    }
    return count;
}

func nbc_field_index(instructions: [str], record: str, field: str) -> int {
    let wanted: str = "#field|" + record + "|" + field + "|";
    mut i: int = 0;
    while i < array_len(instructions) {
        if nbc_has_prefix(instructions[i], wanted) {
            return int_from_str(substr(instructions[i], str_len(wanted),
                                       str_len(instructions[i])));
        }
        i += 1;
    }
    return -1;
}

func nbc_collect_records(instructions: [str], lines: [str]) -> [str] {
    mut result: [str] = instructions;
    mut i: int = 0;
    while i < array_len(lines) {
        let line: str = str_trim(lines[i]);
        if nbc_word(line) != "record" { i += 1; continue; }
        let rname: str = str_trim(nbc_after(line, "record"));
        if nbc_record_index(result, rname) >= 0 { i += 1; continue; }
        let ridx: int = nbc_pool_count(result, "record");
        result = array_concat(result, ["#record|" + rname + "|" + to_str(ridx)]);
        mut field_idx: int = 0;
        i += 1;
        while i < array_len(lines) {
            let fl: str = str_trim(lines[i]);
            if fl == "end record" { i += 1; break; }
            if fl == "" or nbc_word(fl) == "//" { i += 1; continue; }
            if nbc_word(fl) == "routine" {
                i += 1;
                while i < array_len(lines) and str_trim(lines[i]) != "end routine" { i += 1; }
                i += 1;
                continue;
            }
            mut fbody: str = fl;
            if nbc_word(fbody) == "change" { fbody = nbc_after(fbody, "change"); }
            let fcolon: int = nbc_find(fbody, ":");
            if fcolon > 0 {
                let fname: str = str_trim(substr(fbody, 0, fcolon));
                result = array_concat(result,
                    ["#field|" + rname + "|" + fname + "|" + to_str(field_idx)]);
                field_idx += 1;
            }
            i += 1;
        }
    }
    return result;
}

func nbc_find_postfix(expression: str, open: str, close: str) -> [str] {
    mut depth: int = 0;
    mut quote: bool = false;
    mut i: int = 0;
    while i < str_len(expression) {
        let c: str = expression[i];
        if c == "\"" { quote = not quote; }
        if not quote {
            if c == open and depth == 0 {
                let inner: str = substr(expression, i + 1,
                                        str_len(expression) - i - 2);
                return [to_str(i), str_trim(substr(expression, 0, i)),
                        str_trim(inner)];
            }
            if c == open { depth += 1; }
            if c == close { depth -= 1; }
        }
        i += 1;
    }
    return ["-1", "", ""];
}

func nbc_emit_arguments(instructions: [str], text: str) -> [str] {
    mut result: [str] = instructions;
    let comma = nbc_top_operator(text, [","]);
    if int_from_str(comma[0]) >= 0 {
        let at: int = int_from_str(comma[0]);
        result = nbc_emit_arguments(result, substr(text, 0, at));
        return nbc_emit_arguments(result,
            substr(text, at + 1, str_len(text)));
    }
    return nbc_emit_expression(result, text);
}

func nbc_builtin_index(name: str) -> int {
    if name == "print" { return 0; }
    if name == "println" { return 1; }
    if name == "str_len" { return 2; }
    if name == "array_len" { return 3; }
    if name == "to_str" { return 5; }
    if name == "read_line" { return 4; }
    if name == "substr" { return 11; }
    if name == "str_contains" { return 12; }
    if name == "str_compare" { return 35; }
    if name == "str_trim" { return 25; }
    if name == "args" { return 27; }
    if name == "read_file" { return 57; }
    if name == "exit" { return 20; }
    return -1;
}

func nbc_func_index(instructions: [str], name: str) -> int {
    let wanted: str = "#func|" + name + "|";
    mut i: int = 0;
    while i < array_len(instructions) {
        if nbc_has_prefix(instructions[i], wanted) {
            return int_from_str(substr(instructions[i], str_len(wanted),
                                       str_len(instructions[i])));
        }
        i += 1;
    }
    return -1;
}

func nbc_collect_functions(instructions: [str], lines: [str]) -> [str] {
    mut result: [str] = instructions;
    mut i: int = 0;
    while i < array_len(lines) {
        let line: str = str_trim(lines[i]);
        let word: str = nbc_word(line);
        let routine: str = word == "routine" ? line :
            (word == "expose" and nbc_word(nbc_after(line, "expose")) == "routine"
             ? nbc_after(line, "expose") : "");
        if routine != "" {
            let rest: str = nbc_after(routine, "routine");
            let open: int = nbc_find(rest, "(");
            if open > 0 {
                let name: str = str_trim(substr(rest, 0, open));
                if nbc_func_index(result, name) < 0 {
                    result = array_concat(result, ["#func|" + name + "|" +
                        to_str(nbc_pool_count(result, "func"))]);
                }
            }
        }
        i += 1;
    }
    return result;
}

func nbc_emit_expression(instructions: [str], expression: str) -> [str] {
    mut result: [str] = instructions;
    mut text: str = str_trim(nbc_outer_parens(str_trim(expression)));
    let ternary = nbc_split_ternary(text);
    if ternary[0] != "" {
        let base: int = array_len(result);
        let else_label: str = "ternary-else-" + to_str(base);
        let end_label: str = "ternary-end-" + to_str(base + 1);
        result = nbc_emit_expression(result, ternary[0]);
        result = nbc_emit(result, "BC_JZ", "@" + else_label);
        result = nbc_emit_expression(result, ternary[1]);
        result = nbc_emit(result, "BC_JMP", "@" + end_label);
        result = nbc_label(result, else_label);
        result = nbc_emit_expression(result, ternary[2]);
        result = nbc_label(result, end_label);
        return result;
    }
    let logical = nbc_top_operator(text, [" or ", " and "]);
    if int_from_str(logical[0]) >= 0 {
        let at: int = int_from_str(logical[0]);
        let op: str = logical[1];
        result = nbc_emit_expression(result, substr(text, 0, at));
        result = nbc_emit_expression(result,
            substr(text, at + str_len(op), str_len(text)));
        return nbc_emit(result, op == " and " ? "BC_BIT_AND" : "BC_BIT_OR", "");
    }
    let comparison = nbc_top_operator(text, [" == ", " != ", " <= ", " >= ", " < ", " > "]);
    if int_from_str(comparison[0]) >= 0 {
        let at: int = int_from_str(comparison[0]);
        let op: str = comparison[1];
        let left: str = str_trim(substr(text, 0, at));
        let right: str = str_trim(substr(text, at + str_len(op), str_len(text)));
        result = nbc_emit_expression(result, left);
        result = nbc_emit_expression(result, right);
        mut suffix: str = "I";
        if nbc_is_text(result, left) and nbc_is_text(result, right) {
            suffix = "S";
        } else if nbc_is_real(result, left) or nbc_is_real(result, right) {
            suffix = "F";
        }
        mut byte_op: str = "BC_EQ_" + suffix;
        if op == " != " { byte_op = "BC_NE_" + suffix; }
        if op == " < " { byte_op = "BC_LT_" + suffix; }
        if op == " <= " { byte_op = "BC_LE_" + suffix; }
        if op == " > " { byte_op = "BC_GT_" + suffix; }
        if op == " >= " { byte_op = "BC_GE_" + suffix; }
        return nbc_emit(result, byte_op, "");
    }
    let arithmetic = nbc_top_operator(text, [" + ", " - "]);
    if int_from_str(arithmetic[0]) >= 0 {
        let at: int = int_from_str(arithmetic[0]);
        let op: str = arithmetic[1];
        let left: str = str_trim(substr(text, 0, at));
        let right: str = str_trim(substr(text, at + str_len(op), str_len(text)));
        result = nbc_emit_expression(result, left);
        result = nbc_emit_expression(result, right);
        mut byte_op: str = "BC_ADD_I";
        if op == " - " {
            if nbc_is_real(result, left) or nbc_is_real(result, right) {
                byte_op = "BC_SUB_F";
            } else {
                byte_op = "BC_SUB_I";
            }
        } else if nbc_is_text(result, left) or nbc_is_text(result, right) {
            byte_op = "BC_CONCAT_S";
        } else if nbc_is_real(result, left) or nbc_is_real(result, right) {
            byte_op = "BC_ADD_F";
        }
        return nbc_emit(result, byte_op, "");
    }
    let multiplicative = nbc_top_operator(text, [" * ", " / ", " % "]);
    if int_from_str(multiplicative[0]) >= 0 {
        let at: int = int_from_str(multiplicative[0]);
        let op: str = multiplicative[1];
        let left: str = str_trim(substr(text, 0, at));
        let right: str = str_trim(substr(text, at + str_len(op), str_len(text)));
        result = nbc_emit_expression(result, left);
        result = nbc_emit_expression(result, right);
        mut byte_op: str = "BC_MUL_I";
        let real_case: bool = nbc_is_real(result, left) or nbc_is_real(result, right);
        if op == " / " { byte_op = real_case ? "BC_DIV_F" : "BC_DIV_I"; }
        else if op == " % " { byte_op = "BC_MOD_I"; }
        else if real_case { byte_op = "BC_MUL_F"; }
        return nbc_emit(result, byte_op, "");
    }
    if nbc_has_prefix(text, "-") {
        let operand: str = substr(text, 1, str_len(text));
        result = nbc_emit_expression(result, operand);
        if nbc_is_float(operand) { return nbc_emit(result, "BC_NEG_F", ""); }
        return nbc_emit(result, "BC_NEG_I", "");
    }
    if nbc_has_prefix(text, "not ") {
        result = nbc_emit_expression(result, substr(text, 4, str_len(text)));
        return nbc_emit(result, "BC_NOT", "");
    }
    if nbc_has_prefix(text, "~") {
        result = nbc_emit_expression(result, substr(text, 1, str_len(text)));
        return nbc_emit(result, "BC_BIT_NOT", "");
    }
    if str_contains(text, ".") {
        let dot: int = nbc_find(text, ".");
        if dot > 0 {
            let base: str = str_trim(substr(text, 0, dot));
            let field: str = str_trim(substr(text, dot + 1, str_len(text)));
            let base_type: str = nbc_find_type(result, base);
            if base_type != "" {
                let recidx: int = nbc_record_index(result, base_type);
                if recidx >= 0 {
                    let fidx: int = nbc_field_index(result, base_type, field);
                    if fidx >= 0 {
                        result = nbc_emit_expression(result, base);
                        return nbc_emit(result, "BC_FIELD_LD",
                                        to_str(recidx) + "|" + to_str(fidx));
                    }
                }
            }
        }
    }
    if str_len(text) >= 2 and text[0] == "[" and text[str_len(text) - 1] == "]" {
        let inner: str = substr(text, 1, str_len(text) - 2);
        if inner == "" { return nbc_emit(result, "BC_NEW_ARRAY", "0"); }
        let elems: [str] = str_split(inner, ",");
        let count: int = array_len(elems);
        mut ei: int = 0;
        while ei < count {
            result = nbc_emit_expression(result, str_trim(elems[ei]));
            ei += 1;
        }
        return nbc_emit(result, "BC_NEW_ARRAY", to_str(count));
    }
    if str_contains(text, "[") {
        let bracket = nbc_find_postfix(text, "[", "]");
        if int_from_str(bracket[0]) >= 0 and bracket[1] != "" {
            result = nbc_emit_expression(result, bracket[1]);
            result = nbc_emit_expression(result, bracket[2]);
            return nbc_emit(result, "BC_IDX_LD", "");
        }
    }
    let open: int = nbc_find(text, "(");
    if open > 0 and text[str_len(text) - 1] == ")" {
        let callee: str = str_trim(substr(text, 0, open));
        let argument_text: str = str_trim(substr(text, open + 1,
                                                  str_len(text) - open - 2));
        if nbc_is_variant(result, callee) {
            let vchoice: str = nbc_variant_choice(result, callee);
            let vtag: int = nbc_variant_tag(result, vchoice, callee);
            let vnargs: int = nbc_variant_nargs(result, vchoice, callee);
            result = nbc_const(result, "int", "BC_CONST_INT", to_str(vtag));
            if argument_text != "" {
                result = nbc_emit_arguments(result, argument_text);
            }
            return nbc_emit(result, "BC_NEW_ARRAY", to_str(vnargs + 1));
        }
        if argument_text != "" {
            result = nbc_emit_arguments(result, argument_text);
        }
        let builtin: int = nbc_builtin_index(callee);
        if builtin >= 0 { return nbc_emit(result, "BC_BUILTIN", to_str(builtin)); }
        let function: int = nbc_func_index(result, callee);
        if function >= 0 { return nbc_emit(result, "BC_CALL", to_str(function)); }
        return nbc_emit(result, "BC_TRAP", "unknown call: " + callee);
    }
    if nbc_is_integer(text) {
        return nbc_const(result, "int", "BC_CONST_INT", text);
    }
    if nbc_is_float(text) {
        return nbc_const(result, "float", "BC_CONST_FLOAT", text);
    }
    if text == "true" or text == "false" {
        return nbc_const(result, "int", "BC_CONST_INT", text == "true" ? "1" : "0");
    }
    if text == "none" {
        return nbc_emit(result, "BC_CONST_NONE", "");
    }
    if str_len(text) >= 2 and text[0] == "\"" and text[str_len(text) - 1] == "\"" {
        return nbc_const(result, "str", "BC_CONST_STR", text);
    }
    if nbc_is_variant(instructions, text) {
        let tag: int = nbc_variant_tag(instructions,
            nbc_variant_choice(instructions, text), text);
        return nbc_const(result, "int", "BC_CONST_INT", to_str(tag));
    }
    let slot: int = nbc_slot(instructions, text);
    if slot >= 0 { return nbc_emit(result, "BC_LD_LOCAL", to_str(slot)); }
    return nbc_emit(result, "BC_TRAP", "unknown expression: " + text);
}

func nbc_expression_statement(instructions: [str], line: str) -> [str] {
    mut result: [str] = instructions;
    if nbc_has_prefix(line, "show(") and line[str_len(line) - 1] == ")" {
        let value: str = substr(line, 5, str_len(line) - 6);
        result = nbc_emit_expression(result, value);
        result = nbc_emit(result, "BC_BUILTIN", "1");
        return nbc_emit(result, "BC_POP", "");
    }
    return nbc_emit_expression(result, line);
}

func nbc_next_handler_type(lines: [str], start: int) -> str {
    mut i: int = start;
    while i < array_len(lines) {
        let candidate: str = str_trim(lines[i]);
        if nbc_word(candidate) == "handle" {
            let rest: str = nbc_after(candidate, "handle");
            let colon: int = nbc_find(rest, ":");
            if colon >= 0 {
                return str_trim(substr(rest, colon + 1, str_len(rest)));
            }
        }
        if candidate == "end attempt" { return ""; }
        i += 1;
    }
    return "";
}

func nbc_label(instructions: [str], name: str) -> [str] {
    let label: str = "@" + name;
    let stable: str = substr(label, 0, str_len(label));
    return array_concat(instructions, [stable]);
}

func nbc_lookup_label(labels: [str], positions: [int], name: str) -> int {
    mut i: int = 0;
    while i < array_len(labels) {
        if labels[i] == name { return positions[i]; }
        i += 1;
    }
    return -1;
}

func nbc_resolve_operand(operand: str, labels: [str], positions: [int]) -> str {
    if str_len(operand) > 0 and operand[0] == "@" {
        let name: str = substr(operand, 1, str_len(operand));
        return to_str(nbc_lookup_label(labels, positions, name));
    }
    return operand;
}

func nbc_render_section(instructions: [str], start: int, end: int) {
    mut labels: [str] = [];
    mut positions: [int] = [];
    mut pc: int = 0;
    mut i: int = start;
    while i < end {
        let item: str = instructions[i];
        if str_len(item) > 0 and item[0] == "@" {
            labels = array_concat(labels, [substr(item, 1, str_len(item))]);
            positions = array_concat(positions, [pc]);
        } else if str_len(item) > 0 and item[0] != "#" {
            pc += 1;
        }
        i += 1;
    }
    pc = 0;
    i = start;
    while i < end {
        let item: str = instructions[i];
        if str_len(item) == 0 or item[0] == "@" or item[0] == "#" {
            i += 1;
            continue;
        }
        let separator: int = nbc_find(item, "|");
        let op: str = separator < 0 ? item : substr(item, 0, separator);
        mut rendered: str = separator < 0 ? "" :
            substr(item, separator + 1, str_len(item));
        let operand_separator: int = nbc_find(rendered, "|");
        if operand_separator >= 0 {
            let first: str = substr(rendered, 0, operand_separator);
            let rest: str = substr(rendered, operand_separator + 1,
                                   str_len(rendered));
            rendered = nbc_resolve_operand(first, labels, positions) + "|" + rest;
        } else if rendered != "" {
            rendered = nbc_resolve_operand(rendered, labels, positions);
        }
        println("bc|" + to_str(pc) + "|" + op + "|" + rendered);
        pc += 1;
        i += 1;
    }
}

func nbc_render(instructions: [str]) -> int {
    mut pool_index: int = 0;
    mut i: int = 0;
    while i < array_len(instructions) {
        let item: str = instructions[i];
        if nbc_has_prefix(item, "#int|") {
            println("pool|int|" + to_str(pool_index) + "|" +
                    substr(item, 5, str_len(item)));
            pool_index += 1;
        }
        i += 1;
    }
    pool_index = 0;
    i = 0;
    while i < array_len(instructions) {
        let item: str = instructions[i];
        if nbc_has_prefix(item, "#float|") {
            println("pool|float|" + to_str(pool_index) + "|" +
                    substr(item, 7, str_len(item)));
            pool_index += 1;
        }
        i += 1;
    }
    pool_index = 0;
    i = 0;
    while i < array_len(instructions) {
        let item: str = instructions[i];
        if nbc_has_prefix(item, "#str|") {
            println("pool|str|" + to_str(pool_index) + "|" +
                    substr(item, 5, str_len(item)));
            pool_index += 1;
        }
        i += 1;
    }

    mut rec_idx: int = 0;
    i = 0;
    while i < array_len(instructions) {
        let item: str = instructions[i];
        if nbc_has_prefix(item, "#record|") {
            let rline: str = substr(item, 8, str_len(item));
            let bar: int = nbc_find(rline, "|");
            let rname: str = bar < 0 ? rline : substr(rline, 0, bar);
            let nfields: int = nbc_record_nfields(instructions, rname);
            println("record|" + to_str(rec_idx) + "|" + rname + "|" +
                    to_str(nfields));
            rec_idx += 1;
        }
        i += 1;
    }

    mut current_name: str = "";
    mut section_start: int = 0;
    i = 0;
    while i < array_len(instructions) {
        let item: str = instructions[i];
        if nbc_has_prefix(item, "#funcbody|") {
            let header: str = substr(item, 10, str_len(item));
            let bar: int = nbc_find(header, "|");
            let name: str = bar < 0 ? header : substr(header, 0, bar);
            let nparams: str = bar < 0 ? "0" :
                substr(header, bar + 1, str_len(header));
            if current_name != "" {
                nbc_render_section(instructions, section_start, i);
                println("funcend|" + current_name);
            }
            current_name = name;
            section_start = i + 1;
            println("funcstart|" + name + "|" + nparams);
        }
        i += 1;
    }
    if current_name != "" {
        nbc_render_section(instructions, section_start, array_len(instructions));
        println("funcend|" + current_name);
    } else if array_len(instructions) > 0 {
        println("funcstart|main");
        nbc_render_section(instructions, 0, array_len(instructions));
        println("funcend|main");
    }
    return 0;
}

func nbc_collect(source: str) -> [str] {
    let lines: [str] = str_split(source, "\n");
    mut instructions: [str] = [];
    instructions = nbc_collect_functions(instructions, lines);
    instructions = nbc_collect_records(instructions, lines);
    instructions = nbc_collect_choices(instructions, lines);
    mut attempts: [str] = [];
    mut controls: [str] = [];
    mut labels: int = 0;
    mut i: int = 0;
    while i < array_len(lines) {
        let line: str = str_trim(lines[i]);
        mut next_line: str = "";
        mut look: int = i + 1;
        while look < array_len(lines) and str_trim(lines[look]) == "" { look += 1; }
        if look < array_len(lines) { next_line = str_trim(lines[look]); }
        i += 1;
        if line == "" or nbc_word(line) == "//" or nbc_word(line) == "#!" { continue; }

        if nbc_word(line) == "routine" or
           (nbc_word(line) == "expose" and nbc_word(nbc_after(line, "expose")) == "routine") {
            let rline: str = (nbc_word(line) == "expose") ?
                nbc_after(line, "expose") : line;
            let rr: str = nbc_after(rline, "routine");
            let ro: int = nbc_find(rr, "(");
            if ro > 0 {
                let rname: str = str_trim(substr(rr, 0, ro));
                let rclose: int = nbc_find(rr, ")");
                let params: str = str_trim(substr(rr, ro + 1, rclose - ro - 1));
                mut nparams: int = 0;
                if params != "" { nparams = array_len(str_split(params, ",")); }
                instructions = array_concat(instructions,
                    ["#funcbody|" + rname + "|" + to_str(nparams)]);
                if params != "" {
                    let plist: [str] = str_split(params, ",");
                    mut pidx: int = 0;
                    while pidx < array_len(plist) {
                        let part: str = str_trim(plist[pidx]);
                        let pcolon: int = nbc_find(part, ":");
                        if pcolon > 0 {
                            let pname: str = str_trim(substr(part, 0, pcolon));
                            let ptype: str = str_trim(substr(part, pcolon + 1,
                                                               str_len(part)));
                            instructions = nbc_bind(instructions, pname);
                            instructions = nbc_note_type(instructions, pname, ptype);
                        }
                        pidx += 1;
                    }
                }
            }
            continue;
        }
        if nbc_word(line) == "record" {
            while i < array_len(lines) and str_trim(lines[i]) != "end record" { i += 1; }
            if i < array_len(lines) { i += 1; }
            continue;
        }
        if nbc_word(line) == "choice" {
            while i < array_len(lines) and str_trim(lines[i]) != "end choice" { i += 1; }
            if i < array_len(lines) { i += 1; }
            continue;
        }
        if nbc_word(line) == "choose" {
            let sel: str = "choose-sel-" + to_str(labels);
            let finish: str = "choose-end-" + to_str(labels);
            labels += 1;
            instructions = nbc_bind(instructions, sel);
            instructions = nbc_emit_expression(instructions, nbc_after(line, "choose"));
            instructions = nbc_emit(instructions, "BC_ST_LOCAL",
                                    to_str(nbc_slot(instructions, sel)));
            let c0: str = "choose|" + sel + "|" + finish + "|";
            controls = array_concat(controls, [substr(c0, 0, str_len(c0))]);
            continue;
        }
        if nbc_word(line) == "case" {
            if array_len(controls) == 0 {
                println("bytecode-error|case outside choose");
                return ["#emit-failed"];
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if current[0] != "choose" {
                println("bytecode-error|case outside choose");
                return ["#emit-failed"];
            }
            let ctrl_kind: str = substr(current[0], 0, str_len(current[0]));
            let sel_name: str = substr(current[1], 0, str_len(current[1]));
            let prev_next: str = current[3] == "" ? "" :
                substr(current[3], 0, str_len(current[3]));
            let finish_name: str = substr(current[2], 0, str_len(current[2]));
            if prev_next != "" {
                instructions = nbc_emit(instructions, "BC_JMP", "@" + finish_name);
                instructions = nbc_label(instructions, prev_next);
            }
            let raw_variant: str = str_trim(nbc_after(line, "case"));
            let vopen: int = nbc_find(raw_variant, "(");
            let vclose: int = nbc_find(raw_variant, ")");
            let vname: str = vopen < 0 ? raw_variant :
                str_trim(substr(raw_variant, 0, vopen));
            let vbind: str = vopen >= 0 and vclose > vopen ?
                str_trim(substr(raw_variant, vopen + 1, vclose - vopen - 1)) : "";
            let variant: str = substr(vname, 0, str_len(vname));
            let choice: str = nbc_variant_choice(instructions, variant);
            let tag: int = nbc_variant_tag(instructions, choice, variant);
            let vnargs: int = nbc_variant_nargs(instructions, choice, variant);
            let next: str = "choose-next-" + to_str(labels);
            labels += 1;
            let sel_slot: int = nbc_slot(instructions, sel_name);
            let known_choice: bool = choice == "Option" or choice == "Result";
            if vnargs > 0 or known_choice {
                instructions = nbc_emit(instructions, "BC_LD_LOCAL",
                                        to_str(sel_slot));
                instructions = nbc_const(instructions, "int", "BC_CONST_INT", "0");
                instructions = nbc_emit(instructions, "BC_IDX_LD", "");
            } else {
                instructions = nbc_emit(instructions, "BC_LD_LOCAL",
                                        to_str(sel_slot));
            }
            instructions = nbc_const(instructions, "int", "BC_CONST_INT",
                                     to_str(tag));
            instructions = nbc_emit(instructions, "BC_EQ_I", "");
            instructions = nbc_emit(instructions, "BC_JZ", "@" + next);
            if vbind != "" and vnargs > 0 {
                instructions = nbc_bind(instructions, vbind);
                instructions = nbc_note_type(instructions, vbind,
                    nbc_variant_argtype(instructions, choice, variant, 0));
                instructions = nbc_emit(instructions, "BC_LD_LOCAL",
                                        to_str(sel_slot));
                instructions = nbc_const(instructions, "int", "BC_CONST_INT", "1");
                instructions = nbc_emit(instructions, "BC_IDX_LD", "");
                instructions = nbc_emit(instructions, "BC_ST_LOCAL",
                                        to_str(nbc_slot(instructions, vbind)));
            }
            let entry: str = ctrl_kind + "|" + sel_name + "|" +
                finish_name + "|" + next;
            controls[array_len(controls) - 1] = substr(entry, 0, str_len(entry));
            continue;
        }
        if line == "end choose" {
            if array_len(controls) == 0 {
                println("bytecode-error|end choose without choose");
                return ["#emit-failed"];
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if current[0] != "choose" {
                println("bytecode-error|mismatched choose terminator");
                return ["#emit-failed"];
            }
            if current[3] != "" {
                instructions = nbc_label(instructions, current[3]);
            }
            instructions = nbc_label(instructions, current[2]);
            controls = slice(controls, 0, array_len(controls) - 1);
            continue;
        }
        if nbc_word(line) == "repeat" {
            let repeat_rest: str = nbc_after(line, "repeat");
            if nbc_word(repeat_rest) != "while" {
                println("bytecode-error|repeat requires 'while'");
                return ["#emit-failed"];
            }
            let body: str = "repeat-body" + to_str(labels);
            let finish: str = "repeat-end" + to_str(labels);
            labels += 1;
            controls = array_concat(controls, ["repeat|" + body + "|" + finish]);
            instructions = nbc_label(instructions, body);
            instructions = nbc_emit_expression(instructions,
                nbc_after(repeat_rest, "while"));
            instructions = nbc_emit(instructions, "BC_JZ", "@" + finish);
            continue;
        }
        if nbc_word(line) == "when" {
            let finish: str = "when-end" + to_str(labels);
            let next: str = "when-next" + to_str(labels);
            labels += 1;
            controls = array_concat(controls, ["when|" + finish + "|" + next + "|0"]);
            instructions = nbc_emit_expression(instructions, nbc_after(line, "when"));
            instructions = nbc_emit(instructions, "BC_JZ", "@" + next);
            continue;
        }
        if line == "otherwise" or nbc_has_prefix(line, "otherwise when ") {
            if array_len(controls) == 0 {
                println("bytecode-error|otherwise outside when");
                return ["#emit-failed"];
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if current[0] != "when" {
                println("bytecode-error|otherwise outside when");
                return ["#emit-failed"];
            }
            instructions = nbc_emit(instructions, "BC_JMP", "@" + current[1]);
            instructions = nbc_label(instructions, current[2]);
            if line == "otherwise" {
                controls[array_len(controls) - 1] = current[0] + "|" +
                    current[1] + "||2";
            } else {
                let next: str = "when-next" + to_str(labels);
                labels += 1;
                instructions = nbc_emit_expression(instructions,
                    nbc_after(nbc_after(line, "otherwise"), "when"));
                instructions = nbc_emit(instructions, "BC_JZ", "@" + next);
                controls[array_len(controls) - 1] = current[0] + "|" +
                    current[1] + "|" + next + "|1";
            }
            continue;
        }
        if line == "end repeat" {
            if array_len(controls) == 0 {
                println("bytecode-error|end repeat without repeat");
                return ["#emit-failed"];
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if current[0] != "repeat" {
                println("bytecode-error|mismatched repeat terminator");
                return ["#emit-failed"];
            }
            instructions = nbc_emit(instructions, "BC_JMP", "@" + current[1]);
            instructions = nbc_label(instructions, current[2]);
            controls = slice(controls, 0, array_len(controls) - 1);
            continue;
        }
        if line == "end when" {
            if array_len(controls) == 0 {
                println("bytecode-error|end when without when");
                return ["#emit-failed"];
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if current[0] != "when" {
                println("bytecode-error|mismatched when terminator");
                return ["#emit-failed"];
            }
            if current[3] == "0" {
                instructions = nbc_label(instructions, current[2]);
            }
            instructions = nbc_label(instructions, current[1]);
            controls = slice(controls, 0, array_len(controls) - 1);
            continue;
        }
        if line == "attempt" {
            let handler: str = "handler" + to_str(labels);
            let cleanup: str = "cleanup" + to_str(labels);
            let finish: str = "finish" + to_str(labels);
            labels += 1;
            // handler|cleanup|finish|phase (0=body, 1=handler, 2=cleanup)
            attempts = array_concat(attempts, [handler + "|" + cleanup + "|" + finish + "|0"]);
            let handler_type: str = nbc_next_handler_type(lines, i);
            mut handler_operand: str = "4294967295";
            if handler_type != "" {
                instructions = nbc_intern(instructions, "str", handler_type);
                handler_operand = to_str(nbc_pool_index(instructions, "str", handler_type));
            }
            instructions = nbc_emit(instructions, "BC_PUSH_HANDLER",
                                    "@" + handler + "|" + handler_operand);
            continue;
        }
        if nbc_word(line) == "handle" {
            if array_len(attempts) == 0 { println("bytecode-error|handle outside attempt"); return ["#emit-failed"]; }
            let fields: [str] = str_split(attempts[array_len(attempts) - 1], "|");
            instructions = nbc_emit(instructions, "BC_POP_HANDLER", "");
            instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[1]);
            let handler_rest: str = nbc_after(line, "handle");
            let colon: int = nbc_find(handler_rest, ":");
            let binding: str = str_trim(substr(handler_rest, 0, colon));
            let effect: str = str_trim(substr(handler_rest, colon + 1,
                                              str_len(handler_rest)));
            instructions = nbc_label(instructions, fields[0]);
            if binding != "" {
                instructions = nbc_bind(instructions, binding);
                instructions = nbc_emit(instructions, "BC_ST_LOCAL",
                                        to_str(nbc_slot(instructions, binding)));
            } else {
                instructions = nbc_emit(instructions, "BC_POP", "");
            }
            instructions = nbc_emit(instructions, "BC_NOP", "handler:" + effect);
            attempts[array_len(attempts) - 1] = fields[0] + "|" + fields[1] + "|" + fields[2] + "|1";
            continue;
        }
        if line == "ensure" {
            if array_len(attempts) == 0 { println("bytecode-error|ensure outside attempt"); return ["#emit-failed"]; }
            let fields: [str] = str_split(attempts[array_len(attempts) - 1], "|");
            if fields[3] == "1" {
                instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[1]);
            }
            instructions = nbc_label(instructions, fields[1]);
            instructions = nbc_emit(instructions, "BC_NOP", "cleanup");
            attempts[array_len(attempts) - 1] = fields[0] + "|" + fields[1] + "|" + fields[2] + "|2";
            continue;
        }
        if line == "end exception" {
            if array_len(attempts) == 0 { println("bytecode-error|end exception outside attempt"); return ["#emit-failed"]; }
            let fields: [str] = str_split(attempts[array_len(attempts) - 1], "|");
            if fields[3] == "1" and next_line == "ensure" {
                instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[1]);
            } else if fields[3] == "1" {
                instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[2]);
            } else if fields[3] == "2" {
                instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[2]);
            }
            continue;
        }
        if line == "end attempt" {
            if array_len(attempts) == 0 { println("bytecode-error|end attempt without attempt"); return ["#emit-failed"]; }
            let fields: [str] = str_split(attempts[array_len(attempts) - 1], "|");
            if fields[3] == "0" {
                instructions = nbc_emit(instructions, "BC_POP_HANDLER", "");
                instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[2]);
            } else if fields[3] == "2" {
                instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[2]);
            }
            instructions = nbc_label(instructions, fields[2]);
            attempts = slice(attempts, 0, array_len(attempts) - 1);
            continue;
        }
        if nbc_word(line) == "give" {
            if array_len(attempts) > 0 {
                let value: str = str_trim(nbc_after(line, "give"));
                if value != "" {
                    instructions = nbc_emit_expression(instructions, value);
                    instructions = nbc_emit(instructions, "BC_POP", "");
                }
                let fields: [str] = str_split(attempts[array_len(attempts) - 1], "|");
                if fields[3] == "2" {
                    instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[2]);
                } else {
                    instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[1]);
                }
            } else {
                let value: str = str_trim(nbc_after(line, "give"));
                if value == "" { instructions = nbc_emit(instructions, "BC_RET_UNIT", ""); }
                else {
                    instructions = nbc_emit_expression(instructions, value);
                    instructions = nbc_emit(instructions, "BC_RET", "");
                }
            }
            continue;
        }
        if line == "end routine" { instructions = nbc_emit(instructions, "BC_RET_UNIT", ""); continue; }
        if nbc_word(line) == "value" or nbc_word(line) == "change" or
           nbc_word(line) == "constant" {
            let rest: str = nbc_after(line, nbc_word(line));
            let equals: int = nbc_find(rest, "=");
            if equals < 0 { println("bytecode-error|binding requires '='"); return ["#emit-failed"]; }
            let declaration: str = str_trim(substr(rest, 0, equals));
            let colon: int = nbc_find(declaration, ":");
            let name: str = colon < 0 ? declaration : str_trim(substr(declaration, 0, colon));
            instructions = nbc_bind(instructions, name);
            if colon >= 0 {
                let decl_type: str = str_trim(substr(declaration, colon + 1,
                                                     str_len(declaration)));
                instructions = nbc_note_type(instructions, name, decl_type);
                let recidx: int = nbc_record_index(instructions, decl_type);
                if recidx >= 0 {
                    let nfields: int = nbc_record_nfields(instructions, decl_type);
                    mut f: int = 0;
                    while f < nfields {
                        instructions = nbc_emit(instructions, "BC_CONST_NONE", "");
                        f += 1;
                    }
                    instructions = nbc_emit(instructions, "BC_NEW_RECORD",
                        to_str(recidx) + "|" + to_str(nfields));
                    instructions = nbc_emit(instructions, "BC_ST_LOCAL",
                                            to_str(nbc_slot(instructions, name)));
                    continue;
                }
                let init_text: str = str_trim(substr(rest, equals + 1,
                                                     str_len(rest)));
                let dt_lt: int = nbc_find(decl_type, "<");
                let dt_base: str = dt_lt < 0 ? decl_type :
                    str_trim(substr(decl_type, 0, dt_lt));
                let known_choice: int = nbc_choice_index(instructions, dt_base);
                if known_choice >= 0 and init_text == "none" {
                    instructions = nbc_const(instructions, "int", "BC_CONST_INT", "0");
                    instructions = nbc_emit(instructions, "BC_NEW_ARRAY", "1");
                    instructions = nbc_emit(instructions, "BC_ST_LOCAL",
                                            to_str(nbc_slot(instructions, name)));
                    continue;
                }
            }
            instructions = nbc_emit_expression(instructions,
                substr(rest, equals + 1, str_len(rest)));
            instructions = nbc_emit(instructions, "BC_ST_LOCAL",
                                    to_str(nbc_slot(instructions, name)));
            continue;
        }
        if nbc_word(line) == "set" {
            let rest: str = nbc_after(line, "set");
            let to_at: int = nbc_find(rest, " to ");
            if to_at < 0 { println("bytecode-error|assignment requires 'to'"); return ["#emit-failed"]; }
            let target: str = str_trim(substr(rest, 0, to_at));
            if str_contains(target, ".") {
                let dot: int = nbc_find(target, ".");
                if dot > 0 {
                    let base: str = str_trim(substr(target, 0, dot));
                    let field: str = str_trim(substr(target, dot + 1, str_len(target)));
                    let base_type: str = nbc_find_type(instructions, base);
                    if base_type != "" {
                        let recidx: int = nbc_record_index(instructions, base_type);
                        if recidx >= 0 {
                            let fidx: int = nbc_field_index(instructions, base_type, field);
                            if fidx >= 0 {
                                instructions = nbc_emit_expression(instructions, base);
                                instructions = nbc_emit_expression(instructions,
                                    substr(rest, to_at + 4, str_len(rest)));
                                instructions = nbc_emit(instructions, "BC_FIELD_ST",
                                    to_str(recidx) + "|" + to_str(fidx));
                                continue;
                            }
                        }
                    }
                }
            }
            if str_contains(target, "[") {
                let bracket = nbc_find_postfix(target, "[", "]");
                if int_from_str(bracket[0]) >= 0 {
                    instructions = nbc_emit_expression(instructions, bracket[1]);
                    instructions = nbc_emit_expression(instructions, bracket[2]);
                    instructions = nbc_emit_expression(instructions,
                        substr(rest, to_at + 4, str_len(rest)));
                    instructions = nbc_emit(instructions, "BC_IDX_ST", "");
                    continue;
                }
            }
            let slot: int = nbc_slot(instructions, target);
            if slot < 0 { println("bytecode-error|unknown assignment target: " + target); return ["#emit-failed"]; }
            instructions = nbc_emit_expression(instructions,
                substr(rest, to_at + 4, str_len(rest)));
            instructions = nbc_emit(instructions, "BC_ST_LOCAL", to_str(slot));
            continue;
        }
        instructions = nbc_expression_statement(instructions, line);
        if not nbc_has_prefix(line, "show(") { instructions = nbc_emit(instructions, "BC_POP", ""); }
    }
    if array_len(attempts) != 0 { println("bytecode-error|unterminated attempt"); return ["#emit-failed"]; }
    if array_len(controls) != 0 { println("bytecode-error|unterminated control block"); return ["#emit-failed"]; }
    return instructions;
}

func natural_emit_bytecode(source: str) -> int {
    let code: [str] = nbc_collect(source);
    if array_len(code) == 1 and code[0] == "#emit-failed" { return 1; }
    return nbc_render(code);
}

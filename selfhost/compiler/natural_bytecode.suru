// Natural Syntax effect bytecode lowering.
// Pass one collects instructions and symbolic labels. Pass two removes labels
// and resolves every branch/handler target to a native instruction index.

func nbc_word(line: str) -> str {
    mut i: int = 0;
    while i < str_len(line) and line[i] != " " and line[i] != "\t" { i += 1; }
    return substr(line, 0, i);
}

func nbc_after(line: str, word: str) -> str {
    return str_trim(substr(line, str_len(word), str_len(line)));
}

func nbc_find(text: str, needle: str) -> int {
    mut i: int = 0;
    while i + str_len(needle) <= str_len(text) {
        if substr(text, i, str_len(needle)) == needle { return i; }
        i += 1;
    }
    return -1;
}

func nbc_emit(instructions: [str], op: str, operands: str) -> [str] {
    let record: str = op + "|" + operands;
    // Materialize a private copy before retaining the record in the growing
    // instruction array. This keeps later source-string temporaries from
    // aliasing an instruction record during bootstrap GC.
    let stable: str = substr(record, 0, str_len(record));
    return array_concat(instructions, [stable]);
}

func nbc_has_prefix(text: str, prefix: str) -> bool {
    return str_len(text) >= str_len(prefix) and
           substr(text, 0, str_len(prefix)) == prefix;
}

func nbc_pool_index(instructions: [str], kind: str, value: str) -> int {
    let wanted: str = "#" + kind + "|" + value;
    mut i: int = 0;
    mut index: int = 0;
    while i < array_len(instructions) {
        if instructions[i] == wanted { return index; }
        if nbc_has_prefix(instructions[i], "#" + kind + "|") { index += 1; }
        i += 1;
    }
    return -1;
}

func nbc_pool_count(instructions: [str], kind: str) -> int {
    mut count: int = 0;
    mut i: int = 0;
    while i < array_len(instructions) {
        if nbc_has_prefix(instructions[i], "#" + kind + "|") { count += 1; }
        i += 1;
    }
    return count;
}

func nbc_const(instructions: [str], kind: str, op: str, value: str) -> [str] {
    mut result: [str] = instructions;
    mut index: int = nbc_pool_index(result, kind, value);
    if index < 0 {
        index = nbc_pool_count(result, kind);
        result = array_concat(result, ["#" + kind + "|" + value]);
    }
    return nbc_emit(result, op, to_str(index));
}

func nbc_intern(instructions: [str], kind: str, value: str) -> [str] {
    if nbc_pool_index(instructions, kind, value) >= 0 { return instructions; }
    return array_concat(instructions, ["#" + kind + "|" + value]);
}

func nbc_find_type(instructions: [str], name: str) -> str {
    let needle: str = "#type|" + name + "|";
    mut i: int = 0;
    while i < array_len(instructions) {
        if nbc_has_prefix(instructions[i], needle) {
            return substr(instructions[i], str_len(needle), str_len(instructions[i]));
        }
        i += 1;
    }
    return "";
}

func nbc_note_type(instructions: [str], name: str, typ: str) -> [str] {
    if typ == "" { return instructions; }
    if nbc_find_type(instructions, name) != "" { return instructions; }
    return array_concat(instructions, ["#type|" + name + "|" + typ]);
}

func nbc_slot(instructions: [str], name: str) -> int {
    let wanted: str = "#slot|" + name + "|";
    mut i: int = 0;
    while i < array_len(instructions) {
        if nbc_has_prefix(instructions[i], wanted) {
            let field: str = substr(instructions[i], str_len(wanted), str_len(instructions[i]));
            return int_from_str(field);
        }
        i += 1;
    }
    return -1;
}

func nbc_bind(instructions: [str], name: str) -> [str] {
    if nbc_slot(instructions, name) >= 0 { return instructions; }
    let index: int = 0 + nbc_pool_count(instructions, "slot");
    return array_concat(instructions, ["#slot|" + name + "|" + to_str(index)]);
}

func nbc_is_digit(c: str) -> bool {
    return c >= "0" and c <= "9";
}

func nbc_is_float(text: str) -> bool {
    if str_len(text) == 0 or text[0] == "\"" { return false; }
    if not (str_contains(text, ".") or str_contains(text, "e") or
            str_contains(text, "E")) { return false; }
    mut has_digit: bool = false;
    mut i: int = 0;
    while i < str_len(text) {
        if nbc_is_digit(text[i]) { has_digit = true; }
        i += 1;
    }
    return has_digit;
}

func nbc_is_text(instructions: [str], expr: str) -> bool {
    if str_len(expr) >= 2 and expr[0] == "\"" { return true; }
    return nbc_find_type(instructions, expr) == "Text";
}

func nbc_is_real(instructions: [str], expr: str) -> bool {
    if nbc_is_float(expr) { return true; }
    return nbc_find_type(instructions, expr) == "Real";
}

func nbc_is_integer(text: str) -> bool {
    if str_len(text) == 0 { return false; }
    mut i: int = 0;
    if text[0] == "-" { i = 1; }
    if i == str_len(text) { return false; }
    while i < str_len(text) {
        if not nbc_is_digit(text[i]) and text[i] != "_" { return false; }
        i += 1;
    }
    return true;
}

func nbc_outer_parens(text: str) -> str {
    if str_len(text) < 2 or text[0] != "(" or
       text[str_len(text) - 1] != ")" { return text; }
    mut depth: int = 0;
    mut i: int = 0;
    while i < str_len(text) {
        if text[i] == "(" { depth += 1; }
        if text[i] == ")" { depth -= 1; }
        if depth == 0 and i < str_len(text) - 1 { return text; }
        i += 1;
    }
    return str_trim(substr(text, 1, str_len(text) - 1));
}

func nbc_top_operator(text: str, operators: [str]) -> [str] {
    mut depth: int = 0;
    mut quote: bool = false;
    mut i: int = str_len(text) - 1;
    while i >= 0 {
        let c: str = text[i];
        if c == "\"" { quote = not quote; }
        if not quote {
            if c == ")" or c == "]" { depth += 1; }
            if c == "(" or c == "[" { depth -= 1; }
            if depth == 0 {
                mut j: int = 0;
                while j < array_len(operators) {
                    let op: str = operators[j];
                    let start: int = i - str_len(op) + 1;
                    if start >= 0 and substr(text, start, str_len(op)) == op {
                        return [to_str(start), op];
                    }
                    j += 1;
                }
            }
        }
        i -= 1;
    }
    return ["-1", ""];
}

func nbc_split_ternary(text: str) -> [str] {
    mut depth: int = 0;
    mut quote: bool = false;
    mut question: int = -1;
    mut i: int = 0;
    while i < str_len(text) {
        let c: str = text[i];
        if c == "\"" { quote = not quote; }
        if not quote {
            if c == "(" or c == "[" { depth += 1; }
            if c == ")" or c == "]" { depth -= 1; }
            if depth == 0 and c == "?" { question = i; break; }
        }
        i += 1;
    }
    if question < 0 { return ["", "", ""]; }
    let cond: str = str_trim(substr(text, 0, question));
    mut colon: int = -1;
    depth = 0;
    quote = false;
    i = question + 1;
    while i < str_len(text) {
        let c: str = text[i];
        if c == "\"" { quote = not quote; }
        if not quote {
            if c == "(" or c == "[" { depth += 1; }
            if c == ")" or c == "]" { depth -= 1; }
            if depth == 0 and c == ":" { colon = i; break; }
        }
        i += 1;
    }
    if colon < 0 { return ["", "", ""]; }
    return [cond,
            str_trim(substr(text, question + 1, colon - question - 1)),
            str_trim(substr(text, colon + 1, str_len(text)))];
}

func nbc_emit_arguments(instructions: [str], text: str) -> [str] {
    mut result: [str] = instructions;
    let comma = nbc_top_operator(text, [","]);
    if int_from_str(comma[0]) >= 0 {
        let at: int = int_from_str(comma[0]);
        result = nbc_emit_arguments(result, substr(text, 0, at));
        return nbc_emit_arguments(result,
            substr(text, at + 1, str_len(text)));
    }
    return nbc_emit_expression(result, text);
}

func nbc_builtin_index(name: str) -> int {
    if name == "print" { return 0; }
    if name == "println" { return 1; }
    if name == "str_len" { return 2; }
    if name == "array_len" { return 3; }
    if name == "to_str" { return 5; }
    if name == "read_line" { return 4; }
    if name == "args" { return 27; }
    if name == "read_file" { return 57; }
    if name == "exit" { return 20; }
    return -1;
}

func nbc_func_index(instructions: [str], name: str) -> int {
    let wanted: str = "#func|" + name + "|";
    mut i: int = 0;
    while i < array_len(instructions) {
        if nbc_has_prefix(instructions[i], wanted) {
            return int_from_str(substr(instructions[i], str_len(wanted),
                                       str_len(instructions[i])));
        }
        i += 1;
    }
    return -1;
}

func nbc_collect_functions(instructions: [str], lines: [str]) -> [str] {
    mut result: [str] = instructions;
    mut i: int = 0;
    while i < array_len(lines) {
        let line: str = str_trim(lines[i]);
        let word: str = nbc_word(line);
        let routine: str = word == "routine" ? line :
            (word == "expose" and nbc_word(nbc_after(line, "expose")) == "routine"
             ? nbc_after(line, "expose") : "");
        if routine != "" {
            let rest: str = nbc_after(routine, "routine");
            let open: int = nbc_find(rest, "(");
            if open > 0 {
                let name: str = str_trim(substr(rest, 0, open));
                if nbc_func_index(result, name) < 0 {
                    result = array_concat(result, ["#func|" + name + "|" +
                        to_str(nbc_pool_count(result, "func"))]);
                }
            }
        }
        i += 1;
    }
    return result;
}

func nbc_emit_expression(instructions: [str], expression: str) -> [str] {
    mut result: [str] = instructions;
    mut text: str = str_trim(nbc_outer_parens(str_trim(expression)));
    let ternary = nbc_split_ternary(text);
    if ternary[0] != "" {
        let base: int = array_len(result);
        let else_label: str = "ternary-else-" + to_str(base);
        let end_label: str = "ternary-end-" + to_str(base + 1);
        result = nbc_emit_expression(result, ternary[0]);
        result = nbc_emit(result, "BC_JZ", "@" + else_label);
        result = nbc_emit_expression(result, ternary[1]);
        result = nbc_emit(result, "BC_JMP", "@" + end_label);
        result = nbc_label(result, else_label);
        result = nbc_emit_expression(result, ternary[2]);
        result = nbc_label(result, end_label);
        return result;
    }
    let logical = nbc_top_operator(text, [" or ", " and "]);
    if int_from_str(logical[0]) >= 0 {
        let at: int = int_from_str(logical[0]);
        let op: str = logical[1];
        result = nbc_emit_expression(result, substr(text, 0, at));
        result = nbc_emit_expression(result,
            substr(text, at + str_len(op), str_len(text)));
        return nbc_emit(result, op == " and " ? "BC_BIT_AND" : "BC_BIT_OR", "");
    }
    let comparison = nbc_top_operator(text, [" == ", " != ", " <= ", " >= ", " < ", " > "]);
    if int_from_str(comparison[0]) >= 0 {
        let at: int = int_from_str(comparison[0]);
        let op: str = comparison[1];
        let left: str = str_trim(substr(text, 0, at));
        let right: str = str_trim(substr(text, at + str_len(op), str_len(text)));
        result = nbc_emit_expression(result, left);
        result = nbc_emit_expression(result, right);
        mut suffix: str = "I";
        if nbc_is_text(result, left) and nbc_is_text(result, right) {
            suffix = "S";
        } else if nbc_is_real(result, left) or nbc_is_real(result, right) {
            suffix = "F";
        }
        mut byte_op: str = "BC_EQ_" + suffix;
        if op == " != " { byte_op = "BC_NE_" + suffix; }
        if op == " < " { byte_op = "BC_LT_" + suffix; }
        if op == " <= " { byte_op = "BC_LE_" + suffix; }
        if op == " > " { byte_op = "BC_GT_" + suffix; }
        if op == " >= " { byte_op = "BC_GE_" + suffix; }
        return nbc_emit(result, byte_op, "");
    }
    let arithmetic = nbc_top_operator(text, [" + ", " - "]);
    if int_from_str(arithmetic[0]) >= 0 {
        let at: int = int_from_str(arithmetic[0]);
        let op: str = arithmetic[1];
        let left: str = str_trim(substr(text, 0, at));
        let right: str = str_trim(substr(text, at + str_len(op), str_len(text)));
        result = nbc_emit_expression(result, left);
        result = nbc_emit_expression(result, right);
        mut byte_op: str = "BC_ADD_I";
        if op == " - " {
            if nbc_is_real(result, left) or nbc_is_real(result, right) {
                byte_op = "BC_SUB_F";
            } else {
                byte_op = "BC_SUB_I";
            }
        } else if nbc_is_text(result, left) or nbc_is_text(result, right) {
            byte_op = "BC_CONCAT_S";
        } else if nbc_is_real(result, left) or nbc_is_real(result, right) {
            byte_op = "BC_ADD_F";
        }
        return nbc_emit(result, byte_op, "");
    }
    let multiplicative = nbc_top_operator(text, [" * ", " / ", " % "]);
    if int_from_str(multiplicative[0]) >= 0 {
        let at: int = int_from_str(multiplicative[0]);
        let op: str = multiplicative[1];
        let left: str = str_trim(substr(text, 0, at));
        let right: str = str_trim(substr(text, at + str_len(op), str_len(text)));
        result = nbc_emit_expression(result, left);
        result = nbc_emit_expression(result, right);
        mut byte_op: str = "BC_MUL_I";
        let real_case: bool = nbc_is_real(result, left) or nbc_is_real(result, right);
        if op == " / " { byte_op = real_case ? "BC_DIV_F" : "BC_DIV_I"; }
        else if op == " % " { byte_op = "BC_MOD_I"; }
        else if real_case { byte_op = "BC_MUL_F"; }
        return nbc_emit(result, byte_op, "");
    }
    if nbc_has_prefix(text, "-") {
        let operand: str = substr(text, 1, str_len(text));
        result = nbc_emit_expression(result, operand);
        if nbc_is_float(operand) { return nbc_emit(result, "BC_NEG_F", ""); }
        return nbc_emit(result, "BC_NEG_I", "");
    }
    if nbc_has_prefix(text, "not ") {
        result = nbc_emit_expression(result, substr(text, 4, str_len(text)));
        return nbc_emit(result, "BC_NOT", "");
    }
    if nbc_has_prefix(text, "~") {
        result = nbc_emit_expression(result, substr(text, 1, str_len(text)));
        return nbc_emit(result, "BC_BIT_NOT", "");
    }
    let open: int = nbc_find(text, "(");
    if open > 0 and text[str_len(text) - 1] == ")" {
        let callee: str = str_trim(substr(text, 0, open));
        let argument_text: str = str_trim(substr(text, open + 1,
                                                  str_len(text) - open - 2));
        if argument_text != "" {
            result = nbc_emit_arguments(result, argument_text);
        }
        let builtin: int = nbc_builtin_index(callee);
        if builtin >= 0 { return nbc_emit(result, "BC_BUILTIN", to_str(builtin)); }
        let function: int = nbc_func_index(result, callee);
        if function >= 0 { return nbc_emit(result, "BC_CALL", to_str(function)); }
        return nbc_emit(result, "BC_TRAP", "unknown call: " + callee);
    }
    if nbc_is_integer(text) {
        return nbc_const(result, "int", "BC_CONST_INT", text);
    }
    if nbc_is_float(text) {
        return nbc_const(result, "float", "BC_CONST_FLOAT", text);
    }
    if text == "true" or text == "false" {
        return nbc_const(result, "int", "BC_CONST_INT", text == "true" ? "1" : "0");
    }
    if text == "none" {
        return nbc_emit(result, "BC_CONST_NONE", "");
    }
    if str_len(text) >= 2 and text[0] == "\"" and text[str_len(text) - 1] == "\"" {
        return nbc_const(result, "str", "BC_CONST_STR", text);
    }
    let slot: int = nbc_slot(instructions, text);
    if slot >= 0 { return nbc_emit(result, "BC_LD_LOCAL", to_str(slot)); }
    return nbc_emit(result, "BC_TRAP", "unknown expression: " + text);
}

func nbc_expression_statement(instructions: [str], line: str) -> [str] {
    mut result: [str] = instructions;
    if nbc_has_prefix(line, "show(") and line[str_len(line) - 1] == ")" {
        let value: str = substr(line, 5, str_len(line) - 6);
        result = nbc_emit_expression(result, value);
        result = nbc_emit(result, "BC_BUILTIN", "1");
        return nbc_emit(result, "BC_POP", "");
    }
    return nbc_emit_expression(result, line);
}

func nbc_next_handler_type(lines: [str], start: int) -> str {
    mut i: int = start;
    while i < array_len(lines) {
        let candidate: str = str_trim(lines[i]);
        if nbc_word(candidate) == "handle" {
            let rest: str = nbc_after(candidate, "handle");
            let colon: int = nbc_find(rest, ":");
            if colon >= 0 {
                return str_trim(substr(rest, colon + 1, str_len(rest)));
            }
        }
        if candidate == "end attempt" { return ""; }
        i += 1;
    }
    return "";
}

func nbc_label(instructions: [str], name: str) -> [str] {
    return array_concat(instructions, ["@" + name]);
}

func nbc_lookup_label(labels: [str], positions: [int], name: str) -> int {
    mut i: int = 0;
    while i < array_len(labels) {
        if labels[i] == name { return positions[i]; }
        i += 1;
    }
    return -1;
}

func nbc_resolve_operand(operand: str, labels: [str], positions: [int]) -> str {
    if str_len(operand) > 0 and operand[0] == "@" {
        let name: str = substr(operand, 1, str_len(operand));
        return to_str(nbc_lookup_label(labels, positions, name));
    }
    return operand;
}

func nbc_render(instructions: [str]) -> int {
    mut labels: [str] = [];
    mut positions: [int] = [];
    mut pc: int = 0;
    mut i: int = 0;
    while i < array_len(instructions) {
        let item: str = instructions[i];
        if str_len(item) > 0 and item[0] == "@" {
            labels = array_concat(labels, [substr(item, 1, str_len(item))]);
            positions = array_concat(positions, [pc]);
        } else if str_len(item) > 0 and item[0] == "#" {
            // Pool and slot metadata do not occupy instruction indices.
        } else {
            pc += 1;
        }
        i += 1;
    }
    mut pool_index: int = 0;
    i = 0;
    while i < array_len(instructions) {
        let item: str = instructions[i];
        if nbc_has_prefix(item, "#int|") {
            println("pool|int|" + to_str(pool_index) + "|" +
                    substr(item, 5, str_len(item)));
            pool_index += 1;
        }
        i += 1;
    }
    pool_index = 0;
    i = 0;
    while i < array_len(instructions) {
        let item: str = instructions[i];
        if nbc_has_prefix(item, "#float|") {
            println("pool|float|" + to_str(pool_index) + "|" +
                    substr(item, 7, str_len(item)));
            pool_index += 1;
        }
        i += 1;
    }
    pool_index = 0;
    i = 0;
    while i < array_len(instructions) {
        let item: str = instructions[i];
        if nbc_has_prefix(item, "#str|") {
            println("pool|str|" + to_str(pool_index) + "|" +
                    substr(item, 5, str_len(item)));
            pool_index += 1;
        }
        i += 1;
    }
    pc = 0;
    i = 0;
    while i < array_len(instructions) {
        let item: str = instructions[i];
        if str_len(item) == 0 or item[0] == "@" or item[0] == "#" {
            i += 1;
            continue;
        }
        let separator: int = nbc_find(item, "|");
        let op: str = separator < 0 ? item : substr(item, 0, separator);
        mut rendered: str = separator < 0 ? "" :
            substr(item, separator + 1, str_len(item));
        let operand_separator: int = nbc_find(rendered, "|");
        if operand_separator >= 0 {
            let first: str = substr(rendered, 0, operand_separator);
            let rest: str = substr(rendered, operand_separator + 1,
                                   str_len(rendered));
            rendered = nbc_resolve_operand(first, labels, positions) + "|" + rest;
        } else if rendered != "" {
            rendered = nbc_resolve_operand(rendered, labels, positions);
        }
        println("bc|" + to_str(pc) + "|" + op + "|" + rendered);
        pc += 1;
        i += 1;
    }
    return 0;
}

func natural_emit_bytecode(source: str) -> int {
    let lines: [str] = str_split(source, "\n");
    mut instructions: [str] = [];
    instructions = nbc_collect_functions(instructions, lines);
    mut attempts: [str] = [];
    mut controls: [str] = [];
    mut labels: int = 0;
    mut i: int = 0;
    while i < array_len(lines) {
        let line: str = str_trim(lines[i]);
        mut next_line: str = "";
        mut look: int = i + 1;
        while look < array_len(lines) and str_trim(lines[look]) == "" { look += 1; }
        if look < array_len(lines) { next_line = str_trim(lines[look]); }
        i += 1;
        if line == "" or nbc_word(line) == "//" or nbc_word(line) == "#!" { continue; }

        if nbc_word(line) == "routine" or
           (nbc_word(line) == "expose" and nbc_word(nbc_after(line, "expose")) == "routine") {
            continue;
        }
        if nbc_word(line) == "repeat" {
            let repeat_rest: str = nbc_after(line, "repeat");
            if nbc_word(repeat_rest) != "while" {
                println("bytecode-error|repeat requires 'while'");
                return 1;
            }
            let body: str = "repeat-body" + to_str(labels);
            let finish: str = "repeat-end" + to_str(labels);
            labels += 1;
            controls = array_concat(controls, ["repeat|" + body + "|" + finish]);
            instructions = nbc_label(instructions, body);
            instructions = nbc_emit_expression(instructions,
                nbc_after(repeat_rest, "while"));
            instructions = nbc_emit(instructions, "BC_JZ", "@" + finish);
            continue;
        }
        if nbc_word(line) == "when" {
            let finish: str = "when-end" + to_str(labels);
            let next: str = "when-next" + to_str(labels);
            labels += 1;
            controls = array_concat(controls, ["when|" + finish + "|" + next + "|0"]);
            instructions = nbc_emit_expression(instructions, nbc_after(line, "when"));
            instructions = nbc_emit(instructions, "BC_JZ", "@" + next);
            continue;
        }
        if line == "otherwise" or nbc_has_prefix(line, "otherwise when ") {
            if array_len(controls) == 0 {
                println("bytecode-error|otherwise outside when");
                return 1;
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if current[0] != "when" {
                println("bytecode-error|otherwise outside when");
                return 1;
            }
            instructions = nbc_emit(instructions, "BC_JMP", "@" + current[1]);
            instructions = nbc_label(instructions, current[2]);
            if line == "otherwise" {
                controls[array_len(controls) - 1] = current[0] + "|" +
                    current[1] + "||2";
            } else {
                let next: str = "when-next" + to_str(labels);
                labels += 1;
                instructions = nbc_emit_expression(instructions,
                    nbc_after(nbc_after(line, "otherwise"), "when"));
                instructions = nbc_emit(instructions, "BC_JZ", "@" + next);
                controls[array_len(controls) - 1] = current[0] + "|" +
                    current[1] + "|" + next + "|1";
            }
            continue;
        }
        if line == "end repeat" {
            if array_len(controls) == 0 {
                println("bytecode-error|end repeat without repeat");
                return 1;
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if current[0] != "repeat" {
                println("bytecode-error|mismatched repeat terminator");
                return 1;
            }
            instructions = nbc_emit(instructions, "BC_JMP", "@" + current[1]);
            instructions = nbc_label(instructions, current[2]);
            controls = slice(controls, 0, array_len(controls) - 1);
            continue;
        }
        if line == "end when" {
            if array_len(controls) == 0 {
                println("bytecode-error|end when without when");
                return 1;
            }
            let current: [str] = str_split(controls[array_len(controls) - 1], "|");
            if current[0] != "when" {
                println("bytecode-error|mismatched when terminator");
                return 1;
            }
            if current[3] == "0" {
                instructions = nbc_label(instructions, current[2]);
            }
            instructions = nbc_label(instructions, current[1]);
            controls = slice(controls, 0, array_len(controls) - 1);
            continue;
        }
        if line == "attempt" {
            let handler: str = "handler" + to_str(labels);
            let cleanup: str = "cleanup" + to_str(labels);
            let finish: str = "finish" + to_str(labels);
            labels += 1;
            // handler|cleanup|finish|phase (0=body, 1=handler, 2=cleanup)
            attempts = array_concat(attempts, [handler + "|" + cleanup + "|" + finish + "|0"]);
            let handler_type: str = nbc_next_handler_type(lines, i);
            mut handler_operand: str = "4294967295";
            if handler_type != "" {
                instructions = nbc_intern(instructions, "str", handler_type);
                handler_operand = to_str(nbc_pool_index(instructions, "str", handler_type));
            }
            instructions = nbc_emit(instructions, "BC_PUSH_HANDLER",
                                    "@" + handler + "|" + handler_operand);
            continue;
        }
        if nbc_word(line) == "handle" {
            if array_len(attempts) == 0 { println("bytecode-error|handle outside attempt"); return 1; }
            let fields: [str] = str_split(attempts[array_len(attempts) - 1], "|");
            instructions = nbc_emit(instructions, "BC_POP_HANDLER", "");
            instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[1]);
            let handler_rest: str = nbc_after(line, "handle");
            let colon: int = nbc_find(handler_rest, ":");
            let binding: str = str_trim(substr(handler_rest, 0, colon));
            let effect: str = str_trim(substr(handler_rest, colon + 1,
                                              str_len(handler_rest)));
            instructions = nbc_label(instructions, fields[0]);
            if binding != "" {
                instructions = nbc_bind(instructions, binding);
                instructions = nbc_emit(instructions, "BC_ST_LOCAL",
                                        to_str(nbc_slot(instructions, binding)));
            } else {
                instructions = nbc_emit(instructions, "BC_POP", "");
            }
            instructions = nbc_emit(instructions, "BC_NOP", "handler:" + effect);
            attempts[array_len(attempts) - 1] = fields[0] + "|" + fields[1] + "|" + fields[2] + "|1";
            continue;
        }
        if line == "ensure" {
            if array_len(attempts) == 0 { println("bytecode-error|ensure outside attempt"); return 1; }
            let fields: [str] = str_split(attempts[array_len(attempts) - 1], "|");
            if fields[3] == "1" {
                instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[1]);
            }
            instructions = nbc_label(instructions, fields[1]);
            instructions = nbc_emit(instructions, "BC_NOP", "cleanup");
            attempts[array_len(attempts) - 1] = fields[0] + "|" + fields[1] + "|" + fields[2] + "|2";
            continue;
        }
        if line == "end exception" {
            if array_len(attempts) == 0 { println("bytecode-error|end exception outside attempt"); return 1; }
            let fields: [str] = str_split(attempts[array_len(attempts) - 1], "|");
            if fields[3] == "1" and next_line == "ensure" {
                instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[1]);
            } else if fields[3] == "1" {
                instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[2]);
            } else if fields[3] == "2" {
                instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[2]);
            }
            continue;
        }
        if line == "end attempt" {
            if array_len(attempts) == 0 { println("bytecode-error|end attempt without attempt"); return 1; }
            let fields: [str] = str_split(attempts[array_len(attempts) - 1], "|");
            if fields[3] == "0" {
                instructions = nbc_emit(instructions, "BC_POP_HANDLER", "");
                instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[2]);
            } else if fields[3] == "2" {
                instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[2]);
            }
            instructions = nbc_label(instructions, fields[2]);
            attempts = slice(attempts, 0, array_len(attempts) - 1);
            continue;
        }
        if nbc_word(line) == "give" {
            if array_len(attempts) > 0 {
                let value: str = str_trim(nbc_after(line, "give"));
                if value != "" {
                    instructions = nbc_emit_expression(instructions, value);
                    instructions = nbc_emit(instructions, "BC_POP", "");
                }
                let fields: [str] = str_split(attempts[array_len(attempts) - 1], "|");
                if fields[3] == "2" {
                    instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[2]);
                } else {
                    instructions = nbc_emit(instructions, "BC_JMP", "@" + fields[1]);
                }
            } else {
                let value: str = str_trim(nbc_after(line, "give"));
                if value == "" { instructions = nbc_emit(instructions, "BC_RET_UNIT", ""); }
                else {
                    instructions = nbc_emit_expression(instructions, value);
                    instructions = nbc_emit(instructions, "BC_RET", "");
                }
            }
            continue;
        }
        if line == "end routine" { instructions = nbc_emit(instructions, "BC_RET_UNIT", ""); continue; }
        if nbc_word(line) == "value" or nbc_word(line) == "change" or
           nbc_word(line) == "constant" {
            let rest: str = nbc_after(line, nbc_word(line));
            let equals: int = nbc_find(rest, "=");
            if equals < 0 { println("bytecode-error|binding requires '='"); return 1; }
            let declaration: str = str_trim(substr(rest, 0, equals));
            let colon: int = nbc_find(declaration, ":");
            let name: str = colon < 0 ? declaration : str_trim(substr(declaration, 0, colon));
            instructions = nbc_bind(instructions, name);
            if colon >= 0 {
                let decl_type: str = str_trim(substr(declaration, colon + 1,
                                                     str_len(declaration)));
                instructions = nbc_note_type(instructions, name, decl_type);
            }
            instructions = nbc_emit_expression(instructions,
                substr(rest, equals + 1, str_len(rest)));
            instructions = nbc_emit(instructions, "BC_ST_LOCAL",
                                    to_str(nbc_slot(instructions, name)));
            continue;
        }
        if nbc_word(line) == "set" {
            let rest: str = nbc_after(line, "set");
            let to_at: int = nbc_find(rest, " to ");
            if to_at < 0 { println("bytecode-error|assignment requires 'to'"); return 1; }
            let name: str = str_trim(substr(rest, 0, to_at));
            let slot: int = nbc_slot(instructions, name);
            if slot < 0 { println("bytecode-error|unknown assignment target: " + name); return 1; }
            instructions = nbc_emit_expression(instructions,
                substr(rest, to_at + 4, str_len(rest)));
            instructions = nbc_emit(instructions, "BC_ST_LOCAL", to_str(slot));
            continue;
        }
        instructions = nbc_expression_statement(instructions, line);
        if not nbc_has_prefix(line, "show(") { instructions = nbc_emit(instructions, "BC_POP", ""); }
    }
    if array_len(attempts) != 0 { println("bytecode-error|unterminated attempt"); return 1; }
    if array_len(controls) != 0 { println("bytecode-error|unterminated control block"); return 1; }
    return nbc_render(instructions);
}
